f_deleteTradeAt(int index) =>
    box.delete(array.remove(targetBoxes, index))
    box.delete(array.remove(riskBoxes, index))
    line.delete(array.remove(entryLines, index))
    line.delete(array.remove(tp1Lines, index))
    line.delete(array.remove(tp2Lines, index))
    line.delete(array.remove(tp3Lines, index))
    label oldOverlapLabel = array.remove(overlapLabels, index)
    if not na(oldOverlapLabel)
        label.delete(oldOverlapLabel)
    label oldGradeLabel = array.remove(tradeGradeLabels, index)
    if not na(oldGradeLabel)
        label.delete(oldGradeLabel)
    array.remove(tradeGrades, index)
    array.remove(tradeGradeScores, index)
    label oldRankLabel = array.remove(tradeRankLabels, index)
    if not na(oldRankLabel)
        label.delete(oldRankLabel)
    array.remove(tradeDirections, index)
    array.remove(tradeStartBars, index)
    array.remove(tradeEntryPrices, index)
    array.remove(tradeTP1Prices, index)
    array.remove(tradeTP2Prices, index)
    array.remove(tradeTP3Prices, index)
    array.remove(tradeSLPrices, index)
    array.remove(tradeTP1Hit, index)
    array.remove(tradeTP2Hit, index)
    array.remove(tradeExtensionWatching, index)
    array.remove(tradeExtensionHit, index)
    array.remove(tradeRunnerMomentumQualified, index)
    array.remove(tradeRunnerBaselineQualified, index)
    array.remove(tradeRunnerEMASlopeQualified, index)
    array.remove(tradeRunnerLaunched, index)
    array.remove(tradeSessionTypes, index)
    array.remove(tradeSessionGenerations, index)
    array.remove(tradeTradingDayKeys, index)
    array.remove(tradeWeekKeys, index)
    array.remove(tradeActive, index)
    array.remove(tradeIsMirror, index)
    array.remove(representedTradeCounts, index)

f_deleteOldestTrade() =>
    if array.size(tradeDirections) > 0
        f_deleteTradeAt(0)

f_clearAllTrades() =>
    while array.size(tradeDirections) > 0
        f_deleteOldestTrade()

f_effectiveTradeLimit() =>
    int limit = effectiveMaxStoredBoxes
    if effectiveBoxDisplayMode == "Latest Only"
        limit := 1
    else if effectiveBoxDisplayMode == "Custom Count"
        limit := math.min(effectiveCustomVisibleBoxes, effectiveMaxStoredBoxes)
    limit

f_pruneTrades() =>
    int limit = f_effectiveTradeLimit()
    while array.size(tradeDirections) > limit
        f_deleteOldestTrade()

// Display modes never control trade generation or statistics. They only decide
// which retained chart objects are visible. Active Session Only follows the live
// PM/NY session automatically; fixed session modes show the latest instance of
// the selected session even after that session has ended.
f_tradeIsVisible(int index) =>
    int tradeSessionType = array.get(tradeSessionTypes, index)
    int tradeSessionGeneration = array.get(tradeSessionGenerations, index)
    bool activePMNow = not na(time(timeframe.period, pmSession, "America/New_York"))
    bool activeNYNow = not na(time(timeframe.period, nySession, "America/New_York"))
    bool visible = true
    if effectiveBoxDisplayMode == "Active Session Only"
        visible := activePMNow ? tradeSessionType == 1 and tradeSessionGeneration == pmSessionGeneration : activeNYNow ? tradeSessionType == 2 and tradeSessionGeneration == nySessionGeneration : false
    else if effectiveBoxDisplayMode == "NY Session Only"
        visible := tradeSessionType == 2 and tradeSessionGeneration == nySessionGeneration
    else if effectiveBoxDisplayMode == "PM Session Only"
        visible := tradeSessionType == 1 and tradeSessionGeneration == pmSessionGeneration
    visible

f_refreshTradeVisibility() =>
    int tradeCount = array.size(tradeDirections)
    if tradeCount > 0
        for i = 0 to tradeCount - 1
            bool visible = f_tradeIsVisible(i)
            box targetBox = array.get(targetBoxes, i)
            box riskBox = array.get(riskBoxes, i)
            line entryLine = array.get(entryLines, i)
            line tp1Line = array.get(tp1Lines, i)
            line tp2Line = array.get(tp2Lines, i)
            line tp3Line = array.get(tp3Lines, i)
            box.set_bgcolor(targetBox, visible ? tpBoxColor : color.new(tpBoxColor, 100))
            box.set_border_color(targetBox, visible ? color.new(tpBoxColor, 0) : color.new(tpBoxColor, 100))
            box.set_bgcolor(riskBox, visible ? slBoxColor : color.new(slBoxColor, 100))
            box.set_border_color(riskBox, visible ? slLineColor : color.new(slLineColor, 100))
            line.set_color(entryLine, visible ? entryLineColor : color.new(entryLineColor, 100))
            line.set_color(tp1Line, visible and showTPLevels ? tp1Color : color.new(tp1Color, 100))
            line.set_color(tp2Line, visible and showTPLevels ? tp2Color : color.new(tp2Color, 100))
            line.set_color(tp3Line, visible and showTPLevels ? tp3Color : color.new(tp3Color, 100))
            label overlapLabel = array.get(overlapLabels, i)
            if not na(overlapLabel)
                label.set_textcolor(overlapLabel, visible and premiumOverlapCountsEnabled ? color.white : color.new(color.white, 100))
            label gradeLabel = array.get(tradeGradeLabels, i)
            if not na(gradeLabel)
                label.set_textcolor(gradeLabel, visible and showBoxGrades ? color.white : color.new(color.white, 100))

// Rank only the boxes currently visible under the selected display mode.
// When exactly one box is visible, no rank is shown.
f_refreshTradeRankings() =>
    int tradeCount = array.size(tradeDirections)
    int visibleCount = 0
    if tradeCount > 0
        for i = 0 to tradeCount - 1
            if f_tradeIsVisible(i)
                visibleCount += 1
        int visibleRank = 0
        for i = 0 to tradeCount - 1
            bool visible = f_tradeIsVisible(i)
            label rankLabel = array.get(tradeRankLabels, i)
            bool hideRank = not premiumTradeRankingsEnabled or not visible or visibleCount == 1
            if hideRank
                if not na(rankLabel)
                    label.delete(rankLabel)
                    array.set(tradeRankLabels, i, na)
            if not hideRank
                box targetBox = array.get(targetBoxes, i)
                box riskBox = array.get(riskBoxes, i)
                int rankX = math.min(box.get_right(targetBox), box.get_right(riskBox))
                float rankY = math.max(box.get_top(targetBox), box.get_top(riskBox))
                string rankText = str.tostring(visibleRank)
                if na(rankLabel)
                    rankLabel := label.new(rankX, rankY, rankText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(color.black, 15), textcolor=color.white, size=size.small, textalign=text.align_center, force_overlay=true)
                    array.set(tradeRankLabels, i, rankLabel)
                else
                    label.set_x(rankLabel, rankX)
                    label.set_y(rankLabel, rankY)
                    label.set_text(rankLabel, rankText)
                    label.set_color(rankLabel, color.new(color.black, 15))
                    label.set_textcolor(rankLabel, color.white)
                visibleRank := visibleRank + 1
            // Grade stays centered over the box, between the right-edge rank and
            // the left-side overlap-removal count. It is visible even when only
            // one box is shown (rank remains hidden in that case).
            label gradeLabel = array.get(tradeGradeLabels, i)
            if visible and showBoxGrades
                box gradeTargetBox = array.get(targetBoxes, i)
                box gradeRiskBox = array.get(riskBoxes, i)
                int gradeLeft = math.min(box.get_left(gradeTargetBox), box.get_left(gradeRiskBox))
                int gradeRight = math.max(box.get_right(gradeTargetBox), box.get_right(gradeRiskBox))
                int gradeX = int(math.round((gradeLeft + gradeRight) / 2.0))
                float gradeY = math.max(box.get_top(gradeTargetBox), box.get_top(gradeRiskBox))
                string gradeText = array.get(tradeGrades, i)
                color gradeBG = gradeText == "A" ? color.new(color.lime, 20) : gradeText == "B" ? color.new(color.green, 35) : gradeText == "C" ? color.new(color.orange, 35) : color.new(color.red, 35)
                if na(gradeLabel)
                    gradeLabel := label.new(gradeX, gradeY, gradeText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=gradeBG, textcolor=color.white, size=size.small, textalign=text.align_center, force_overlay=true)
                    array.set(tradeGradeLabels, i, gradeLabel)
                else
                    label.set_x(gradeLabel, gradeX)
                    label.set_y(gradeLabel, gradeY)
                    label.set_text(gradeLabel, gradeText)
                    label.set_color(gradeLabel, gradeBG)
                    label.set_textcolor(gradeLabel, color.white)
            else if not na(gradeLabel)
                label.set_textcolor(gradeLabel, color.new(color.white, 100))

// Session membership is evaluated explicitly in America/New_York so the
// selected display mode behaves consistently on symbols from any exchange.
bool inNYSession = not na(time(timeframe.period, nySession, "America/New_York"))
bool inPMSession = not na(time(timeframe.period, pmSession, "America/New_York"))
bool nySessionStarted = inNYSession and not inNYSession[1]
bool pmSessionStarted = inPMSession and not inPMSession[1]
// EEM starts its preparation clock on market-source connection. Pine cannot
// detect connection time, so the reproducible chart equivalent starts at the
// NY (09:30 ET) and PM (18:00 ET) opening. A rejected signal is not queued.
int beiSessionStart = na
if inNYSession
    beiSessionStart := timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 9, 30)
else if inPMSession
    int beiPMBaseTime = hour(time, "America/New_York") >= 18 ? time : time - 24 * 60 * 60 * 1000
    beiSessionStart := timestamp("America/New_York", year(beiPMBaseTime, "America/New_York"), month(beiPMBaseTime, "America/New_York"), dayofmonth(beiPMBaseTime, "America/New_York"), 18, 0)
bool beiSessionPrepReady = beiPrepMinutes == 0 or na(beiSessionStart) or time >= beiSessionStart + beiPrepMinutes * 60 * 1000

if nySessionStarted
    nySessionGeneration += 1
if pmSessionStarted
    pmSessionGeneration += 1

string reportTZ = "America/New_York"
int etYear = year(time, reportTZ)
int etMonth = month(time, reportTZ)
int etDay = dayofmonth(time, reportTZ)
int etHour = hour(time, reportTZ)
int nySessionEndTS = timestamp(reportTZ, etYear, etMonth, etDay, 17, 0)
int pmSessionEndTS = etHour >= 18 ? timestamp(reportTZ, etYear, etMonth, etDay + 1, 9, 30) : timestamp(reportTZ, etYear, etMonth, etDay, 9, 30)
int fifteenMinutesMS = 15 * 60 * 1000
int nyReportWindowStartTS = nySessionEndTS - fifteenMinutesMS
int pmReportWindowStartTS = pmSessionEndTS - fifteenMinutesMS

// Report eligibility is a WINDOW, not a one-bar event. Any chart bar that
// overlaps the final 15 minutes of its session can generate/regenerate a report.
bool nyReportEligibleBar = inNYSession and time < nySessionEndTS and time_close > nyReportWindowStartTS
bool pmReportEligibleBar = inPMSession and time < pmSessionEndTS and time_close > pmReportWindowStartTS
bool fridayET = dayofweek(time, reportTZ) == dayofweek.friday
bool weeklyReportEligibleBar = nyReportEligibleBar and fridayET

// Shift six hours before deriving the week key so Sunday 18:00 ET belongs to
// the incoming futures trading week rather than the week that just ended.
int shiftedTradingTime = time + 6 * 60 * 60 * 1000
int runnerTradingDayKey = year(shiftedTradingTime, reportTZ) * 10000 + month(shiftedTradingTime, reportTZ) * 100 + dayofmonth(shiftedTradingTime, reportTZ)
int reportWeekKey = year(shiftedTradingTime, reportTZ) * 100 + weekofyear(shiftedTradingTime, reportTZ)
bool reportWeekChanged = na(trackedWeekKey) or reportWeekKey != trackedWeekKey
if reportWeekChanged
    trackedWeekKey := reportWeekKey
    weeklyCPL := 0.0
    weeklyTP1CPL := 0.0
    weeklyTP2CPL := 0.0
    weeklyGrossProfit := 0.0
    weeklyGrossLoss := 0.0
    weeklyPMHighestCPLSum := 0.0
    weeklyPMLowestCPLSum := 0.0
    weeklyPMSessionMetricCount := 0
    weeklyNYHighestCPLSum := 0.0
    weeklyNYLowestCPLSum := 0.0
    weeklyNYSessionMetricCount := 0
    weeklyTP1Wins := 0
    weeklyTP2Wins := 0
    weeklyWins := 0
    weeklyCompleted := 0
    weeklyPMCPL := 0.0
    weeklyPMGrossProfit := 0.0
    weeklyPMGrossLoss := 0.0
    weeklyPMWins := 0
    weeklyPMCompleted := 0
    weeklyNYCPL := 0.0
    weeklyNYGrossProfit := 0.0
    weeklyNYGrossLoss := 0.0
    weeklyNYWins := 0
    weeklyNYCompleted := 0
    btWeekCompleted := 0
    btWeekTP1Wins := 0
    btWeekTP2Wins := 0
    btWeekTP3Wins := 0
    btWeekTP1CPL := 0.0
    btWeekTP2CPL := 0.0
    btWeekTP3CPL := 0.0
    btWeekGrossProfit := 0.0
    btWeekGrossLoss := 0.0

    runnerWeekQualified := 0
    runnerWeekResolved := 0
    runnerWeekCPL := 0.0
    runnerWeekGrossProfit := 0.0
    runnerWeekGrossLoss := 0.0
    runnerWeekExtensionSumATR := 0.0
    runnerWeekMaxExtensionATR := 0.0
    for runnerHitIndex = 0 to 4
        array.set(runnerWeekTargetHits, runnerHitIndex, 0)
    currentDayCPL := 0.0
    currentDayWins := 0
    currentDayCompleted := 0
    bestDailyCPL := na
    bestDailyWinRate := na
    bestDailyCPLName := ""
    bestDailyWinRateName := ""
    for dayIndex = 0 to 4
        array.set(weeklyDailyCPL, dayIndex, na)
        array.set(weeklyDailyPMCPL, dayIndex, na)
        array.set(weeklyDailyNYCPL, dayIndex, na)
        array.set(weeklyDailyPMRange, dayIndex, na)
        array.set(weeklyDailyNYRange, dayIndex, na)
        array.set(weeklyDailyWins, dayIndex, 0)
        array.set(weeklyDailyCompleted, dayIndex, 0)

// Starting a new PM session finalizes the prior PM+NY trading day for weekly
// best-day stats. Report visibility is controlled by the explicit clock schedule
// below so Friday reports are not dismissed by Friday's 18:00 PM-session start.
if pmSessionStarted
    // BackTest Current Trading Day begins with PM and continues through the following NY session.
    btDayCompleted := 0
    btDayTP1Wins := 0
    btDayTP2Wins := 0
    btDayTP3Wins := 0
    btDayTP1CPL := 0.0
    btDayTP2CPL := 0.0
    btDayTP3CPL := 0.0
    btDayGrossProfit := 0.0
    btDayGrossLoss := 0.0
    runnerDayQualified := 0
    runnerDayResolved := 0
    runnerDayCPL := 0.0
    runnerDayGrossProfit := 0.0
    runnerDayGrossLoss := 0.0
    runnerDayExtensionSumATR := 0.0
    runnerDayMaxExtensionATR := 0.0
    for runnerHitIndex = 0 to 4
        array.set(runnerDayTargetHits, runnerHitIndex, 0)

    if not reportWeekChanged and currentDayCompleted > 0
        float completedDayWinRate = float(currentDayWins) / float(currentDayCompleted) * 100.0
        int completedDayIndex = f_weekdayIndex(dayofweek(time, reportTZ))
        if completedDayIndex >= 0
            string completedDayName = f_weekdayName(completedDayIndex)
            if na(bestDailyCPL) or currentDayCPL > bestDailyCPL
                bestDailyCPL := currentDayCPL
                bestDailyCPLName := completedDayName
            if na(bestDailyWinRate) or completedDayWinRate > bestDailyWinRate
                bestDailyWinRate := completedDayWinRate
                bestDailyWinRateName := completedDayName
    currentDayCPL := 0.0
    currentDayWins := 0
    currentDayCompleted := 0

// Report display schedule (America/New_York):
// - PM report appears at 09:00 and is dismissed at 09:27:30, before NY opens.
// - NY report becomes visible only during its final-15-minute eligibility
//   window (normally 16:45-17:00), and is dismissed at 17:57:30 Monday-Thursday.
// - Friday NY + Weekly reports persist through the weekend until Sunday 17:57:30.
// timenow enables the requested :30-second dismissals during live execution;
// time_close is used for historical bars/replay where timenow is not a bar clock.
int reportClockTS = barstate.isrealtime ? timenow : time_close
int reportClockYear = year(reportClockTS, reportTZ)
int reportClockMonth = month(reportClockTS, reportTZ)
int reportClockDay = dayofmonth(reportClockTS, reportTZ)
int pmReportPrintTS = timestamp(reportTZ, reportClockYear, reportClockMonth, reportClockDay, 9, 0, 0)
int pmReportDismissTS = timestamp(reportTZ, reportClockYear, reportClockMonth, reportClockDay, 9, 27, 30)
int weekdayNYDismissTS = timestamp(reportTZ, reportClockYear, reportClockMonth, reportClockDay, 17, 57, 30)
int sundayReportDismissTS = timestamp(reportTZ, reportClockYear, reportClockMonth, reportClockDay, 17, 57, 30)
int reportClockDOW = dayofweek(reportClockTS, reportTZ)
bool reportClockIsSunday = reportClockDOW == dayofweek.sunday
bool reportClockIsMondayThroughThursday = reportClockDOW >= dayofweek.monday and reportClockDOW <= dayofweek.thursday
bool weekdayNYDismissReached = reportClockIsMondayThroughThursday and reportClockTS >= weekdayNYDismissTS
bool sundayDismissReached = reportClockIsSunday and reportClockTS >= sundayReportDismissTS
bool pmReportWindowActive = inPMSession and reportClockTS >= pmReportPrintTS and reportClockTS < pmReportDismissTS

if premiumFeatures
    if showDailyReport
        if pmReportWindowActive
            dailyReportVisible := true
            dailyReportSessionType := 1
        else if nyReportEligibleBar
            dailyReportVisible := true
            dailyReportSessionType := 2

    if showWeeklyReport and weeklyReportEligibleBar
        weeklyReportVisible := true

    // PM report expires at 09:27:30. NY reports expire at 17:57:30 Mon-Thu.
    // Friday NY and Weekly reports remain visible until the Sunday cutoff.
    if dailyReportVisible and dailyReportSessionType == 1 and reportClockTS >= pmReportDismissTS
        dailyReportVisible := false
    if weekdayNYDismissReached
        dailyReportVisible := false
        weeklyReportVisible := false
    if sundayDismissReached
        dailyReportVisible := false
        weeklyReportVisible := false

if not showDailyReport or not premiumFeatures
    dailyReportVisible := false

if not showWeeklyReport or not premiumFeatures
    weeklyReportVisible := false

// Persist each finished session's price range into the weekday row used by the Weekly Report.
// The PM session runs overnight and is assigned to the following trading day (18:00 ET + 6h).
// The NY session is assigned to its own calendar/trading day (18:00 ET - 6h).
if nySessionStarted and not na(pmSessionHighPrice) and not na(pmSessionLowPrice)
    int finishedPMDayIndex = f_weekdayIndex(dayofweek(time, reportTZ))
    if finishedPMDayIndex >= 0
        array.set(weeklyDailyPMRange, finishedPMDayIndex, pmSessionHighPrice - pmSessionLowPrice)

if pmSessionStarted and not na(nySessionHighPrice) and not na(nySessionLowPrice)
    int finishedNYDayIndex = f_weekdayIndex(dayofweek(time - 6 * 60 * 60 * 1000, reportTZ))
    if finishedNYDayIndex >= 0
        array.set(weeklyDailyNYRange, finishedNYDayIndex, nySessionHighPrice - nySessionLowPrice)

// Finalize the just-completed session into the Weekly Report's average
// Highest CP&L / Lowest CP&L metrics before that session is later reset.
// Empty sessions are excluded so they do not artificially dilute the averages.
if nySessionStarted and pmSessionCompletedTrades > 0
    weeklyPMHighestCPLSum += pmSessionHighestCPL
    weeklyPMLowestCPLSum += pmSessionLowestCPL
    weeklyPMSessionMetricCount += 1

if pmSessionStarted and nySessionCompletedTrades > 0
    weeklyNYHighestCPLSum += nySessionHighestCPL
    weeklyNYLowestCPLSum += nySessionLowestCPL
    weeklyNYSessionMetricCount += 1

// Reset only the cumulative result belonging to the session that has just begun.
// The opposite session's last result remains stored until that session begins again.
if nySessionStarted
    runnerNYQualified := 0
    runnerNYResolved := 0
    runnerNYCPL := 0.0
    runnerNYGrossProfit := 0.0
    runnerNYGrossLoss := 0.0
    runnerNYExtensionSumATR := 0.0
    runnerNYMaxExtensionATR := 0.0
    for runnerHitIndex = 0 to 4
        array.set(runnerNYTargetHits, runnerHitIndex, 0)
    nySessionRealizedCPL := 0.0
    nySessionTP1CPL := 0.0
    nySessionTP2CPL := 0.0
    nySessionTP3CPL := 0.0
    nySessionHighestCPL := 0.0
    nySessionLowestCPL := 0.0
    nySessionHighPrice := na
    nySessionLowPrice := na
    nySessionGrossProfit := 0.0
    nySessionGrossLoss := 0.0
    nySessionTP1Wins := 0
    nySessionTP2Wins := 0
    nySessionWins := 0
    nySessionCompletedTrades := 0
    array.clear(nyReportDirections)
    array.clear(nyReportEntries)
    array.clear(nyReportExits)
    array.clear(nyReportOutcomes)
    array.clear(nyReportPnL)
if pmSessionStarted
    runnerPMQualified := 0
    runnerPMResolved := 0
    runnerPMCPL := 0.0
    runnerPMGrossProfit := 0.0
    runnerPMGrossLoss := 0.0
    runnerPMExtensionSumATR := 0.0
    runnerPMMaxExtensionATR := 0.0
    for runnerHitIndex = 0 to 4
        array.set(runnerPMTargetHits, runnerHitIndex, 0)
    pmSessionRealizedCPL := 0.0
    pmSessionTP1CPL := 0.0
    pmSessionTP2CPL := 0.0
    pmSessionTP3CPL := 0.0
    pmSessionHighestCPL := 0.0
    pmSessionLowestCPL := 0.0
    // Reset price extremes at the start of every PM session. Without this,
    // Session Range could include highs/lows carried over from prior sessions.
    pmSessionHighPrice := na
    pmSessionLowPrice := na
    pmSessionGrossProfit := 0.0
    pmSessionGrossLoss := 0.0
    pmSessionTP1Wins := 0
    pmSessionTP2Wins := 0
    pmSessionWins := 0
    pmSessionCompletedTrades := 0
    array.clear(pmReportDirections)
    array.clear(pmReportEntries)
    array.clear(pmReportExits)
    array.clear(pmReportOutcomes)
    array.clear(pmReportPnL)

// Track the actual chart-price high/low for each session independently of trade outcomes.
if inPMSession
    pmSessionHighPrice := na(pmSessionHighPrice) ? high : math.max(pmSessionHighPrice, high)
    pmSessionLowPrice := na(pmSessionLowPrice) ? low : math.min(pmSessionLowPrice, low)
if inNYSession
    nySessionHighPrice := na(nySessionHighPrice) ? high : math.max(nySessionHighPrice, high)
    nySessionLowPrice := na(nySessionLowPrice) ? low : math.min(nySessionLowPrice, low)

// Session-only display modes are non-destructive. Visibility is refreshed below,
// while all PM and NY trades remain available to the accounting engines.

// ============================================================================
// RUNNER QUALIFICATION ENGINE
// Predictive criteria latch from TP2 onward. TP4 Extension Confirmation is an
// observed outcome and is evaluated by the post-TP3 live extension observer.
// ============================================================================
if runnerModuleEnabled and runnerAssessmentActive
    bool runnerTP2ReachedNow = runnerAssessDirection == 1 ? high >= runnerAssessTP2 : low <= runnerAssessTP2
    runnerAssessmentStarted := runnerAssessmentStarted or runnerTP2ReachedNow

    if runnerAssessmentStarted
        float runnerATRDifference = math.max(runnerAssessATR, syminfo.mintick)
        bool momentumQualifiedNow = runnerAssessDirection == 1 ? close > close[3] : close < close[3]
        float baselineDirectionalDistanceATR = runnerAssessDirection * (close - signalBaselinePrice) / runnerATRDifference
        bool baselineQualifiedNow = baselineDirectionalDistanceATR >= 1.0
        float emaDirectionalSlopeATR = runnerAssessDirection * (emaBaselinePrice - emaBaselinePrice[3]) / runnerATRDifference
        bool emaSlopeQualifiedNow = emaDirectionalSlopeATR > 0.0

        int runnerActiveTradeIndex = -1
        int runnerStoredTradeCount = array.size(tradeActive)
        if runnerStoredTradeCount > 0
            for runnerTradeScan = runnerStoredTradeCount - 1 to 0
                if array.get(tradeActive, runnerTradeScan)
                    runnerActiveTradeIndex := runnerTradeScan
                    break

        if runnerActiveTradeIndex >= 0
            if momentumQualifiedNow
                array.set(tradeRunnerMomentumQualified, runnerActiveTradeIndex, true)
            if baselineQualifiedNow
                array.set(tradeRunnerBaselineQualified, runnerActiveTradeIndex, true)
            if emaSlopeQualifiedNow
                array.set(tradeRunnerEMASlopeQualified, runnerActiveTradeIndex, true)

            int predictiveEnabledCount = (runnerUseMomentumPersistence ? 1 : 0) + (runnerUseBaselineSeparation ? 1 : 0) + (runnerUseEMASlope ? 1 : 0)
            int predictivePassCount = (runnerUseMomentumPersistence and array.get(tradeRunnerMomentumQualified, runnerActiveTradeIndex) ? 1 : 0) + (runnerUseBaselineSeparation and array.get(tradeRunnerBaselineQualified, runnerActiveTradeIndex) ? 1 : 0) + (runnerUseEMASlope and array.get(tradeRunnerEMASlopeQualified, runnerActiveTradeIndex) ? 1 : 0)

            runnerContinuationProbability := predictiveEnabledCount > 0 ? float(predictivePassCount) / float(predictiveEnabledCount) * 100.0 : na

            bool predictiveAgreementPass = predictiveEnabledCount > 0 and (runnerCriteriaAgreement == "All Enabled" ? predictivePassCount == predictiveEnabledCount : predictivePassCount > 0)

            float previewProgressATR = runnerAssessDirection * (close - runnerAssessEntry) / runnerATRDifference
            float previewRemainingATR = math.max(0.0, 3.0 - previewProgressATR)
            float previewRemainingPct = math.max(0.0, (3.0 - previewProgressATR) / 3.0 * 100.0)
            bool previewProximityPass = runnerPreviewTrigger == "After TP2" ? true : runnerPreviewTrigger == "Within ATR Of TP3" ? previewRemainingATR <= runnerPreviewATRDistance : previewRemainingPct <= runnerPreviewDistancePct

            if predictiveAgreementPass
                runnerArmed := true
                lastRunnerActivationProbability := runnerContinuationProbability

                if previewProximityPass and not runnerPreArmed
                    runnerPreArmed := true

                    while array.size(runnerPreviewTargetLines) > 0
                        line.delete(array.pop(runnerPreviewTargetLines))
                    while array.size(runnerPreviewTargetLabels) > 0
                        label.delete(array.pop(runnerPreviewTargetLabels))

                    if showRunnerPreviewTargets
                        for previewLevel = 4 to runnerMaxTP
                            float previewTargetPrice = runnerAssessEntry + runnerAssessDirection * runnerAssessATR * float(previewLevel)
                            line previewLine = line.new(bar_index, previewTargetPrice, bar_index + initialBoxBars, previewTargetPrice, xloc=xloc.bar_index, color=color.new(runnerTargetColor, 35), width=previewLevel == 4 ? 2 : 1, style=line.style_dashed, force_overlay=true)
                            label previewLabel = label.new(bar_index + initialBoxBars, previewTargetPrice, "TP" + str.tostring(previewLevel), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(runnerTargetColor, 15), size=size.small, force_overlay=true)
                            array.push(runnerPreviewTargetLines, previewLine)
                            array.push(runnerPreviewTargetLabels, previewLabel)

if not runnerModuleEnabled and runnerPreArmed
    runnerPreArmed := false
    while array.size(runnerPreviewTargetLines) > 0
        line.delete(array.pop(runnerPreviewTargetLines))
    while array.size(runnerPreviewTargetLabels) > 0
        label.delete(array.pop(runnerPreviewTargetLabels))

// Keep PRE-ARMED preview targets extended while the core trade remains active.
if runnerPreArmed and showRunnerPreviewTargets
    int previewCount = array.size(runnerPreviewTargetLines)
    if previewCount > 0
        int previewRightBar = bar_index + initialBoxBars
        for previewVisualIndex = 0 to previewCount - 1
            line.set_x2(array.get(runnerPreviewTargetLines, previewVisualIndex), previewRightBar)
            label.set_x(array.get(runnerPreviewTargetLabels, previewVisualIndex), previewRightBar)

// Extend active boxes and deactivate them at SL or TP3.
if array.size(tradeDirections) > 0
    for i = 0 to array.size(tradeDirections) - 1
        if array.get(tradeActive, i)
            int direction = array.get(tradeDirections, i)
            int startBar = array.get(tradeStartBars, i)
            float entryPrice = array.get(tradeEntryPrices, i)
            float tp1Price = array.get(tradeTP1Prices, i)
            float tp2Price = array.get(tradeTP2Prices, i)
            float tp3Price = array.get(tradeTP3Prices, i)
            float slPrice = array.get(tradeSLPrices, i)
            int tradeSessionType = array.get(tradeSessionTypes, i)
            int rightBar = extendActiveBoxes ? math.max(bar_index, startBar + initialBoxBars) : startBar + initialBoxBars

            // Trailing SL follows the LIVE active baseline, but only in the
            // favorable direction. It can tighten through entry to protect profit,
            // but it can never move backward and increase risk.
            if slMode == "Trailing SL"
                float trailingFrozenATR = tp3ATRMult > 0.0 ? math.abs(tp3Price - entryPrice) / tp3ATRMult : currentATR
                float liveTrailingCandidate = signalBaselinePrice - direction * trailingFrozenATR * slTrailingBufferATR
                if not na(liveTrailingCandidate)
                    float ratchetedSL = direction == 1 ? math.max(slPrice, liveTrailingCandidate) : math.min(slPrice, liveTrailingCandidate)
                    slPrice := ratchetedSL
                    array.set(tradeSLPrices, i, ratchetedSL)

            box.set_right(array.get(targetBoxes, i), rightBar)
            box.set_right(array.get(riskBoxes, i), rightBar)
            line.set_x2(array.get(entryLines, i), rightBar)
            line.set_x2(array.get(tp1Lines, i), rightBar)
            line.set_x2(array.get(tp2Lines, i), rightBar)
            line.set_x2(array.get(tp3Lines, i), rightBar)

            if slMode == "Trailing SL"
                box currentRiskBox = array.get(riskBoxes, i)
                box.set_top(currentRiskBox, math.max(entryPrice, slPrice))
                box.set_bottom(currentRiskBox, math.min(entryPrice, slPrice))

            bool tp1HitNow = direction == 1 ? high >= tp1Price : low <= tp1Price
            bool tp2HitNow = direction == 1 ? high >= tp2Price : low <= tp2Price
            bool tp3Hit = direction == 1 ? high >= tp3Price : low <= tp3Price
            bool slHit = direction == 1 ? low <= slPrice : high >= slPrice

            // Preserve milestones reached on prior candles. On a candle that also
            // touches SL, new target touches are not credited because the script's
            // established conservative rule assumes SL occurred first.
            bool tp1WasHit = array.get(tradeTP1Hit, i)
            bool tp2WasHit = array.get(tradeTP2Hit, i)
            bool tp1HitConfirmed = tp1WasHit or (tp1HitNow and not slHit)
            bool tp2HitConfirmed = tp2WasHit or (tp2HitNow and not slHit)
            array.set(tradeTP1Hit, i, tp1HitConfirmed)
            array.set(tradeTP2Hit, i, tp2HitConfirmed)

            if tp3Hit or slHit
                bool completedTradeIsMirror = array.get(tradeIsMirror, i)
                // If both boundaries occur inside one candle, use SL as the
                // conservative outcome because intrabar path cannot be known.
                float completedTradePoints = slHit ? -math.abs(entryPrice - slPrice) : math.abs(tp3Price - entryPrice)
                float tp1StrategyPoints = tp1HitConfirmed ? math.abs(tp1Price - entryPrice) : -math.abs(entryPrice - slPrice)
                float tp2StrategyPoints = tp2HitConfirmed ? math.abs(tp2Price - entryPrice) : -math.abs(entryPrice - slPrice)
                float tp3StrategyPoints = completedTradePoints
                bool tp3Win = tp3Hit and not slHit
                float completedExitPrice = slHit ? slPrice : tp3Price
                string completedOutcome = slHit ? "SL" : "TP3"
                float frozenTradeATR = tp3ATRMult > 0.0 ? math.abs(tp3Price - entryPrice) / tp3ATRMult : currentATR

                // Ext Boxes is independent of Runner qualification. Any clean TP3
                // winner is observed for a 4-ATR reach while its box remains stored.
                if tp3Win and not completedTradeIsMirror
                    float extensionTP4Price = entryPrice + direction * frozenTradeATR * 4.0
                    bool extensionTP4HitNow = direction == 1 ? high >= extensionTP4Price : low <= extensionTP4Price
                    array.set(tradeExtensionHit, i, extensionTP4HitNow)
                    array.set(tradeExtensionWatching, i, not extensionTP4HitNow)
                else
                    array.set(tradeExtensionWatching, i, false)

                bool completedMomentumPass = not runnerUseMomentumPersistence or array.get(tradeRunnerMomentumQualified, i)
                bool completedBaselinePass = not runnerUseBaselineSeparation or array.get(tradeRunnerBaselineQualified, i)
                bool completedEMASlopePass = not runnerUseEMASlope or array.get(tradeRunnerEMASlopeQualified, i)
                int completedPredictiveEnabled = (runnerUseMomentumPersistence ? 1 : 0) + (runnerUseBaselineSeparation ? 1 : 0) + (runnerUseEMASlope ? 1 : 0)
                int completedPredictivePassed = (runnerUseMomentumPersistence and completedMomentumPass ? 1 : 0) + (runnerUseBaselineSeparation and completedBaselinePass ? 1 : 0) + (runnerUseEMASlope and completedEMASlopePass ? 1 : 0)
                bool completedPredictivePass = completedPredictiveEnabled > 0 and (runnerCriteriaAgreement == "All Enabled" ? completedPredictivePassed == completedPredictiveEnabled : completedPredictivePassed > 0)
                runnerContinuationProbability := completedPredictiveEnabled > 0 ? float(completedPredictivePassed) / float(completedPredictiveEnabled) * 100.0 : na

                // PRE-ARMED preview is informational and ends when the core trade ends.
                runnerPreArmed := false
                while array.size(runnerPreviewTargetLines) > 0
                    line.delete(array.pop(runnerPreviewTargetLines))
                while array.size(runnerPreviewTargetLabels) > 0
                    label.delete(array.pop(runnerPreviewTargetLabels))

                // Predictive qualification launches the active runner at TP3.
                // TP4 Extension Confirmation remains outcome validation and, if
                // used alone, can still launch a TP5+ runner later at the TP4 touch.
                if runnerModuleEnabled and not completedTradeIsMirror and tp3Win and completedPredictivePass
                    array.set(tradeRunnerLaunched, i, true)
                    nextRunnerId += 1
                    int newRunnerId = nextRunnerId
                    int initialRunnerHighestLevel = array.get(tradeExtensionHit, i) ? 4 : 3
                    float initialRunnerStop = initialRunnerHighestLevel >= 4 ? tp3Price : tp3Price - direction * frozenTradeATR * runnerProtectionBufferATR
                    array.push(runnerIds, newRunnerId)
                    array.push(runnerDirections, direction)
                    array.push(runnerStartBars, bar_index)
                    array.push(runnerCoreEntries, entryPrice)
                    array.push(runnerTP3Entries, tp3Price)
                    array.push(runnerATRValues, frozenTradeATR)
                    array.push(runnerHighestLevels, initialRunnerHighestLevel)
                    array.push(runnerStops, initialRunnerStop)
                    array.push(runnerMaxFavorableATR, float(initialRunnerHighestLevel))

                    // A runner born on an already-confirmed TP4 must credit TP4 once.
                    if initialRunnerHighestLevel >= 4
                        array.set(runnerTargetHits, 0, array.get(runnerTargetHits, 0) + 1)

                    int originSessionGeneration = array.get(tradeSessionGenerations, i)
                    array.push(runnerOriginSessionTypes, tradeSessionType)
                    array.push(runnerOriginSessionGenerations, originSessionGeneration)
                    array.push(runnerOriginTradingDayKeys, runnerTradingDayKey)
                    array.push(runnerOriginWeekKeys, reportWeekKey)

                    runnerQualifiedCount += 1
                    if tradeSessionType == 1 and originSessionGeneration == pmSessionGeneration
                        runnerPMQualified += 1
                    else if tradeSessionType == 2 and originSessionGeneration == nySessionGeneration
                        runnerNYQualified += 1
                    if tradeSessionType == 1 or tradeSessionType == 2
                        runnerDayQualified += 1
                        runnerWeekQualified += 1

                    if initialRunnerHighestLevel >= 4
                        if tradeSessionType == 1 and originSessionGeneration == pmSessionGeneration
                            array.set(runnerPMTargetHits, 0, array.get(runnerPMTargetHits, 0) + 1)
                        else if tradeSessionType == 2 and originSessionGeneration == nySessionGeneration
                            array.set(runnerNYTargetHits, 0, array.get(runnerNYTargetHits, 0) + 1)
                        array.set(runnerDayTargetHits, 0, array.get(runnerDayTargetHits, 0) + 1)
                        array.set(runnerWeekTargetHits, 0, array.get(runnerWeekTargetHits, 0) + 1)

                    runnerVisualOwnerId := newRunnerId
                    lastRunnerActivationProbability := runnerContinuationProbability

                    while array.size(runnerVisualTargetLines) > 0
                        line.delete(array.pop(runnerVisualTargetLines))
                    while array.size(runnerVisualTargetLabels) > 0
                        label.delete(array.pop(runnerVisualTargetLabels))
                    if not na(runnerVisualStopLine)
                        line.delete(runnerVisualStopLine)
                        runnerVisualStopLine := na

                    if showRunnerTargets and initialRunnerHighestLevel < runnerMaxTP
                        for runnerLevel = initialRunnerHighestLevel + 1 to runnerMaxTP
                            float runnerTargetPrice = entryPrice + direction * frozenTradeATR * float(runnerLevel)
                            line runnerTargetLine = line.new(bar_index, runnerTargetPrice, bar_index + initialBoxBars, runnerTargetPrice, xloc=xloc.bar_index, color=runnerTargetColor, width=runnerLevel == runnerMaxTP ? 2 : 1, style=line.style_dashed, force_overlay=true)
                            label runnerTargetLabel = label.new(bar_index + initialBoxBars, runnerTargetPrice, "TP" + str.tostring(runnerLevel), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=runnerTargetColor, size=size.small, force_overlay=true)
                            array.push(runnerVisualTargetLines, runnerTargetLine)
                            array.push(runnerVisualTargetLabels, runnerTargetLabel)
                        runnerVisualStopLine := line.new(bar_index, initialRunnerStop, bar_index + initialBoxBars, initialRunnerStop, xloc=xloc.bar_index, color=runnerStopColor, width=2, style=line.style_dotted, force_overlay=true)

                runnerAssessmentActive := false
                runnerAssessmentStarted := false
                runnerArmed := false

                // BackTest accounting consumes the exact same completed-trade values
                // used by Dashboard/session accounting. Visual overlap deletion and
                // Maximum Stored Trade Boxes have no effect on these statistics.
                if backtestReplayEnabled and not completedTradeIsMirror
                    btAllCompleted += 1
                    btAllTP1CPL += tp1StrategyPoints
                    btAllTP2CPL += tp2StrategyPoints
                    btAllTP3CPL += tp3StrategyPoints
                    if tp1HitConfirmed
                        btAllTP1Wins += 1
                    if tp2HitConfirmed
                        btAllTP2Wins += 1
                    if tp3Win
                        btAllTP3Wins += 1
                    if completedTradePoints > 0
                        btAllGrossProfit += completedTradePoints
                    else if completedTradePoints < 0
                        btAllGrossLoss += math.abs(completedTradePoints)

                    // Custom Number of Boxes ledger stores every completed replayed
                    // trade, independent of visual box retention.
                    array.push(btCustomRealized, completedTradePoints)
                    array.push(btCustomTP1PnL, tp1StrategyPoints)
                    array.push(btCustomTP2PnL, tp2StrategyPoints)
                    array.push(btCustomTP3PnL, tp3StrategyPoints)
                    array.push(btCustomTP1Hits, tp1HitConfirmed)
                    array.push(btCustomTP2Hits, tp2HitConfirmed)
                    array.push(btCustomTP3Hits, tp3Win)

                    // A trading day is PM + the following NY session. Trades outside
                    // those two configured sessions are excluded from this scope.
                    if tradeSessionType == 1 or tradeSessionType == 2
                        btWeekCompleted += 1
                        btWeekTP1CPL += tp1StrategyPoints
                        btWeekTP2CPL += tp2StrategyPoints
                        btWeekTP3CPL += tp3StrategyPoints
                        if tp1HitConfirmed
                            btWeekTP1Wins += 1
                        if tp2HitConfirmed
                            btWeekTP2Wins += 1
                        if tp3Win
                            btWeekTP3Wins += 1
                        if completedTradePoints > 0
                            btWeekGrossProfit += completedTradePoints
                        else if completedTradePoints < 0
                            btWeekGrossLoss += math.abs(completedTradePoints)

                        btDayCompleted += 1
                        btDayTP1CPL += tp1StrategyPoints
                        btDayTP2CPL += tp2StrategyPoints
                        btDayTP3CPL += tp3StrategyPoints
                        if tp1HitConfirmed
                            btDayTP1Wins += 1
                        if tp2HitConfirmed
                            btDayTP2Wins += 1
                        if tp3Win
                            btDayTP3Wins += 1
                        if completedTradePoints > 0
                            btDayGrossProfit += completedTradePoints
                        else if completedTradePoints < 0
                            btDayGrossLoss += math.abs(completedTradePoints)

                // Weekly and trading-day totals count every completed trade once,
                // regardless of visual overlap removal or box pruning.
                if not completedTradeIsMirror and (tradeSessionType == 1 or tradeSessionType == 2)
                    // Shift six hours so Sunday evening belongs to Monday,
                    // Monday evening belongs to Tuesday, and so on.
                    int completedTradeDayIndex = f_weekdayIndex(dayofweek(time + 6 * 60 * 60 * 1000, reportTZ))
                    if completedTradeDayIndex >= 0
                        float priorDailyTotal = array.get(weeklyDailyCPL, completedTradeDayIndex)
                        array.set(weeklyDailyCPL, completedTradeDayIndex, (na(priorDailyTotal) ? 0.0 : priorDailyTotal) + completedTradePoints)
                        int priorDailyCompleted = array.get(weeklyDailyCompleted, completedTradeDayIndex)
                        int priorDailyWins = array.get(weeklyDailyWins, completedTradeDayIndex)
                        array.set(weeklyDailyCompleted, completedTradeDayIndex, priorDailyCompleted + 1)
                        if tp3Win
                            array.set(weeklyDailyWins, completedTradeDayIndex, priorDailyWins + 1)
                        if tradeSessionType == 1
                            float priorPMTotal = array.get(weeklyDailyPMCPL, completedTradeDayIndex)
                            array.set(weeklyDailyPMCPL, completedTradeDayIndex, (na(priorPMTotal) ? 0.0 : priorPMTotal) + completedTradePoints)
                        else
                            float priorNYTotal = array.get(weeklyDailyNYCPL, completedTradeDayIndex)
                            array.set(weeklyDailyNYCPL, completedTradeDayIndex, (na(priorNYTotal) ? 0.0 : priorNYTotal) + completedTradePoints)

                    weeklyCPL += completedTradePoints
                    weeklyTP1CPL += tp1StrategyPoints
                    weeklyTP2CPL += tp2StrategyPoints
                    if completedTradePoints > 0
                        weeklyGrossProfit += completedTradePoints
                    else if completedTradePoints < 0
                        weeklyGrossLoss += math.abs(completedTradePoints)
                    weeklyCompleted += 1
                    currentDayCPL += completedTradePoints
                    currentDayCompleted += 1
                    if tp1HitConfirmed
                        weeklyTP1Wins += 1
                    if tp2HitConfirmed
                        weeklyTP2Wins += 1
                    if tp3Win
                        weeklyWins += 1
                        currentDayWins += 1
                    if tradeSessionType == 1
                        weeklyPMCPL += completedTradePoints
                        if completedTradePoints > 0
                            weeklyPMGrossProfit += completedTradePoints
                        else if completedTradePoints < 0
                            weeklyPMGrossLoss += math.abs(completedTradePoints)
                        weeklyPMCompleted += 1
                        if tp3Win
                            weeklyPMWins += 1
                    else
                        weeklyNYCPL += completedTradePoints
                        if completedTradePoints > 0
                            weeklyNYGrossProfit += completedTradePoints
                        else if completedTradePoints < 0
                            weeklyNYGrossLoss += math.abs(completedTradePoints)
                        weeklyNYCompleted += 1
                        if tp3Win
                            weeklyNYWins += 1

                if not completedTradeIsMirror and tradeSessionType == 1
                    array.push(pmReportDirections, direction)
                    array.push(pmReportEntries, entryPrice)
                    array.push(pmReportExits, completedExitPrice)
                    array.push(pmReportOutcomes, completedOutcome)
                    array.push(pmReportPnL, completedTradePoints)
                    pmSessionRealizedCPL += completedTradePoints
                    pmSessionTP1CPL += tp1StrategyPoints
                    pmSessionTP2CPL += tp2StrategyPoints
                    pmSessionTP3CPL += tp3StrategyPoints
                    pmSessionHighestCPL := math.max(pmSessionHighestCPL, pmSessionRealizedCPL)
                    pmSessionLowestCPL := math.min(pmSessionLowestCPL, pmSessionRealizedCPL)
                    if completedTradePoints > 0
                        pmSessionGrossProfit += completedTradePoints
                    else if completedTradePoints < 0
                        pmSessionGrossLoss += math.abs(completedTradePoints)
                    pmSessionCompletedTrades += 1
                    if tp1HitConfirmed
                        pmSessionTP1Wins += 1
                    if tp2HitConfirmed
                        pmSessionTP2Wins += 1
                    if tp3Win
                        pmSessionWins += 1
                else if not completedTradeIsMirror and tradeSessionType == 2
                    array.push(nyReportDirections, direction)
                    array.push(nyReportEntries, entryPrice)
                    array.push(nyReportExits, completedExitPrice)
                    array.push(nyReportOutcomes, completedOutcome)
                    array.push(nyReportPnL, completedTradePoints)
                    nySessionRealizedCPL += completedTradePoints
                    nySessionTP1CPL += tp1StrategyPoints
                    nySessionTP2CPL += tp2StrategyPoints
                    nySessionTP3CPL += tp3StrategyPoints
                    nySessionHighestCPL := math.max(nySessionHighestCPL, nySessionRealizedCPL)
                    nySessionLowestCPL := math.min(nySessionLowestCPL, nySessionRealizedCPL)
                    if completedTradePoints > 0
                        nySessionGrossProfit += completedTradePoints
                    else if completedTradePoints < 0
                        nySessionGrossLoss += math.abs(completedTradePoints)
                    nySessionCompletedTrades += 1
                    if tp1HitConfirmed
                        nySessionTP1Wins += 1
                    if tp2HitConfirmed
                        nySessionTP2Wins += 1
                    if tp3Win
                        nySessionWins += 1
                array.set(tradeActive, i, false)

// ============================================================================
// POST-TP3 EXTENSION OBSERVER + LIVE TP4 CRITERION
// Every retained clean TP3 winner is watched for TP4. This is the same ground
// truth used by Ext Boxes and can also qualify a live TP5+ runner at the TP4 touch.
// ============================================================================
int extensionTradeCount = array.size(tradeDirections)
if extensionTradeCount > 0
    for extensionIndex = 0 to extensionTradeCount - 1
        if array.get(tradeExtensionWatching, extensionIndex) and not array.get(tradeExtensionHit, extensionIndex)
            int extensionDirection = array.get(tradeDirections, extensionIndex)
            float extensionEntry = array.get(tradeEntryPrices, extensionIndex)
            float extensionTP3 = array.get(tradeTP3Prices, extensionIndex)
            float extensionFrozenATR = tp3ATRMult > 0.0 ? math.abs(extensionTP3 - extensionEntry) / tp3ATRMult : currentATR
            float extensionTP4 = extensionEntry + extensionDirection * extensionFrozenATR * 4.0
            bool extensionReached = extensionDirection == 1 ? high >= extensionTP4 : low <= extensionTP4
            if extensionReached
                array.set(tradeExtensionHit, extensionIndex, true)
                array.set(tradeExtensionWatching, extensionIndex, false)

        if runnerModuleEnabled and runnerUseTP4Confirmation and not array.get(tradeIsMirror, extensionIndex) and array.get(tradeExtensionHit, extensionIndex) and not array.get(tradeRunnerLaunched, extensionIndex)
            bool extMomentumPass = not runnerUseMomentumPersistence or array.get(tradeRunnerMomentumQualified, extensionIndex)
            bool extBaselinePass = not runnerUseBaselineSeparation or array.get(tradeRunnerBaselineQualified, extensionIndex)
            bool extEMASlopePass = not runnerUseEMASlope or array.get(tradeRunnerEMASlopeQualified, extensionIndex)
            bool extTP4Pass = array.get(tradeExtensionHit, extensionIndex)
            int extEnabledCriteria = (runnerUseMomentumPersistence ? 1 : 0) + (runnerUseBaselineSeparation ? 1 : 0) + (runnerUseEMASlope ? 1 : 0) + 1
            int extPassedCriteria = (runnerUseMomentumPersistence and extMomentumPass ? 1 : 0) + (runnerUseBaselineSeparation and extBaselinePass ? 1 : 0) + (runnerUseEMASlope and extEMASlopePass ? 1 : 0) + (extTP4Pass ? 1 : 0)
            bool extCriteriaPass = runnerCriteriaAgreement == "All Enabled" ? extPassedCriteria == extEnabledCriteria : extPassedCriteria > 0

            if extCriteriaPass
                int extDirection = array.get(tradeDirections, extensionIndex)
                float extEntry = array.get(tradeEntryPrices, extensionIndex)
                float extTP3 = array.get(tradeTP3Prices, extensionIndex)
                float extFrozenATR = tp3ATRMult > 0.0 ? math.abs(extTP3 - extEntry) / tp3ATRMult : currentATR
                int extOriginSessionType = array.get(tradeSessionTypes, extensionIndex)
                int extOriginSessionGeneration = array.get(tradeSessionGenerations, extensionIndex)
                int extOriginDayKey = array.get(tradeTradingDayKeys, extensionIndex)
                int extOriginWeekKey = array.get(tradeWeekKeys, extensionIndex)

                nextRunnerId += 1
                int extRunnerId = nextRunnerId
                float extRunnerStop = extTP3
                array.push(runnerIds, extRunnerId)
                array.push(runnerDirections, extDirection)
                array.push(runnerStartBars, bar_index)
                array.push(runnerCoreEntries, extEntry)
                array.push(runnerTP3Entries, extTP3)
                array.push(runnerATRValues, extFrozenATR)
                array.push(runnerHighestLevels, 4)
                array.push(runnerStops, extRunnerStop)
                array.push(runnerMaxFavorableATR, 4.0)
                array.push(runnerOriginSessionTypes, extOriginSessionType)
                array.push(runnerOriginSessionGenerations, extOriginSessionGeneration)
                array.push(runnerOriginTradingDayKeys, extOriginDayKey)
                array.push(runnerOriginWeekKeys, extOriginWeekKey)

                runnerQualifiedCount += 1
                array.set(runnerTargetHits, 0, array.get(runnerTargetHits, 0) + 1)
                if extOriginSessionType == 1 and extOriginSessionGeneration == pmSessionGeneration
                    runnerPMQualified += 1
                    array.set(runnerPMTargetHits, 0, array.get(runnerPMTargetHits, 0) + 1)
                else if extOriginSessionType == 2 and extOriginSessionGeneration == nySessionGeneration
                    runnerNYQualified += 1
                    array.set(runnerNYTargetHits, 0, array.get(runnerNYTargetHits, 0) + 1)
                if extOriginDayKey == runnerTradingDayKey
                    runnerDayQualified += 1
                    array.set(runnerDayTargetHits, 0, array.get(runnerDayTargetHits, 0) + 1)
                if extOriginWeekKey == reportWeekKey
                    runnerWeekQualified += 1
                    array.set(runnerWeekTargetHits, 0, array.get(runnerWeekTargetHits, 0) + 1)

                array.set(tradeRunnerLaunched, extensionIndex, true)
                runnerVisualOwnerId := extRunnerId
                runnerContinuationProbability := float(extPassedCriteria) / float(extEnabledCriteria) * 100.0
                lastRunnerActivationProbability := runnerContinuationProbability

                while array.size(runnerVisualTargetLines) > 0
                    line.delete(array.pop(runnerVisualTargetLines))
                while array.size(runnerVisualTargetLabels) > 0
                    label.delete(array.pop(runnerVisualTargetLabels))
                if not na(runnerVisualStopLine)
                    line.delete(runnerVisualStopLine)
                    runnerVisualStopLine := na

                if showRunnerTargets and runnerMaxTP > 4
                    for extRunnerLevel = 5 to runnerMaxTP
                        float extRunnerTargetPrice = extEntry + extDirection * extFrozenATR * float(extRunnerLevel)
                        line extTargetLine = line.new(bar_index, extRunnerTargetPrice, bar_index + initialBoxBars, extRunnerTargetPrice, xloc=xloc.bar_index, color=runnerTargetColor, width=extRunnerLevel == runnerMaxTP ? 2 : 1, style=line.style_dashed, force_overlay=true)
                        label extTargetLabel = label.new(bar_index + initialBoxBars, extRunnerTargetPrice, "TP" + str.tostring(extRunnerLevel), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=runnerTargetColor, size=size.small, force_overlay=true)
                        array.push(runnerVisualTargetLines, extTargetLine)
                        array.push(runnerVisualTargetLabels, extTargetLabel)
                    runnerVisualStopLine := line.new(bar_index, extRunnerStop, bar_index + initialBoxBars, extRunnerStop, xloc=xloc.bar_index, color=runnerStopColor, width=2, style=line.style_dotted, force_overlay=true)

// Keep the panel state synchronized with its associated trade box.
// Qualification latches the panel on; TP3 or SL touch ends its display immediately.
if commitmentTradeActive
    bool commitmentTP1ReachedNow = commitmentTradeDirection == 1 ? high >= commitmentTP1 : low <= commitmentTP1
    bool commitmentTP2ReachedNow = commitmentTradeDirection == 1 ? high >= commitmentTP2 : low <= commitmentTP2
    commitmentTP1Hit := commitmentTP1Hit or commitmentTP1ReachedNow
    commitmentTP2Hit := commitmentTP2Hit or commitmentTP2ReachedNow
    bool commitmentTP3ReachedNow = commitmentTradeDirection == 1 ? high >= commitmentTP3 : low <= commitmentTP3
    bool commitmentSLReachedNow = commitmentTradeDirection == 1 ? low <= commitmentSL : high >= commitmentSL
    commitmentTP3Hit := commitmentTP3Hit or commitmentTP3ReachedNow
    commitmentSLHit := commitmentSLHit or commitmentSLReachedNow

// ============================================================================
// ACTIVE RUNNER MANAGEMENT
// Conservative same-bar rule: protection is assumed first if protection and a
// new target are both touched. Protection steps one target behind each new hit.
// ============================================================================
if runnerModuleEnabled and array.size(runnerIds) > 0
    int runnerIndex = array.size(runnerIds) - 1
    while runnerIndex >= 0
        int rId = array.get(runnerIds, runnerIndex)
        int rDirection = array.get(runnerDirections, runnerIndex)
        int rStartBar = array.get(runnerStartBars, runnerIndex)
        float rCoreEntry = array.get(runnerCoreEntries, runnerIndex)
        float rTP3Entry = array.get(runnerTP3Entries, runnerIndex)
        float rATR = array.get(runnerATRValues, runnerIndex)
        int rHighestLevel = array.get(runnerHighestLevels, runnerIndex)
        float rStop = array.get(runnerStops, runnerIndex)
        float rMaxFavATR = array.get(runnerMaxFavorableATR, runnerIndex)
        int rOriginSessionType = array.get(runnerOriginSessionTypes, runnerIndex)
        int rOriginSessionGeneration = array.get(runnerOriginSessionGenerations, runnerIndex)
        int rOriginTradingDayKey = array.get(runnerOriginTradingDayKeys, runnerIndex)
        int rOriginWeekKey = array.get(runnerOriginWeekKeys, runnerIndex)

        float currentFavATR = rDirection == 1 ? (high - rCoreEntry) / math.max(rATR, syminfo.mintick) : (rCoreEntry - low) / math.max(rATR, syminfo.mintick)
        rMaxFavATR := math.max(rMaxFavATR, currentFavATR)
        array.set(runnerMaxFavorableATR, runnerIndex, rMaxFavATR)

        bool rStopHit = rDirection == 1 ? low <= rStop : high >= rStop
        bool rResolved = false
        float rExitPrice = na

        if rStopHit
            rResolved := true
            rExitPrice := rStop
        else
            int newHighestLevel = rHighestLevel
            if rHighestLevel < runnerMaxTP
                for runnerLevel = rHighestLevel + 1 to runnerMaxTP
                    float runnerTargetPrice = rCoreEntry + rDirection * rATR * float(runnerLevel)
                    bool runnerTargetHit = rDirection == 1 ? high >= runnerTargetPrice : low <= runnerTargetPrice
                    if runnerTargetHit
                        newHighestLevel := runnerLevel
                    else
                        break

            if newHighestLevel > rHighestLevel
                for runnerLevel = rHighestLevel + 1 to newHighestLevel
                    int hitIndex = runnerLevel - 4
                    if hitIndex >= 0 and hitIndex < array.size(runnerTargetHits)
                        array.set(runnerTargetHits, hitIndex, array.get(runnerTargetHits, hitIndex) + 1)
                        if rOriginSessionType == 1 and rOriginSessionGeneration == pmSessionGeneration
                            array.set(runnerPMTargetHits, hitIndex, array.get(runnerPMTargetHits, hitIndex) + 1)
                        else if rOriginSessionType == 2 and rOriginSessionGeneration == nySessionGeneration
                            array.set(runnerNYTargetHits, hitIndex, array.get(runnerNYTargetHits, hitIndex) + 1)
                        if rOriginTradingDayKey == runnerTradingDayKey
                            array.set(runnerDayTargetHits, hitIndex, array.get(runnerDayTargetHits, hitIndex) + 1)
                        if rOriginWeekKey == reportWeekKey
                            array.set(runnerWeekTargetHits, hitIndex, array.get(runnerWeekTargetHits, hitIndex) + 1)
                rHighestLevel := newHighestLevel
                array.set(runnerHighestLevels, runnerIndex, rHighestLevel)

                float steppedStop = rCoreEntry + rDirection * rATR * float(rHighestLevel - 1)
                if rDirection == 1
                    rStop := math.max(rStop, steppedStop)
                else
                    rStop := math.min(rStop, steppedStop)
                array.set(runnerStops, runnerIndex, rStop)

            if rHighestLevel >= runnerMaxTP
                rResolved := true
                rExitPrice := rCoreEntry + rDirection * rATR * float(runnerMaxTP)

        if rId == runnerVisualOwnerId and showRunnerTargets
            int runnerRightBar = math.max(bar_index + 1, rStartBar + initialBoxBars)
            int visualCount = array.size(runnerVisualTargetLines)
            if visualCount > 0
                for visualIndex = 0 to visualCount - 1
                    line.set_x2(array.get(runnerVisualTargetLines, visualIndex), runnerRightBar)
                    label.set_x(array.get(runnerVisualTargetLabels, visualIndex), runnerRightBar)
            if not na(runnerVisualStopLine)
                line.set_x2(runnerVisualStopLine, runnerRightBar)
                line.set_y1(runnerVisualStopLine, rStop)
                line.set_y2(runnerVisualStopLine, rStop)

        if rResolved
            float runnerResultPoints = rDirection * (rExitPrice - rTP3Entry)
            runnerResolvedCount += 1
            runnerCPL += runnerResultPoints
            if runnerResultPoints > 0
                runnerGrossProfit += runnerResultPoints
            else if runnerResultPoints < 0
                runnerGrossLoss += math.abs(runnerResultPoints)

            float extensionBeyondTP3ATR = math.max(0.0, rMaxFavATR - 3.0)
            runnerExtensionSumATR += extensionBeyondTP3ATR
            runnerMaxExtensionATR := math.max(runnerMaxExtensionATR, extensionBeyondTP3ATR)

            if rOriginSessionType == 1 and rOriginSessionGeneration == pmSessionGeneration
                runnerPMResolved += 1
                runnerPMCPL += runnerResultPoints
                if runnerResultPoints > 0
                    runnerPMGrossProfit += runnerResultPoints
                else if runnerResultPoints < 0
                    runnerPMGrossLoss += math.abs(runnerResultPoints)
                runnerPMExtensionSumATR += extensionBeyondTP3ATR
                runnerPMMaxExtensionATR := math.max(runnerPMMaxExtensionATR, extensionBeyondTP3ATR)
            else if rOriginSessionType == 2 and rOriginSessionGeneration == nySessionGeneration
                runnerNYResolved += 1
                runnerNYCPL += runnerResultPoints
                if runnerResultPoints > 0
                    runnerNYGrossProfit += runnerResultPoints
                else if runnerResultPoints < 0
                    runnerNYGrossLoss += math.abs(runnerResultPoints)
                runnerNYExtensionSumATR += extensionBeyondTP3ATR
                runnerNYMaxExtensionATR := math.max(runnerNYMaxExtensionATR, extensionBeyondTP3ATR)

            if rOriginTradingDayKey == runnerTradingDayKey
                runnerDayResolved += 1
                runnerDayCPL += runnerResultPoints
                if runnerResultPoints > 0
                    runnerDayGrossProfit += runnerResultPoints
                else if runnerResultPoints < 0
                    runnerDayGrossLoss += math.abs(runnerResultPoints)
                runnerDayExtensionSumATR += extensionBeyondTP3ATR
                runnerDayMaxExtensionATR := math.max(runnerDayMaxExtensionATR, extensionBeyondTP3ATR)

            if rOriginWeekKey == reportWeekKey
                runnerWeekResolved += 1
                runnerWeekCPL += runnerResultPoints
                if runnerResultPoints > 0
                    runnerWeekGrossProfit += runnerResultPoints
                else if runnerResultPoints < 0
                    runnerWeekGrossLoss += math.abs(runnerResultPoints)
                runnerWeekExtensionSumATR += extensionBeyondTP3ATR
                runnerWeekMaxExtensionATR := math.max(runnerWeekMaxExtensionATR, extensionBeyondTP3ATR)

            if rId == runnerVisualOwnerId
                while array.size(runnerVisualTargetLines) > 0
                    line.delete(array.pop(runnerVisualTargetLines))
                while array.size(runnerVisualTargetLabels) > 0
                    label.delete(array.pop(runnerVisualTargetLabels))
                if not na(runnerVisualStopLine)
                    line.delete(runnerVisualStopLine)
                    runnerVisualStopLine := na
                runnerVisualOwnerId := na

            array.remove(runnerIds, runnerIndex)
            array.remove(runnerDirections, runnerIndex)
            array.remove(runnerStartBars, runnerIndex)
            array.remove(runnerCoreEntries, runnerIndex)
            array.remove(runnerTP3Entries, runnerIndex)
            array.remove(runnerATRValues, runnerIndex)
            array.remove(runnerHighestLevels, runnerIndex)
            array.remove(runnerStops, runnerIndex)
            array.remove(runnerMaxFavorableATR, runnerIndex)
            array.remove(runnerOriginSessionTypes, runnerIndex)
            array.remove(runnerOriginSessionGenerations, runnerIndex)
            array.remove(runnerOriginTradingDayKeys, runnerIndex)
            array.remove(runnerOriginWeekKeys, runnerIndex)

        runnerIndex -= 1

// ============================================================================
// TRADE BOX CREATION
// A box is created intrabar at the instant the realtime signal qualifies.
// Same-direction price/time overlaps keep the existing newest-box replacement
// behavior. A proposed box in the OPPOSITE direction is rejected only when it
// overlaps an existing ACTIVE opposite-direction box. That active box is kept,
// and the rejected opposite box does not affect the removed-box count.
// ============================================================================
bool hasActiveTradeBox = false
if array.size(tradeActive) > 0
    for i = 0 to array.size(tradeActive) - 1
        if array.get(tradeActive, i)
            hasActiveTradeBox := true

// Price-chart arrows are visual signal markers. Box-overlap rules below govern
// whether the corresponding trade box is actually printed.
bool showUnlockedBuyArrow = showTriangleMarkers and showBuySignals and buySignal
bool showUnlockedSellArrow = showTriangleMarkers and showSellSignals and sellSignal
// Informational confluence visuals. EMA lines are intentionally hidden; only the ribbon fill is optional.
ribbonFastPlot = plot(enableRibbonScore ? ribbonFastEMA : na, "Ribbon EMA 14 (hidden)", color=color.new(color.white, 100), linewidth=1)
ribbonSlowPlot = plot(enableRibbonScore ? ribbonSlowEMA : na, "Ribbon EMA 50 (hidden)", color=color.new(color.white, 100), linewidth=1)
int ribbonBullTrans = ribbonBullScore == 6 ? 10 : ribbonBullScore == 5 ? 25 : ribbonBullScore == 4 ? 45 : ribbonBullScore == 3 ? 62 : ribbonBullScore == 2 ? 78 : 90
int ribbonBearTrans = ribbonBearScore == 6 ? 10 : ribbonBearScore == 5 ? 25 : ribbonBearScore == 4 ? 45 : ribbonBearScore == 3 ? 62 : ribbonBearScore == 2 ? 78 : 90
color ribbonColor = ribbonBullScore > ribbonBearScore ? color.new(color.lime, ribbonBullTrans) : ribbonBearScore > ribbonBullScore ? color.new(color.red, ribbonBearTrans) : color.new(color.gray, 92)
fill(ribbonFastPlot, ribbonSlowPlot, color=enableRibbonScore and showRibbon ? ribbonColor : na, title="EMA/MACD/RSI Ribbon")

var line srSupportLine = na
var line srResistanceLine = na
if barstate.islast
    line.delete(srSupportLine)
    line.delete(srResistanceLine)
    if enableSRZoneEngine
        if not na(nearestSupport)
            srSupportLine := line.new(bar_index - math.min(srZoneLookback, bar_index), nearestSupport, bar_index + 20, nearestSupport, xloc=xloc.bar_index, color=color.new(color.green, 0), width=2, extend=extend.right, force_overlay=true)
        if not na(nearestResistance)
            srResistanceLine := line.new(bar_index - math.min(srZoneLookback, bar_index), nearestResistance, bar_index + 20, nearestResistance, xloc=xloc.bar_index, color=color.new(color.red, 0), width=2, extend=extend.right, force_overlay=true)

plotshape(showUnlockedBuyArrow and markerSizeInput == "Tiny", title="DPO Buy Triangle Tiny", style=shape.triangleup, location=location.belowbar, color=buyColor, size=size.tiny, force_overlay=true)
plotshape(showUnlockedBuyArrow and markerSizeInput == "Small", title="DPO Buy Triangle Small", style=shape.triangleup, location=location.belowbar, color=buyColor, size=size.small, force_overlay=true)
plotshape(showUnlockedBuyArrow and markerSizeInput == "Normal", title="DPO Buy Triangle Normal", style=shape.triangleup, location=location.belowbar, color=buyColor, size=size.normal, force_overlay=true)
plotshape(showUnlockedBuyArrow and markerSizeInput == "Large", title="DPO Buy Triangle Large", style=shape.triangleup, location=location.belowbar, color=buyColor, size=size.large, force_overlay=true)
plotshape(showUnlockedSellArrow and markerSizeInput == "Tiny", title="DPO Sell Triangle Tiny", style=shape.triangledown, location=location.abovebar, color=sellColor, size=size.tiny, force_overlay=true)
plotshape(showUnlockedSellArrow and markerSizeInput == "Small", title="DPO Sell Triangle Small", style=shape.triangledown, location=location.abovebar, color=sellColor, size=size.small, force_overlay=true)
plotshape(showUnlockedSellArrow and markerSizeInput == "Normal", title="DPO Sell Triangle Normal", style=shape.triangledown, location=location.abovebar, color=sellColor, size=size.normal, force_overlay=true)
plotshape(showUnlockedSellArrow and markerSizeInput == "Large", title="DPO Sell Triangle Large", style=shape.triangledown, location=location.abovebar, color=sellColor, size=size.large, force_overlay=true)

// Every valid trade is generated and accounted for regardless of the selected
// display mode. The display dropdown is applied later as a visibility-only rule.
// Both optional gates operate ONLY at box creation, after the original
// DPO/trend/signal logic. Triangle signals, alertconditions and existing
// active trades are unchanged when a box is suppressed.
bool beiContextAllowsNewBox = beiSessionPrepReady and beiChopAllowsBox
bool createLongBox = showTradeBoxes and showBuySignals and buySignal and beiContextAllowsNewBox
bool createShortBox = showTradeBoxes and showSellSignals and sellSignal and beiContextAllowsNewBox

if createLongBox or createShortBox
    int direction = createLongBox ? 1 : -1
    // Anchor the trade permanently to the price level where DPO equals zero.
    // The zero-level price, ATR, and crossover-candle open are captured on the
    // first intrabar cross and remain fixed for the entire life of the trade box.
    float entryPrice = latchedBaselineEntryPrice
    float stopBaselinePrice = latchedStopBaselinePrice
    float crossATR = latchedCrossATR
    float crossOpen = latchedCrossOpen

    // Modular stop-reference engine. The qualifying baseline is frozen at signal time
    // so later EMA/DPO movement cannot move an existing trade's stop.
    float atrStopPrice = entryPrice - direction * crossATR * slATRMult
    float baselineStopPrice = stopBaselinePrice
    float baselineBufferedStopPrice = stopBaselinePrice - direction * crossATR * slBaselineBufferATR
    float trailingInitialStopPrice = stopBaselinePrice - direction * crossATR * slTrailingBufferATR

    // Ensure baseline-derived stops remain on the risk side of the frozen entry
    // at creation. Trailing SL may later ratchet through entry and lock profit.
    float oneTickRiskSide = entryPrice - direction * syminfo.mintick
    if direction == 1
        baselineStopPrice := math.min(baselineStopPrice, oneTickRiskSide)
        baselineBufferedStopPrice := math.min(baselineBufferedStopPrice, oneTickRiskSide)
        trailingInitialStopPrice := math.min(trailingInitialStopPrice, oneTickRiskSide)
    else
        baselineStopPrice := math.max(baselineStopPrice, oneTickRiskSide)
        baselineBufferedStopPrice := math.max(baselineBufferedStopPrice, oneTickRiskSide)
        trailingInitialStopPrice := math.max(trailingInitialStopPrice, oneTickRiskSide)

    // Hybrid chooses the tighter valid protective stop:
    // LONG = higher of ATR stop and buffered-baseline stop.
    // SHORT = lower of ATR stop and buffered-baseline stop.
    float hybridStopPrice = direction == 1 ? math.max(atrStopPrice, baselineBufferedStopPrice) : math.min(atrStopPrice, baselineBufferedStopPrice)

    float slPrice = slMode == "Baseline" ? baselineStopPrice :
         slMode == "Baseline + Buffer" ? baselineBufferedStopPrice :
         slMode == "Hybrid" ? hybridStopPrice :
         slMode == "Trailing SL" ? trailingInitialStopPrice :
         atrStopPrice

    float tp1Price = entryPrice + direction * crossATR * tp1ATRMult
    float tp2Price = entryPrice + direction * crossATR * tp2ATRMult
    float tp3Price = entryPrice + direction * crossATR * tp3ATRMult

    float targetTop = math.max(entryPrice, tp3Price)
    float targetBottom = math.min(entryPrice, tp3Price)
    float riskTop = math.max(entryPrice, slPrice)
    float riskBottom = math.min(entryPrice, slPrice)
    float newTradeTop = math.max(targetTop, riskTop)
    float newTradeBottom = math.min(targetBottom, riskBottom)
    int rightBar = bar_index + initialBoxBars
    [frozenGrade, frozenGradeRatio] = f_confluenceGrade(direction)

    // First apply the new opposite-side protection rule.
    // This branch never deletes the existing active opposite box and never
    // increments the same-direction represented/removed count.
    bool blockedByOppositeActiveOverlap = false
    int oppositeOverlapIndex = array.size(tradeDirections) - 1
    while oppositeOverlapIndex >= 0 and not blockedByOppositeActiveOverlap
        bool existingIsActive = array.get(tradeActive, oppositeOverlapIndex)
        int existingDirection = array.get(tradeDirections, oppositeOverlapIndex)
        bool oppositeDirection = existingDirection != direction
        if existingIsActive and oppositeDirection
            box existingTargetBox = array.get(targetBoxes, oppositeOverlapIndex)
            box existingRiskBox = array.get(riskBoxes, oppositeOverlapIndex)
            int existingLeft = math.min(box.get_left(existingTargetBox), box.get_left(existingRiskBox))
            int existingRight = math.max(box.get_right(existingTargetBox), box.get_right(existingRiskBox))
            float existingTop = math.max(box.get_top(existingTargetBox), box.get_top(existingRiskBox))
            float existingBottom = math.min(box.get_bottom(existingTargetBox), box.get_bottom(existingRiskBox))
            bool timeOverlap = bar_index <= existingRight and rightBar >= existingLeft
            bool priceOverlap = newTradeBottom <= existingTop and newTradeTop >= existingBottom
            if timeOverlap and priceOverlap
                blockedByOppositeActiveOverlap := true
        oppositeOverlapIndex -= 1

    if not blockedByOppositeActiveOverlap
        // Existing same-direction behavior: keep only the newest box whenever
        // same-direction trade-box price and time ranges overlap.
        // representedTradeCount includes the removed visible box plus any boxes
        // it had already replaced, preserving the existing -N label behavior.
        int representedTradeCount = 1
        int overlapIndex = array.size(tradeDirections) - 1
        while overlapIndex >= 0
            box existingTargetBox = array.get(targetBoxes, overlapIndex)
            box existingRiskBox = array.get(riskBoxes, overlapIndex)
            int existingLeft = math.min(box.get_left(existingTargetBox), box.get_left(existingRiskBox))
            int existingRight = math.max(box.get_right(existingTargetBox), box.get_right(existingRiskBox))
            float existingTop = math.max(box.get_top(existingTargetBox), box.get_top(existingRiskBox))
            float existingBottom = math.min(box.get_bottom(existingTargetBox), box.get_bottom(existingRiskBox))
            int existingDirection = array.get(tradeDirections, overlapIndex)
            bool sameDirection = existingDirection == direction
            bool timeOverlap = bar_index <= existingRight and rightBar >= existingLeft
            bool priceOverlap = newTradeBottom <= existingTop and newTradeTop >= existingBottom
            if sameDirection and timeOverlap and priceOverlap
                representedTradeCount += array.get(representedTradeCounts, overlapIndex)
                f_deleteTradeAt(overlapIndex)
            overlapIndex -= 1

        box targetBox = box.new(bar_index, targetTop, rightBar, targetBottom, xloc=xloc.bar_index,
             border_color=color.new(tpBoxColor, 0), bgcolor=tpBoxColor, border_width=1, force_overlay=true)
        box riskBox = box.new(bar_index, riskTop, rightBar, riskBottom, xloc=xloc.bar_index,
             border_color=slLineColor, bgcolor=slBoxColor, border_width=1, force_overlay=true)
        line entryLine = line.new(bar_index, entryPrice, rightBar, entryPrice, xloc=xloc.bar_index,
             color=entryLineColor, width=2, force_overlay=true)
        line tp1Line = line.new(bar_index, tp1Price, rightBar, tp1Price, xloc=xloc.bar_index,
             color=showTPLevels ? tp1Color : color.new(tp1Color, 100), width=1, style=line.style_dashed, force_overlay=true)
        line tp2Line = line.new(bar_index, tp2Price, rightBar, tp2Price, xloc=xloc.bar_index,
             color=showTPLevels ? tp2Color : color.new(tp2Color, 100), width=1, style=line.style_dashed, force_overlay=true)
        line tp3Line = line.new(bar_index, tp3Price, rightBar, tp3Price, xloc=xloc.bar_index,
             color=showTPLevels ? tp3Color : color.new(tp3Color, 100), width=2, force_overlay=true)

        array.push(targetBoxes, targetBox)
        array.push(riskBoxes, riskBox)
        array.push(entryLines, entryLine)
        array.push(tp1Lines, tp1Line)
        array.push(tp2Lines, tp2Line)
        array.push(tp3Lines, tp3Line)
        array.push(tradeDirections, direction)
        array.push(tradeStartBars, bar_index)
        array.push(tradeEntryPrices, entryPrice)
        array.push(tradeTP1Prices, tp1Price)
        array.push(tradeTP2Prices, tp2Price)
        array.push(tradeTP3Prices, tp3Price)
        array.push(tradeSLPrices, slPrice)
        array.push(tradeTP1Hit, false)
        array.push(tradeTP2Hit, false)
        array.push(tradeExtensionWatching, false)
        array.push(tradeExtensionHit, false)
        array.push(tradeRunnerMomentumQualified, false)
        array.push(tradeRunnerBaselineQualified, false)
        array.push(tradeRunnerEMASlopeQualified, false)
        array.push(tradeRunnerLaunched, false)
        int newTradeSessionType = inPMSession ? 1 : inNYSession ? 2 : 0
        int newTradeSessionGeneration = newTradeSessionType == 1 ? pmSessionGeneration : newTradeSessionType == 2 ? nySessionGeneration : 0
        array.push(tradeSessionTypes, newTradeSessionType)
        array.push(tradeSessionGenerations, newTradeSessionGeneration)
        array.push(tradeTradingDayKeys, runnerTradingDayKey)
        array.push(tradeWeekKeys, reportWeekKey)
        array.push(tradeActive, true)
        array.push(tradeIsMirror, flipMirrorModeActive)

        int removedOverlapCount = representedTradeCount - 1
        label overlapLabel = na
        if premiumOverlapCountsEnabled and removedOverlapCount > 0
            float labelY = newTradeTop + syminfo.mintick * 2.0
            overlapLabel := label.new(bar_index + 1, labelY, "-" + str.tostring(removedOverlapCount),
                 xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.white,
                 size=size.small, textalign=text.align_left, force_overlay=true)
        array.push(overlapLabels, overlapLabel)
        array.push(tradeGradeLabels, na)
        array.push(tradeGrades, frozenGrade)
        array.push(tradeGradeScores, frozenGradeRatio)
        array.push(tradeRankLabels, na)
        array.push(representedTradeCounts, representedTradeCount)

        // Capture the exact frozen trade levels for the optional commitment panel.
        // Qualification is intentionally separate from box creation. The panel may
        // qualify on the crossover candle or any later candle while this trade remains active.
        commitmentTradeActive := true
        commitmentPanelQualified := false
        commitmentTradeDirection := direction
        commitmentTradeStartBar := bar_index
        commitmentCrossBar := bar_index
        commitmentEntry := entryPrice
        commitmentSL := slPrice
        commitmentTP1 := tp1Price
        commitmentTP2 := tp2Price
        commitmentTP3 := tp3Price
        commitmentTP1Hit := false
        commitmentTP2Hit := false
        commitmentTP3Hit := false
        commitmentSLHit := false
        commitmentQuote := f_commitmentQuote(bar_index)

        runnerAssessmentActive := runnerModuleEnabled and not flipMirrorModeActive
        runnerAssessmentStarted := false
        runnerArmed := false
        runnerPreArmed := false
        while array.size(runnerPreviewTargetLines) > 0
            line.delete(array.pop(runnerPreviewTargetLines))
        while array.size(runnerPreviewTargetLabels) > 0
            label.delete(array.pop(runnerPreviewTargetLabels))
        runnerAssessDirection := direction
        runnerAssessStartBar := bar_index
        runnerAssessEntry := entryPrice
        runnerAssessATR := crossATR
        runnerAssessTP2 := tp2Price
        runnerAssessTP3 := tp3Price
        runnerAssessPeakATR := 0.0
        runnerContinuationProbability := na

        f_pruneTrades()
        f_refreshTradeVisibility()
        f_refreshTradeRankings()
        f_sendTradeBoxAlert(direction, entryPrice, tp1Price, tp2Price, tp3Price, slPrice, dpo, dpoLength, crossATR)

// Qualification remains armed for the full life of the active trade.
// It is measured from the frozen trade entry, making the panel independent of
// later movement in the DPO, EMA, or combined multi-engine baselines.
// LONG: price must reach Entry + X. SHORT: price must reach Entry - X.
// Once qualified, it stays latched while the associated stored trade box remains.
if commitmentTradeActive and not commitmentPanelQualified
    // Use the bar's actual favorable excursion, not only its close. Once the
    // configured entry-distance threshold is touched, varip latches qualification
    // across realtime tick rollback so the panel cannot flicker on/off intrabar.
    float qualificationMovePoints = commitmentTradeDirection == 1 ? high - commitmentEntry : commitmentEntry - low
    if qualificationMovePoints >= commitmentDPOThreshold
        commitmentPanelQualified := true

// In All Stored and both session-only modes, the hard storage cap still applies.
while array.size(tradeDirections) > effectiveMaxStoredBoxes
    f_deleteOldestTrade()

// Reapply non-destructive visibility and recalculate ranks after any deletion,
// overlap replacement, display-mode change, session change, or box extension.
f_refreshTradeVisibility()
f_refreshTradeRankings()

// ============================================================================
// DATA PANEL
// Show Data Panel is the visibility control. Once qualified, the panel stays
// continuously visible while its associated trade is unresolved, and is hidden
// as soon as TP3 or SL is touched. Pruning/removal clears stale panel state.
// ============================================================================
bool commitmentHasMatchingVisibleActiveBox = false
if commitmentTradeActive and array.size(tradeDirections) > 0
    for commitmentSyncIndex = 0 to array.size(tradeDirections) - 1
        bool commitmentSameStart = array.get(tradeStartBars, commitmentSyncIndex) == commitmentTradeStartBar
        bool commitmentSameDirection = array.get(tradeDirections, commitmentSyncIndex) == commitmentTradeDirection
        bool commitmentSameEntry = math.abs(array.get(tradeEntryPrices, commitmentSyncIndex) - commitmentEntry) <= syminfo.mintick
        bool commitmentStoredVisible = f_tradeIsVisible(commitmentSyncIndex)
        if commitmentSameStart and commitmentSameDirection and commitmentSameEntry and commitmentStoredVisible
            commitmentHasMatchingVisibleActiveBox := true
            break

// If the underlying stored box no longer exists, clear the stale panel latch.
// If it exists but is hidden by the current Boxes To Display mode, keep the
// latch alive but suppress the panel until that box is visible again.
bool commitmentHasMatchingStoredBox = false
if commitmentTradeActive and array.size(tradeDirections) > 0
    for commitmentStoredSyncIndex = 0 to array.size(tradeDirections) - 1
        bool commitmentStoredSameStart = array.get(tradeStartBars, commitmentStoredSyncIndex) == commitmentTradeStartBar
        bool commitmentStoredSameDirection = array.get(tradeDirections, commitmentStoredSyncIndex) == commitmentTradeDirection
        bool commitmentStoredSameEntry = math.abs(array.get(tradeEntryPrices, commitmentStoredSyncIndex) - commitmentEntry) <= syminfo.mintick
        if commitmentStoredSameStart and commitmentStoredSameDirection and commitmentStoredSameEntry
            commitmentHasMatchingStoredBox := true
            break

if commitmentTradeActive and not commitmentHasMatchingStoredBox
    commitmentTradeActive := false
    commitmentPanelQualified := false
    commitmentTP3Hit := false
    commitmentSLHit := false

var table commitmentPanel = table.new(f_commitmentPanelPosition(commitmentPanelPosition), 2, 15,
     bgcolor=color.new(color.black, 100), frame_color=color.new(color.white, 70), frame_width=2,
     border_color=color.new(color.white, 85), border_width=1, force_overlay=true)

f_renderDataPanel() =>
    if barstate.islast
        bool commitmentPanelVisible = dataPanelEnabled and commitmentTradeActive and commitmentPanelQualified and not commitmentTP3Hit and not commitmentSLHit and commitmentHasMatchingVisibleActiveBox
        if commitmentPanelVisible
            string commitmentDirectionText = commitmentTradeDirection == 1 ? "LONG" : "SHORT"
            color commitmentDirectionColor = commitmentTradeDirection == 1 ? color.new(color.green, 10) : color.new(color.red, 10)
            int barsInTrade = bar_index - commitmentTradeStartBar + 1
            bool tp1Reached = commitmentTP1Hit
            bool tp2Reached = commitmentTP2Hit
            string tp1Status = tp1Reached ? "  ✓ HIT" : "  • PENDING"
            string tp2Status = tp2Reached ? "  ✓ HIT" : "  • PENDING"
            string tp3Status = commitmentTP3Hit ? "  ✓ HIT" : "  • PENDING"
            string commitmentPanelStatus = commitmentSLHit ? "STOP TOUCHED" : commitmentTP3Hit ? "TP3 TOUCHED" : "ACTIVE"
            panelTS = f_commitmentTextSize(commitmentPanelSize)

            // Highlight only the value-side cell for the price section currently occupied.
            // Direction-normalized movement makes the same zone logic work for LONG and SHORT.
            float commitmentSignedMove = (close - commitmentEntry) * commitmentTradeDirection
            float commitmentSLDistance = math.abs(commitmentEntry - commitmentSL)
            float commitmentTP1Distance = math.abs(commitmentTP1 - commitmentEntry)
            float commitmentTP2Distance = math.abs(commitmentTP2 - commitmentEntry)
            float commitmentTP3Distance = math.abs(commitmentTP3 - commitmentEntry)
            bool priceInSLSection = commitmentSignedMove < 0.0 and commitmentSignedMove > -commitmentSLDistance
            bool priceInEntryTP1Section = commitmentSignedMove >= 0.0 and commitmentSignedMove < commitmentTP1Distance
            bool priceInTP1TP2Section = commitmentSignedMove >= commitmentTP1Distance and commitmentSignedMove < commitmentTP2Distance
            bool priceInTP2TP3Section = commitmentSignedMove >= commitmentTP2Distance and commitmentSignedMove < commitmentTP3Distance
            // Progressive visual language:
            //   Risk zone       = red
            //   Entry -> TP1    = blue (trade is working but no target is secured yet)
            //   TP1 -> TP2      = green
            //   TP2 -> TP3      = gold
            // Active zones are bright, completed zones remain softly marked, and future/inactive
            // zones stay muted so the current location is immediately obvious.
            color lightRiskColor = color.rgb(255, 170, 170)
            color lightEntryColor = color.rgb(150, 205, 255)
            color lightTP1Color = color.rgb(170, 240, 185)
            color lightTP2Color = color.rgb(255, 240, 175)
            color lightTP3Color = color.rgb(255, 205, 160)
            color slSectionBG = priceInSLSection ? color.new(lightRiskColor, 60) : color.new(lightRiskColor, 94)
            color tp1SectionBG = priceInEntryTP1Section ? color.new(lightEntryColor, 60) : tp1Reached ? color.new(lightTP1Color, 84) : color.new(lightEntryColor, 94)
            color tp2SectionBG = priceInTP1TP2Section ? color.new(lightTP1Color, 60) : tp2Reached ? color.new(lightTP1Color, 82) : color.new(lightTP1Color, 94)
            color tp3SectionBG = priceInTP2TP3Section ? color.new(lightTP2Color, 58) : color.new(lightTP3Color, 94)
            color tp3TextColor = priceInTP2TP3Section ? color.rgb(35, 35, 35) : color.white

            table.cell(commitmentPanel, 0, 0, "EXECUTION PANEL", text_color=color.white, bgcolor=color.new(color.navy, 0), text_size=panelTS, text_halign=text.align_center)
            table.cell(commitmentPanel, 1, 0, "MODE", text_color=color.white, bgcolor=color.new(color.navy, 0), text_size=panelTS, text_halign=text.align_center)
            table.cell(commitmentPanel, 0, 1, "Trade", text_color=color.white, text_size=panelTS, bgcolor=color.new(color.black, 100))
            table.cell(commitmentPanel, 1, 1, commitmentDirectionText, text_color=color.white, bgcolor=commitmentDirectionColor, text_size=panelTS)
            table.cell(commitmentPanel, 0, 2, "Status", text_color=color.white, text_size=panelTS, bgcolor=color.new(color.black, 100))
            table.cell(commitmentPanel, 1, 2, "ACTIVE", text_color=color.lime, text_size=panelTS, bgcolor=color.new(color.black, 100))
            table.cell(commitmentPanel, 0, 3, "Entry", text_color=color.white, text_size=panelTS, bgcolor=color.new(color.black, 100))
            table.cell(commitmentPanel, 1, 3, str.tostring(commitmentEntry, format.mintick), text_color=color.aqua, text_size=panelTS, bgcolor=color.new(color.black, 100))
            table.cell(commitmentPanel, 0, 4, "SL", text_color=color.white, text_size=panelTS, bgcolor=color.new(color.black, 100))
            table.cell(commitmentPanel, 1, 4, str.tostring(commitmentSL, format.mintick), text_color=color.red, bgcolor=slSectionBG, text_size=panelTS)
            table.cell(commitmentPanel, 0, 5, "TP1", text_color=color.white, text_size=panelTS, bgcolor=color.new(color.black, 100))
            table.cell(commitmentPanel, 1, 5, str.tostring(commitmentTP1, format.mintick) + tp1Status, text_color=tp1Reached ? color.lime : color.white, bgcolor=tp1SectionBG, text_size=panelTS)
            table.cell(commitmentPanel, 0, 6, "TP2", text_color=color.white, text_size=panelTS, bgcolor=color.new(color.black, 100))
            table.cell(commitmentPanel, 1, 6, str.tostring(commitmentTP2, format.mintick) + tp2Status, text_color=tp2Reached ? color.lime : color.white, bgcolor=tp2SectionBG, text_size=panelTS)
            table.cell(commitmentPanel, 0, 7, "TP3", text_color=color.white, text_size=panelTS, bgcolor=color.new(color.black, 100))
            table.cell(commitmentPanel, 1, 7, str.tostring(commitmentTP3, format.mintick) + tp3Status, text_color=tp3TextColor, bgcolor=tp3SectionBG, text_size=panelTS)
            table.cell(commitmentPanel, 0, 8, "Bars in Trade", text_color=color.white, text_size=panelTS, bgcolor=color.new(color.black, 100))
            table.cell(commitmentPanel, 1, 8, str.tostring(barsInTrade), text_color=color.yellow, text_size=panelTS, bgcolor=color.new(color.black, 100))

            // Live unrealized P&L measured strictly in price points, never currency.
            // LONG: current price minus entry. SHORT: entry minus current price.
            float commitmentPnLPoints = commitmentTradeDirection == 1 ? close - commitmentEntry : commitmentEntry - close
            string commitmentPnLText = (commitmentPnLPoints > 0 ? "+" : "") + str.tostring(commitmentPnLPoints, format.mintick) + " pts"
            color commitmentPnLColor = commitmentPnLPoints > 0 ? color.lime : commitmentPnLPoints < 0 ? color.red : color.silver
            table.cell(commitmentPanel, 0, 9, "P&L (Points)", text_color=color.white, text_size=panelTS, bgcolor=color.new(color.black, 100))
            table.cell(commitmentPanel, 1, 9, commitmentPnLText, text_color=commitmentPnLColor, text_size=panelTS, bgcolor=color.new(color.black, 100))
            // A successful trade is one that follows the success and risk rules defined before entry.
            table.cell(commitmentPanel, 0, 10, "", text_color=color.white, bgcolor=color.new(color.rgb(150, 205, 255), 86), text_size=panelTS, text_halign=text.align_center)
            table.cell(commitmentPanel, 1, 10, "", bgcolor=color.new(color.rgb(150, 205, 255), 86), text_size=panelTS)
            table.merge_cells(commitmentPanel, 0, 10, 1, 10)

            table.cell(commitmentPanel, 0, 11, "TP1 • TP2 • TP3", text_color=color.white, bgcolor=color.new(color.rgb(170, 240, 185), 88), text_size=panelTS, text_halign=text.align_center)
            table.cell(commitmentPanel, 1, 11, "EACH CAN DEFINE SUCCESS", text_color=color.white, bgcolor=color.new(color.rgb(170, 240, 185), 88), text_size=panelTS, text_halign=text.align_center)

            table.cell(commitmentPanel, 0, 12, "MY SUCCESS", text_color=color.white, bgcolor=color.new(color.rgb(150, 205, 255), 88), text_size=panelTS, text_halign=text.align_center)
            table.cell(commitmentPanel, 1, 12, successfulTradeDefinition, text_color=color.aqua, bgcolor=color.new(color.rgb(150, 205, 255), 88), text_size=panelTS, text_halign=text.align_center)

            table.cell(commitmentPanel, 0, 13, commitmentQuote, text_color=color.yellow, bgcolor=color.new(color.black, 0), text_size=panelTS, text_halign=text.align_center)
            table.cell(commitmentPanel, 1, 13, "", bgcolor=color.new(color.black, 0), text_size=panelTS)
            table.merge_cells(commitmentPanel, 0, 13, 1, 13)

            table.cell(commitmentPanel, 0, 14, "YOUR JOB", text_color=color.white, bgcolor=color.new(color.gray, 72), text_size=panelTS, text_halign=text.align_center)
            table.cell(commitmentPanel, 1, 14, "FOLLOW YOUR PREDEFINED EXIT PLAN", text_color=color.white, bgcolor=color.new(color.gray, 72), text_size=panelTS, text_halign=text.align_center)

        else
            table.clear(commitmentPanel, 0, 0, 1, 14)


f_renderDataPanel()
// ============================================================================
// OPTIONAL DAILY AND WEEKLY REPORT PANELS
// The daily report lists completed trades plus a currently active session trade.
// PM report prints at 09:00 and is dismissed at 09:27:30. NY/Weekly visibility
// follows the configured report schedule above, including weekend persistence.
// ============================================================================
reportTS = f_reportTextSize(reportTextSizeInput)
var table dailyReport = table.new(f_dashboardPosition(dailyReportPosition), 5, 33, bgcolor=color.new(color.black, 8), frame_color=color.new(color.silver, 45), frame_width=1, border_width=1)
var table weeklyReport = table.new(f_dashboardPosition(weeklyReportPosition), 7, 30, bgcolor=color.new(color.black, 8), frame_color=color.new(color.silver, 45), frame_width=1, border_width=1)

f_renderSessionReports() =>
    if barstate.islast
        // Always honor the independently selected report positions.
        table.set_position(dailyReport, f_dashboardPosition(dailyReportPosition))
        table.set_position(weeklyReport, f_dashboardPosition(weeklyReportPosition))
        table.clear(dailyReport, 0, 0, 4, 32)
        table.clear(weeklyReport, 0, 0, 6, 29)

        if showDailyReport and dailyReportVisible and not flipMirrorModeActive
            bool reportIsPM = dailyReportSessionType == 1
            int completedCount = reportIsPM ? array.size(pmReportDirections) : array.size(nyReportDirections)
            float reportCPL = reportIsPM ? pmSessionRealizedCPL : nySessionRealizedCPL
            int reportWins = reportIsPM ? pmSessionWins : nySessionWins
            int reportCompleted = reportIsPM ? pmSessionCompletedTrades : nySessionCompletedTrades
            string reportName = reportIsPM ? "PM SESSION REPORT" : "NY SESSION REPORT"
            float reportWinRate = reportCompleted > 0 ? float(reportWins) / float(reportCompleted) * 100.0 : na
            float reportGrossProfit = reportIsPM ? pmSessionGrossProfit : nySessionGrossProfit
            float reportHighestCPL = reportIsPM ? pmSessionHighestCPL : nySessionHighestCPL
            float reportLowestCPL = reportIsPM ? pmSessionLowestCPL : nySessionLowestCPL
            float reportGrossLoss = reportIsPM ? pmSessionGrossLoss : nySessionGrossLoss
            int reportLosses = reportCompleted - reportWins
            string reportProfitFactor = f_profitFactorText(reportGrossProfit, reportGrossLoss, reportCompleted)
            string reportAvgWinLoss = f_avgWinLossText(reportGrossProfit, reportGrossLoss, reportWins, reportLosses)
            color reportCPLColor = f_pnlColor(reportCPL)
            color reportWRColor = f_hitRateColor(reportWinRate)

            table.cell(dailyReport, 0, 0, reportName, text_color=color.white, bgcolor=color.navy, text_size=reportTS, text_halign=text.align_center)
            table.cell(dailyReport, 1, 0, "", bgcolor=color.navy, text_size=reportTS)
            table.cell(dailyReport, 2, 0, "", bgcolor=color.navy, text_size=reportTS)
            table.cell(dailyReport, 3, 0, "", bgcolor=color.navy, text_size=reportTS)
            table.cell(dailyReport, 4, 0, "", bgcolor=color.navy, text_size=reportTS)
            table.merge_cells(dailyReport, 0, 0, 4, 0)
            table.cell(dailyReport, 0, 1, "#", text_color=color.silver, text_size=reportTS)
            table.cell(dailyReport, 1, 1, "Type", text_color=color.silver, text_size=reportTS)
            table.cell(dailyReport, 2, 1, "Entry", text_color=color.silver, text_size=reportTS)
            table.cell(dailyReport, 3, 1, "Exit", text_color=color.silver, text_size=reportTS)
            table.cell(dailyReport, 4, 1, "P&L", text_color=color.silver, text_size=reportTS)

            int listedCompleted = math.min(completedCount, maxTradesInDailyReport)
            if listedCompleted > 0
                for r = 0 to listedCompleted - 1
                    int direction = reportIsPM ? array.get(pmReportDirections, r) : array.get(nyReportDirections, r)
                    float entry = reportIsPM ? array.get(pmReportEntries, r) : array.get(nyReportEntries, r)
                    float exitPrice = reportIsPM ? array.get(pmReportExits, r) : array.get(nyReportExits, r)
                    string outcome = reportIsPM ? array.get(pmReportOutcomes, r) : array.get(nyReportOutcomes, r)
                    float pnl = reportIsPM ? array.get(pmReportPnL, r) : array.get(nyReportPnL, r)
                    int row = r + 2
                    table.cell(dailyReport, 0, row, str.tostring(r), text_color=color.white, text_size=reportTS)
                    table.cell(dailyReport, 1, row, direction == 1 ? "LONG" : "SHORT", text_color=direction == 1 ? color.lime : color.red, text_size=reportTS)
                    table.cell(dailyReport, 2, row, str.tostring(entry, format.mintick), text_color=color.white, text_size=reportTS)
                    table.cell(dailyReport, 3, row, outcome + " " + str.tostring(exitPrice, format.mintick), text_color=outcome == "TP3" ? color.lime : color.red, text_size=reportTS)
                    table.cell(dailyReport, 4, row, f_signedPoints(pnl), text_color=f_pnlColor(pnl), text_size=reportTS)

            // Include the still-active trade, when any, as a live row. Once resolved,
            // it moves into the completed ledger automatically.
            bool reportHasLiveTrade = false
            int liveDirection = 0
            float liveEntry = na
            float livePnL = na
            if array.size(tradeDirections) > 0
                for i = 0 to array.size(tradeDirections) - 1
                    if array.get(tradeActive, i) and array.get(tradeSessionTypes, i) == dailyReportSessionType
                        reportHasLiveTrade := true
                        liveDirection := array.get(tradeDirections, i)
                        liveEntry := array.get(tradeEntryPrices, i)
                        livePnL := liveDirection == 1 ? close - liveEntry : liveEntry - close
            int nextRow = listedCompleted + 2
            if reportHasLiveTrade and listedCompleted < maxTradesInDailyReport
                table.cell(dailyReport, 0, nextRow, str.tostring(completedCount), text_color=color.yellow, text_size=reportTS)
                table.cell(dailyReport, 1, nextRow, liveDirection == 1 ? "LONG" : "SHORT", text_color=liveDirection == 1 ? color.lime : color.red, text_size=reportTS)
                table.cell(dailyReport, 2, nextRow, str.tostring(liveEntry, format.mintick), text_color=color.white, text_size=reportTS)
                table.cell(dailyReport, 3, nextRow, "ACTIVE", text_color=color.yellow, text_size=reportTS)
                table.cell(dailyReport, 4, nextRow, f_signedPoints(livePnL), text_color=f_pnlColor(livePnL), text_size=reportTS)
                nextRow += 1

            int omitted = completedCount - listedCompleted
            if omitted > 0
                table.cell(dailyReport, 0, nextRow, "+" + str.tostring(omitted) + " more trades not shown", text_color=color.silver, text_size=reportTS, text_halign=text.align_center)
                table.cell(dailyReport, 1, nextRow, "", text_size=reportTS)
                table.cell(dailyReport, 2, nextRow, "", text_size=reportTS)
                table.cell(dailyReport, 3, nextRow, "", text_size=reportTS)
                table.cell(dailyReport, 4, nextRow, "", text_size=reportTS)
                table.merge_cells(dailyReport, 0, nextRow, 4, nextRow)
                nextRow += 1

            int summaryRow = math.min(nextRow, 28)
            table.cell(dailyReport, 0, summaryRow, "Session Net CP&L", text_color=color.white, bgcolor=color.new(color.gray, 75), text_size=reportTS)
            table.cell(dailyReport, 1, summaryRow, f_signedPointsOrNA(reportCPL, reportCompleted), text_color=reportCompleted > 0 ? reportCPLColor : color.silver, bgcolor=color.new(color.gray, 75), text_size=reportTS)
            table.cell(dailyReport, 2, summaryRow, "TP3 Hit %", text_color=color.white, bgcolor=color.new(color.gray, 75), text_size=reportTS)
            table.cell(dailyReport, 3, summaryRow, na(reportWinRate) ? "N/A" : str.tostring(reportWinRate, "#.0") + "%", text_color=reportWRColor, bgcolor=color.new(color.gray, 75), text_size=reportTS)
            table.cell(dailyReport, 4, summaryRow, str.tostring(reportWins) + "/" + str.tostring(reportCompleted), text_color=reportWRColor, bgcolor=color.new(color.gray, 75), text_size=reportTS)

            table.cell(dailyReport, 0, summaryRow + 1, "Profit Factor", text_color=color.white, text_size=reportTS)
            table.cell(dailyReport, 1, summaryRow + 1, reportProfitFactor, text_color=reportProfitFactor == "N/A" ? color.silver : color.aqua, text_size=reportTS)
            table.cell(dailyReport, 2, summaryRow + 1, "Avg Win / Loss", text_color=color.white, text_size=reportTS)
            table.cell(dailyReport, 3, summaryRow + 1, reportAvgWinLoss, text_color=color.white, text_size=reportTS)
            table.cell(dailyReport, 4, summaryRow + 1, str.tostring(reportWins) + "W / " + str.tostring(reportLosses) + "L", text_color=color.white, text_size=reportTS)

            table.cell(dailyReport, 0, summaryRow + 2, "Gross Profit / Loss", text_color=color.white, text_size=reportTS)
            table.cell(dailyReport, 1, summaryRow + 2, reportCompleted > 0 ? "+" + str.tostring(reportGrossProfit, format.mintick) + " / -" + str.tostring(reportGrossLoss, format.mintick) + " pts" : "N/A", text_color=reportCompleted > 0 ? color.white : color.silver, text_size=reportTS)
            table.cell(dailyReport, 2, summaryRow + 2, "", text_size=reportTS)
            table.cell(dailyReport, 3, summaryRow + 2, "", text_size=reportTS)
            table.cell(dailyReport, 4, summaryRow + 2, "", text_size=reportTS)

            table.cell(dailyReport, 0, summaryRow + 3, "Highest CP&L", text_color=color.white, text_size=reportTS)
            table.cell(dailyReport, 1, summaryRow + 3, f_signedPointsOrNA(reportHighestCPL, reportCompleted), text_color=reportCompleted > 0 ? f_pnlColor(reportHighestCPL) : color.silver, text_size=reportTS)
            table.cell(dailyReport, 2, summaryRow + 3, "", text_size=reportTS)
            table.cell(dailyReport, 3, summaryRow + 3, "", text_size=reportTS)
            table.cell(dailyReport, 4, summaryRow + 3, "", text_size=reportTS)

            table.cell(dailyReport, 0, summaryRow + 4, "Lowest CP&L", text_color=color.white, text_size=reportTS)
            table.cell(dailyReport, 1, summaryRow + 4, f_signedPointsOrNA(reportLowestCPL, reportCompleted), text_color=reportCompleted > 0 ? f_pnlColor(reportLowestCPL) : color.silver, text_size=reportTS)
            table.cell(dailyReport, 2, summaryRow + 4, "Session Range", text_color=color.white, text_size=reportTS)
            float reportSessionHighPrice = reportIsPM ? pmSessionHighPrice : nySessionHighPrice
            float reportSessionLowPrice = reportIsPM ? pmSessionLowPrice : nySessionLowPrice
            float reportSessionRange = not na(reportSessionHighPrice) and not na(reportSessionLowPrice) ? reportSessionHighPrice - reportSessionLowPrice : na
            table.cell(dailyReport, 3, summaryRow + 4, not na(reportSessionRange) ? str.tostring(reportSessionRange, format.mintick) + " pts" : "N/A", text_color=not na(reportSessionRange) ? color.aqua : color.silver, text_size=reportTS)
            table.cell(dailyReport, 4, summaryRow + 4, "", text_size=reportTS)

        if showWeeklyReport and weeklyReportVisible and not flipMirrorModeActive
            // Friday's current trading day is inserted into the weekly breakdown
            // without prematurely closing or resetting the active session.
            float liveWeekTP1Rate = weeklyCompleted > 0 ? float(weeklyTP1Wins) / float(weeklyCompleted) * 100.0 : na
            float liveWeekTP2Rate = weeklyCompleted > 0 ? float(weeklyTP2Wins) / float(weeklyCompleted) * 100.0 : na
            float liveWeekWinRate = weeklyCompleted > 0 ? float(weeklyWins) / float(weeklyCompleted) * 100.0 : na
            float currentDayWinRate = currentDayCompleted > 0 ? float(currentDayWins) / float(currentDayCompleted) * 100.0 : na
            float displayedBestDailyCPL = bestDailyCPL
            float displayedBestDailyWR = bestDailyWinRate
            string displayedBestCPLName = bestDailyCPLName
            string displayedBestWRName = bestDailyWinRateName
            if currentDayCompleted > 0
                if na(displayedBestDailyCPL) or currentDayCPL > displayedBestDailyCPL
                    displayedBestDailyCPL := currentDayCPL
                    displayedBestCPLName := "Friday"
                if na(displayedBestDailyWR) or (not na(currentDayWinRate) and currentDayWinRate > displayedBestDailyWR)
                    displayedBestDailyWR := currentDayWinRate
                    displayedBestWRName := "Friday"
            float avgTradePoints = weeklyCompleted > 0 ? weeklyCPL / float(weeklyCompleted) : na
            int weeklyLosses = weeklyCompleted - weeklyWins

            // Friday's Weekly Report is generated while Friday NY is still active.
            // PM metrics are already finalized. NY gets the active Friday NY
            // session provisionally added so its weekly average is current.
            float displayedWeeklyPMHighestCPLSum = weeklyPMHighestCPLSum
            float displayedWeeklyPMLowestCPLSum = weeklyPMLowestCPLSum
            int displayedWeeklyPMSessionMetricCount = weeklyPMSessionMetricCount

            float displayedWeeklyNYHighestCPLSum = weeklyNYHighestCPLSum
            float displayedWeeklyNYLowestCPLSum = weeklyNYLowestCPLSum
            int displayedWeeklyNYSessionMetricCount = weeklyNYSessionMetricCount
            if inNYSession and nySessionCompletedTrades > 0
                displayedWeeklyNYHighestCPLSum += nySessionHighestCPL
                displayedWeeklyNYLowestCPLSum += nySessionLowestCPL
                displayedWeeklyNYSessionMetricCount += 1

            float weeklyPMAvgHighestCPL = displayedWeeklyPMSessionMetricCount > 0 ? displayedWeeklyPMHighestCPLSum / float(displayedWeeklyPMSessionMetricCount) : na
            float weeklyPMAvgLowestCPL = displayedWeeklyPMSessionMetricCount > 0 ? displayedWeeklyPMLowestCPLSum / float(displayedWeeklyPMSessionMetricCount) : na

            float weeklyNYAvgHighestCPL = displayedWeeklyNYSessionMetricCount > 0 ? displayedWeeklyNYHighestCPLSum / float(displayedWeeklyNYSessionMetricCount) : na
            float weeklyNYAvgLowestCPL = displayedWeeklyNYSessionMetricCount > 0 ? displayedWeeklyNYLowestCPLSum / float(displayedWeeklyNYSessionMetricCount) : na

            string weeklyProfitFactorText = f_profitFactorText(weeklyGrossProfit, weeklyGrossLoss, weeklyCompleted)
            string weeklyAvgWinLossText = f_avgWinLossText(weeklyGrossProfit, weeklyGrossLoss, weeklyWins, weeklyLosses)
            string weeklyPMProfitFactorText = f_profitFactorText(weeklyPMGrossProfit, weeklyPMGrossLoss, weeklyPMCompleted)
            string weeklyNYProfitFactorText = f_profitFactorText(weeklyNYGrossProfit, weeklyNYGrossLoss, weeklyNYCompleted)
            float weeklyPMWinRate = weeklyPMCompleted > 0 ? float(weeklyPMWins) / float(weeklyPMCompleted) * 100.0 : na
            float weeklyNYWinRate = weeklyNYCompleted > 0 ? float(weeklyNYWins) / float(weeklyNYCompleted) * 100.0 : na

            // Report-only accounting invariants. All three should stay true
            // because NY and PM are the only sessions admitted to weekly totals.
            float reportAuditTolerance = math.max(syminfo.mintick * 0.01, 0.0000001)
            bool weeklyCPLReconciles = math.abs(weeklyCPL - (weeklyNYCPL + weeklyPMCPL)) <= reportAuditTolerance
            bool weeklyTradeCountReconciles = weeklyCompleted == weeklyNYCompleted + weeklyPMCompleted
            bool weeklyWinCountReconciles = weeklyWins == weeklyNYWins + weeklyPMWins

            color weeklyCPLColor = f_pnlColor(weeklyCPL)
            color weeklyWRColor = f_hitRateColor(liveWeekWinRate)

            table.cell(weeklyReport, 0, 0, "WEEKLY REPORT", text_color=color.white, bgcolor=color.navy, text_size=reportTS)
            table.cell(weeklyReport, 1, 0, "", bgcolor=color.navy, text_size=reportTS)
            table.cell(weeklyReport, 2, 0, "", bgcolor=color.navy, text_size=reportTS)
            table.cell(weeklyReport, 3, 0, "", bgcolor=color.navy, text_size=reportTS)
            table.cell(weeklyReport, 4, 0, "", bgcolor=color.navy, text_size=reportTS)
            table.cell(weeklyReport, 5, 0, "", bgcolor=color.navy, text_size=reportTS)
            table.cell(weeklyReport, 6, 0, "", bgcolor=color.navy, text_size=reportTS)
            table.merge_cells(weeklyReport, 0, 0, 6, 0)

            table.cell(weeklyReport, 0, 1, "Day", text_color=color.silver, bgcolor=color.new(color.gray, 75), text_size=reportTS)
            table.cell(weeklyReport, 1, 1, "PM CP&L", text_color=color.silver, bgcolor=color.new(color.gray, 75), text_size=reportTS)
            table.cell(weeklyReport, 2, 1, "PM Range", text_color=color.silver, bgcolor=color.new(color.gray, 75), text_size=reportTS)
            table.cell(weeklyReport, 3, 1, "NY CP&L", text_color=color.silver, bgcolor=color.new(color.gray, 75), text_size=reportTS)
            table.cell(weeklyReport, 4, 1, "NY Range", text_color=color.silver, bgcolor=color.new(color.gray, 75), text_size=reportTS)
            table.cell(weeklyReport, 5, 1, "Total CP&L", text_color=color.silver, bgcolor=color.new(color.gray, 75), text_size=reportTS)
            table.cell(weeklyReport, 6, 1, "TP3 Hit %", text_color=color.silver, bgcolor=color.new(color.gray, 75), text_size=reportTS)

            for dayIndex = 0 to 4
                float dayCPL = array.get(weeklyDailyCPL, dayIndex)
                float dayPMCPL = array.get(weeklyDailyPMCPL, dayIndex)
                float dayNYCPL = array.get(weeklyDailyNYCPL, dayIndex)
                float dayPMRange = array.get(weeklyDailyPMRange, dayIndex)
                float storedDayNYRange = array.get(weeklyDailyNYRange, dayIndex)
                // Friday's NY session is still in progress when the Weekly Report
                // becomes eligible, so show its live high-low range provisionally.
                float liveCurrentNYRange = not na(nySessionHighPrice) and not na(nySessionLowPrice) ? nySessionHighPrice - nySessionLowPrice : na
                float dayNYRange = dayIndex == 4 and inNYSession ? liveCurrentNYRange : storedDayNYRange
                int dayWins = array.get(weeklyDailyWins, dayIndex)
                int dayCompleted = array.get(weeklyDailyCompleted, dayIndex)
                float dayWinRate = dayCompleted > 0 ? float(dayWins) / float(dayCompleted) * 100.0 : na

                string pmText = na(dayPMCPL) ? "N/A" : f_signedPoints(dayPMCPL)
                string pmRangeText = na(dayPMRange) ? "N/A" : str.tostring(dayPMRange, format.mintick) + " pts"
                string nyText = na(dayNYCPL) ? "N/A" : f_signedPoints(dayNYCPL)
                string nyRangeText = na(dayNYRange) ? "N/A" : str.tostring(dayNYRange, format.mintick) + " pts"
                string totalText = na(dayCPL) ? "N/A" : f_signedPoints(dayCPL)
                string winText = na(dayWinRate) ? "N/A" : str.tostring(dayWinRate, "#.0") + "%"

                color pmColor = na(dayPMCPL) ? color.silver : f_pnlColor(dayPMCPL)
                color pmRangeColor = na(dayPMRange) ? color.silver : color.aqua
                color nyColor = na(dayNYCPL) ? color.silver : f_pnlColor(dayNYCPL)
                color nyRangeColor = na(dayNYRange) ? color.silver : color.aqua
                color totalColor = na(dayCPL) ? color.silver : f_pnlColor(dayCPL)
                color dayWinColor = f_hitRateColor(dayWinRate)

                int dayRow = dayIndex + 2
                table.cell(weeklyReport, 0, dayRow, f_weekdayName(dayIndex), text_color=color.white, text_size=reportTS)
                table.cell(weeklyReport, 1, dayRow, pmText, text_color=pmColor, text_size=reportTS)
                table.cell(weeklyReport, 2, dayRow, pmRangeText, text_color=pmRangeColor, text_size=reportTS)
                table.cell(weeklyReport, 3, dayRow, nyText, text_color=nyColor, text_size=reportTS)
                table.cell(weeklyReport, 4, dayRow, nyRangeText, text_color=nyRangeColor, text_size=reportTS)
                table.cell(weeklyReport, 5, dayRow, totalText, text_color=totalColor, text_size=reportTS)
                table.cell(weeklyReport, 6, dayRow, winText, text_color=dayWinColor, text_size=reportTS)

            table.cell(weeklyReport, 0, 7, "Week Net CP&L", text_color=color.white, bgcolor=color.new(color.gray, 75), text_size=reportTS)
            string weeklyNetDisplay = weeklyCompleted == 0 ? "N/A" : weeklyCPLReconciles and weeklyTradeCountReconciles and weeklyWinCountReconciles ? f_signedPoints(weeklyCPL) : "AUDIT ERROR"
            color weeklyNetDisplayColor = weeklyCompleted == 0 ? color.silver : weeklyCPLReconciles and weeklyTradeCountReconciles and weeklyWinCountReconciles ? weeklyCPLColor : color.red
            table.cell(weeklyReport, 1, 7, weeklyNetDisplay, text_color=weeklyNetDisplayColor, bgcolor=color.new(color.gray, 75), text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 7, 6, 7)
            table.cell(weeklyReport, 0, 8, "TP1 Hit %", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 8, na(liveWeekTP1Rate) ? "N/A" : str.tostring(liveWeekTP1Rate, "#.0") + "% (" + str.tostring(weeklyTP1Wins) + "/" + str.tostring(weeklyCompleted) + ")", text_color=f_hitRateColor(liveWeekTP1Rate), text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 8, 2, 8)
            table.cell(weeklyReport, 3, 8, "CP&L", text_color=color.silver, text_size=reportTS)
            table.cell(weeklyReport, 4, 8, f_signedPointsOrNA(weeklyTP1CPL, weeklyCompleted), text_color=weeklyCompleted > 0 ? f_pnlColor(weeklyTP1CPL) : color.silver, text_size=reportTS)

            table.cell(weeklyReport, 0, 9, "TP2 Hit %", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 9, na(liveWeekTP2Rate) ? "N/A" : str.tostring(liveWeekTP2Rate, "#.0") + "% (" + str.tostring(weeklyTP2Wins) + "/" + str.tostring(weeklyCompleted) + ")", text_color=f_hitRateColor(liveWeekTP2Rate), text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 9, 2, 9)
            table.cell(weeklyReport, 3, 9, "CP&L", text_color=color.silver, text_size=reportTS)
            table.cell(weeklyReport, 4, 9, f_signedPointsOrNA(weeklyTP2CPL, weeklyCompleted), text_color=weeklyCompleted > 0 ? f_pnlColor(weeklyTP2CPL) : color.silver, text_size=reportTS)
            table.cell(weeklyReport, 0, 10, "TP3 Hit %", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 10, na(liveWeekWinRate) ? "N/A" : str.tostring(liveWeekWinRate, "#.0") + "% (" + str.tostring(weeklyWins) + "/" + str.tostring(weeklyCompleted) + ")", text_color=weeklyWRColor, text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 10, 6, 10)
            table.cell(weeklyReport, 0, 11, "TP3 Wins / Losses", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 11, str.tostring(weeklyWins) + " / " + str.tostring(weeklyLosses), text_color=color.white, text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 11, 6, 11)
            table.cell(weeklyReport, 0, 12, "Avg Trade", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 12, na(avgTradePoints) ? "N/A" : f_signedPoints(avgTradePoints), text_color=na(avgTradePoints) ? color.silver : f_pnlColor(avgTradePoints), text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 12, 6, 12)
            table.cell(weeklyReport, 0, 13, "Best Daily Net CP&L", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 13, na(displayedBestDailyCPL) ? "N/A" : displayedBestCPLName + " | " + f_signedPoints(displayedBestDailyCPL), text_color=na(displayedBestDailyCPL) ? color.silver : f_pnlColor(displayedBestDailyCPL), text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 13, 6, 13)
            table.cell(weeklyReport, 0, 14, "Best Daily TP3 Hit %", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 14, na(displayedBestDailyWR) ? "N/A" : displayedBestWRName + " | " + str.tostring(displayedBestDailyWR, "#.0") + "%", text_color=f_hitRateColor(displayedBestDailyWR), text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 14, 6, 14)
            table.cell(weeklyReport, 0, 15, "Completed Trades", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 15, str.tostring(weeklyCompleted), text_color=color.white, text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 15, 6, 15)

            table.cell(weeklyReport, 0, 16, "Week Profit Factor", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 16, weeklyProfitFactorText, text_color=weeklyProfitFactorText == "N/A" ? color.silver : color.aqua, text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 16, 6, 16)
            table.cell(weeklyReport, 0, 17, "Week Avg Win / Loss", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 17, weeklyAvgWinLossText, text_color=color.white, text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 17, 6, 17)

            table.cell(weeklyReport, 0, 18, "NY avg H-CP&L", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 18, na(weeklyNYAvgHighestCPL) ? "N/A" : f_signedPoints(weeklyNYAvgHighestCPL), text_color=na(weeklyNYAvgHighestCPL) ? color.silver : f_pnlColor(weeklyNYAvgHighestCPL), text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 18, 2, 18)
            table.cell(weeklyReport, 3, 18, "NY avg L-CP&L", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 4, 18, na(weeklyNYAvgLowestCPL) ? "N/A" : f_signedPoints(weeklyNYAvgLowestCPL), text_color=na(weeklyNYAvgLowestCPL) ? color.silver : f_pnlColor(weeklyNYAvgLowestCPL), text_size=reportTS)

            table.cell(weeklyReport, 0, 19, "PM avg H-CP&L", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 19, na(weeklyPMAvgHighestCPL) ? "N/A" : f_signedPoints(weeklyPMAvgHighestCPL), text_color=na(weeklyPMAvgHighestCPL) ? color.silver : f_pnlColor(weeklyPMAvgHighestCPL), text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 19, 2, 19)
            table.cell(weeklyReport, 3, 19, "PM avg L-CP&L", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 4, 19, na(weeklyPMAvgLowestCPL) ? "N/A" : f_signedPoints(weeklyPMAvgLowestCPL), text_color=na(weeklyPMAvgLowestCPL) ? color.silver : f_pnlColor(weeklyPMAvgLowestCPL), text_size=reportTS)

            table.cell(weeklyReport, 0, 20, "SESSION COMPARISON", text_color=color.white, bgcolor=color.new(color.navy, 35), text_size=reportTS)
            table.cell(weeklyReport, 1, 20, "", bgcolor=color.new(color.navy, 35), text_size=reportTS)
            table.cell(weeklyReport, 2, 20, "", bgcolor=color.new(color.navy, 35), text_size=reportTS)
            table.cell(weeklyReport, 3, 20, "", bgcolor=color.new(color.navy, 35), text_size=reportTS)
            table.cell(weeklyReport, 4, 20, "", bgcolor=color.new(color.navy, 35), text_size=reportTS)
            table.merge_cells(weeklyReport, 0, 20, 6, 20)

            table.cell(weeklyReport, 0, 21, "NY Net CP&L", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 21, f_signedPointsOrNA(weeklyNYCPL, weeklyNYCompleted), text_color=weeklyNYCompleted > 0 ? f_pnlColor(weeklyNYCPL) : color.silver, text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 21, 6, 21)
            table.cell(weeklyReport, 0, 22, "NY TP3 Hit %", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 22, na(weeklyNYWinRate) ? "N/A" : str.tostring(weeklyNYWinRate, "#.0") + "% (" + str.tostring(weeklyNYWins) + "/" + str.tostring(weeklyNYCompleted) + ")", text_color=f_hitRateColor(weeklyNYWinRate), text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 22, 6, 22)
            table.cell(weeklyReport, 0, 23, "NY Profit Factor", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 23, weeklyNYProfitFactorText, text_color=weeklyNYProfitFactorText == "N/A" ? color.silver : color.aqua, text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 23, 6, 23)

            table.cell(weeklyReport, 0, 24, "PM Net CP&L", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 24, f_signedPointsOrNA(weeklyPMCPL, weeklyPMCompleted), text_color=weeklyPMCompleted > 0 ? f_pnlColor(weeklyPMCPL) : color.silver, text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 24, 6, 24)
            table.cell(weeklyReport, 0, 25, "PM TP3 Hit %", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 25, na(weeklyPMWinRate) ? "N/A" : str.tostring(weeklyPMWinRate, "#.0") + "% (" + str.tostring(weeklyPMWins) + "/" + str.tostring(weeklyPMCompleted) + ")", text_color=f_hitRateColor(weeklyPMWinRate), text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 25, 6, 25)
            table.cell(weeklyReport, 0, 26, "PM Profit Factor", text_color=color.white, text_size=reportTS)
            table.cell(weeklyReport, 1, 26, weeklyPMProfitFactorText, text_color=weeklyPMProfitFactorText == "N/A" ? color.silver : color.aqua, text_size=reportTS)
            table.merge_cells(weeklyReport, 1, 26, 6, 26)


f_renderSessionReports()
// ============================================================================
// BACKTEST REPORT
// NY/PM scopes read the exact same session accumulators used by the Dashboard.
// Trading Day and All Loaded History use running totals from the same completion event.
// Visual box storage, pruning, and overlap removal cannot change BackTest accounting.
// ============================================================================
backtestTS = f_reportTextSize(backtestReportTextSize)
var table backtestReport = table.new(f_dashboardPosition(backtestReportPosition), 2, 13,
     bgcolor=color.new(color.black, 8), frame_color=color.new(color.aqua, 45), frame_width=1, border_width=1)

f_renderBacktestReport() =>
    if barstate.islast
        table.clear(backtestReport, 0, 0, 1, 12)

        if backtestReplayEnabled and not flipMirrorModeActive
            int btCompleted = 0
            int btTP1Wins = 0
            int btTP2Wins = 0
            int btTP3Wins = 0
            float btTP1CPL = 0.0
            float btTP2CPL = 0.0
            float btTP3CPL = 0.0
            float btGrossProfit = 0.0
            float btGrossLoss = 0.0

            if backtestScope == "Current NY Session"
                btCompleted := nySessionCompletedTrades
                btTP1Wins := nySessionTP1Wins
                btTP2Wins := nySessionTP2Wins
                btTP3Wins := nySessionWins
                btTP1CPL := nySessionTP1CPL
                btTP2CPL := nySessionTP2CPL
                btTP3CPL := nySessionTP3CPL
                btGrossProfit := nySessionGrossProfit
                btGrossLoss := nySessionGrossLoss
            else if backtestScope == "Current PM Session"
                btCompleted := pmSessionCompletedTrades
                btTP1Wins := pmSessionTP1Wins
                btTP2Wins := pmSessionTP2Wins
                btTP3Wins := pmSessionWins
                btTP1CPL := pmSessionTP1CPL
                btTP2CPL := pmSessionTP2CPL
                btTP3CPL := pmSessionTP3CPL
                btGrossProfit := pmSessionGrossProfit
                btGrossLoss := pmSessionGrossLoss
            else if backtestScope == "Current Trading Day"
                btCompleted := btDayCompleted
                btTP1Wins := btDayTP1Wins
                btTP2Wins := btDayTP2Wins
                btTP3Wins := btDayTP3Wins
                btTP1CPL := btDayTP1CPL
                btTP2CPL := btDayTP2CPL
                btTP3CPL := btDayTP3CPL
                btGrossProfit := btDayGrossProfit
                btGrossLoss := btDayGrossLoss
            else if backtestScope == "Current Week"
                btCompleted := btWeekCompleted
                btTP1Wins := btWeekTP1Wins
                btTP2Wins := btWeekTP2Wins
                btTP3Wins := btWeekTP3Wins
                btTP1CPL := btWeekTP1CPL
                btTP2CPL := btWeekTP2CPL
                btTP3CPL := btWeekTP3CPL
                btGrossProfit := btWeekGrossProfit
                btGrossLoss := btWeekGrossLoss
            else if backtestScope == "Custom Number of Boxes"
                int btLedgerSize = array.size(btCustomRealized)
                int btCustomSample = math.min(backtestCustomBoxCount, btLedgerSize)
                btCompleted := btCustomSample
                if btCustomSample > 0
                    int btCustomStart = btLedgerSize - btCustomSample
                    for btCustomIndex = btCustomStart to btLedgerSize - 1
                        float btCustomRealizedPnL = array.get(btCustomRealized, btCustomIndex)
                        float btCustomTP1TradePnL = array.get(btCustomTP1PnL, btCustomIndex)
                        float btCustomTP2TradePnL = array.get(btCustomTP2PnL, btCustomIndex)
                        float btCustomTP3TradePnL = array.get(btCustomTP3PnL, btCustomIndex)
                        btTP1CPL += btCustomTP1TradePnL
                        btTP2CPL += btCustomTP2TradePnL
                        btTP3CPL += btCustomTP3TradePnL
                        if array.get(btCustomTP1Hits, btCustomIndex)
                            btTP1Wins += 1
                        if array.get(btCustomTP2Hits, btCustomIndex)
                            btTP2Wins += 1
                        if array.get(btCustomTP3Hits, btCustomIndex)
                            btTP3Wins += 1
                        if btCustomRealizedPnL > 0
                            btGrossProfit += btCustomRealizedPnL
                        else if btCustomRealizedPnL < 0
                            btGrossLoss += math.abs(btCustomRealizedPnL)
            else
                btCompleted := btAllCompleted
                btTP1Wins := btAllTP1Wins
                btTP2Wins := btAllTP2Wins
                btTP3Wins := btAllTP3Wins
                btTP1CPL := btAllTP1CPL
                btTP2CPL := btAllTP2CPL
                btTP3CPL := btAllTP3CPL
                btGrossProfit := btAllGrossProfit
                btGrossLoss := btAllGrossLoss

            int btLosses = btCompleted - btTP3Wins
            float btTP1HitRate = btCompleted > 0 ? float(btTP1Wins) / float(btCompleted) * 100.0 : na
            float btTP2HitRate = btCompleted > 0 ? float(btTP2Wins) / float(btCompleted) * 100.0 : na
            float btTP3HitRate = btCompleted > 0 ? float(btTP3Wins) / float(btCompleted) * 100.0 : na
            float btExpectancy = btCompleted > 0 ? btTP3CPL / float(btCompleted) : na
            string btProfitFactor = f_profitFactorText(btGrossProfit, btGrossLoss, btCompleted)
            string btAvgWinLoss = f_avgWinLossText(btGrossProfit, btGrossLoss, btTP3Wins, btLosses)

            table.cell(backtestReport, 0, 0, "BACKTEST REPORT", text_color=color.white, bgcolor=color.navy, text_size=backtestTS, text_halign=text.align_center)
            table.cell(backtestReport, 1, 0, "", bgcolor=color.navy, text_size=backtestTS)
            table.merge_cells(backtestReport, 0, 0, 1, 0)

            table.cell(backtestReport, 0, 1, "Completed Trades", text_color=color.white, text_size=backtestTS)
            table.cell(backtestReport, 1, 1, str.tostring(btCompleted), text_color=color.aqua, text_size=backtestTS)

            table.cell(backtestReport, 0, 2, "TP1 CP&L", text_color=color.white, text_size=backtestTS)
            table.cell(backtestReport, 1, 2, f_signedPoints(btTP1CPL), text_color=f_pnlColor(btTP1CPL), text_size=backtestTS)

            table.cell(backtestReport, 0, 3, "TP1 Hit %", text_color=color.white, text_size=backtestTS)
            table.cell(backtestReport, 1, 3, na(btTP1HitRate) ? "N/A" : str.tostring(btTP1HitRate, "#.0") + "% (" + str.tostring(btTP1Wins) + "/" + str.tostring(btCompleted) + ")", text_color=f_hitRateColor(btTP1HitRate), text_size=backtestTS)

            table.cell(backtestReport, 0, 4, "TP2 CP&L", text_color=color.white, text_size=backtestTS)
            table.cell(backtestReport, 1, 4, f_signedPoints(btTP2CPL), text_color=f_pnlColor(btTP2CPL), text_size=backtestTS)

            table.cell(backtestReport, 0, 5, "TP2 Hit %", text_color=color.white, text_size=backtestTS)
            table.cell(backtestReport, 1, 5, na(btTP2HitRate) ? "N/A" : str.tostring(btTP2HitRate, "#.0") + "% (" + str.tostring(btTP2Wins) + "/" + str.tostring(btCompleted) + ")", text_color=f_hitRateColor(btTP2HitRate), text_size=backtestTS)

            table.cell(backtestReport, 0, 6, "TP3 CP&L", text_color=color.white, text_size=backtestTS)
            table.cell(backtestReport, 1, 6, f_signedPoints(btTP3CPL), text_color=f_pnlColor(btTP3CPL), text_size=backtestTS)

            table.cell(backtestReport, 0, 7, "TP3 Hit %", text_color=color.white, text_size=backtestTS)
            table.cell(backtestReport, 1, 7, na(btTP3HitRate) ? "N/A" : str.tostring(btTP3HitRate, "#.0") + "% (" + str.tostring(btTP3Wins) + "/" + str.tostring(btCompleted) + ")", text_color=f_hitRateColor(btTP3HitRate), text_size=backtestTS)

            table.cell(backtestReport, 0, 8, "Profit Factor", text_color=color.white, text_size=backtestTS)
            table.cell(backtestReport, 1, 8, btProfitFactor, text_color=btProfitFactor == "N/A" ? color.silver : color.aqua, text_size=backtestTS)

            table.cell(backtestReport, 0, 9, "Avg Win / Avg Loss", text_color=color.white, text_size=backtestTS)
            table.cell(backtestReport, 1, 9, btAvgWinLoss, text_color=color.white, text_size=backtestTS)

            table.cell(backtestReport, 0, 10, "Trade Expectancy", text_color=color.white, text_size=backtestTS)
            table.cell(backtestReport, 1, 10, f_expectancyText(btExpectancy, btCompleted), text_color=na(btExpectancy) ? color.silver : f_pnlColor(btExpectancy), text_size=backtestTS)

            table.cell(backtestReport, 0, 11, "TP3 Wins / Losses", text_color=color.white, text_size=backtestTS)
            table.cell(backtestReport, 1, 11, str.tostring(btTP3Wins) + " / " + str.tostring(btLosses), text_color=color.white, text_size=backtestTS)

            string backtestScopeDisplay = backtestScope == "Custom Number of Boxes" ? "Custom: " + str.tostring(btCompleted) + " / " + str.tostring(backtestCustomBoxCount) : backtestScope
            table.cell(backtestReport, 0, 12, "Scope", text_color=color.silver, bgcolor=color.new(color.gray, 82), text_size=backtestTS)
            table.cell(backtestReport, 1, 12, backtestScopeDisplay, text_color=color.silver, bgcolor=color.new(color.gray, 82), text_size=backtestTS)


f_renderBacktestReport()
// ============================================================================
// RUNNER STATS TABLE
// Separate from Dashboard and optional. Scope is user-selectable. Statistics
// follow the runner's originating core trade rather than its later resolution bar.
// ============================================================================
runnerStatsTS = f_reportTextSize(runnerStatsTextSize)
var table runnerStatsTable = table.new(f_dashboardPosition(runnerStatsPosition), 2, 14,
     bgcolor=color.new(color.black, 8), frame_color=color.new(color.aqua, 45), frame_width=1, border_width=1)

f_renderRunnerStats() =>
    if barstate.islast
        table.clear(runnerStatsTable, 0, 0, 1, 13)
        if runnerModuleEnabled and showRunnerStats and not flipMirrorModeActive
            int scopedQualified = 0
            int scopedResolved = 0
            float scopedCPL = 0.0
            float scopedGrossProfit = 0.0
            float scopedGrossLoss = 0.0
            float scopedExtensionSumATR = 0.0
            float scopedMaxExtensionATR = 0.0
            int[] scopedTargetHits = runnerTargetHits
            string effectiveRunnerScope = runnerStatsScope

            if runnerStatsScope == "Current Session"
                if inPMSession
                    scopedQualified := runnerPMQualified
                    scopedResolved := runnerPMResolved
                    scopedCPL := runnerPMCPL
                    scopedGrossProfit := runnerPMGrossProfit
                    scopedGrossLoss := runnerPMGrossLoss
                    scopedExtensionSumATR := runnerPMExtensionSumATR
                    scopedMaxExtensionATR := runnerPMMaxExtensionATR
                    scopedTargetHits := runnerPMTargetHits
                    effectiveRunnerScope := "Current Session (PM)"
                else if inNYSession
                    scopedQualified := runnerNYQualified
                    scopedResolved := runnerNYResolved
                    scopedCPL := runnerNYCPL
                    scopedGrossProfit := runnerNYGrossProfit
                    scopedGrossLoss := runnerNYGrossLoss
                    scopedExtensionSumATR := runnerNYExtensionSumATR
                    scopedMaxExtensionATR := runnerNYMaxExtensionATR
                    scopedTargetHits := runnerNYTargetHits
                    effectiveRunnerScope := "Current Session (NY)"
                else
                    effectiveRunnerScope := "Current Session (OFF)"
            else if runnerStatsScope == "Current NY Session"
                scopedQualified := runnerNYQualified
                scopedResolved := runnerNYResolved
                scopedCPL := runnerNYCPL
                scopedGrossProfit := runnerNYGrossProfit
                scopedGrossLoss := runnerNYGrossLoss
                scopedExtensionSumATR := runnerNYExtensionSumATR
                scopedMaxExtensionATR := runnerNYMaxExtensionATR
                scopedTargetHits := runnerNYTargetHits
            else if runnerStatsScope == "Current PM Session"
                scopedQualified := runnerPMQualified
                scopedResolved := runnerPMResolved
                scopedCPL := runnerPMCPL
                scopedGrossProfit := runnerPMGrossProfit
                scopedGrossLoss := runnerPMGrossLoss
                scopedExtensionSumATR := runnerPMExtensionSumATR
                scopedMaxExtensionATR := runnerPMMaxExtensionATR
                scopedTargetHits := runnerPMTargetHits
            else if runnerStatsScope == "Current Trading Day"
                scopedQualified := runnerDayQualified
                scopedResolved := runnerDayResolved
                scopedCPL := runnerDayCPL
                scopedGrossProfit := runnerDayGrossProfit
                scopedGrossLoss := runnerDayGrossLoss
                scopedExtensionSumATR := runnerDayExtensionSumATR
                scopedMaxExtensionATR := runnerDayMaxExtensionATR
                scopedTargetHits := runnerDayTargetHits
            else if runnerStatsScope == "Current Week"
                scopedQualified := runnerWeekQualified
                scopedResolved := runnerWeekResolved
                scopedCPL := runnerWeekCPL
                scopedGrossProfit := runnerWeekGrossProfit
                scopedGrossLoss := runnerWeekGrossLoss
                scopedExtensionSumATR := runnerWeekExtensionSumATR
                scopedMaxExtensionATR := runnerWeekMaxExtensionATR
                scopedTargetHits := runnerWeekTargetHits
            else
                scopedQualified := runnerQualifiedCount
                scopedResolved := runnerResolvedCount
                scopedCPL := runnerCPL
                scopedGrossProfit := runnerGrossProfit
                scopedGrossLoss := runnerGrossLoss
                scopedExtensionSumATR := runnerExtensionSumATR
                scopedMaxExtensionATR := runnerMaxExtensionATR
                scopedTargetHits := runnerTargetHits

            string scopedExtBoxes = ""
            int extStoredTradeCount = array.size(tradeDirections)
            int extScopeRank = 0

            if extStoredTradeCount > 0
                for extTradeIndex = 0 to extStoredTradeCount - 1
                    int extSessionType = array.get(tradeSessionTypes, extTradeIndex)
                    int extSessionGeneration = array.get(tradeSessionGenerations, extTradeIndex)
                    int extTradingDayKey = array.get(tradeTradingDayKeys, extTradeIndex)
                    int extWeekKey = array.get(tradeWeekKeys, extTradeIndex)
                    bool extBelongsToScope = false

                    if runnerStatsScope == "Current Session"
                        extBelongsToScope := inPMSession ? (extSessionType == 1 and extSessionGeneration == pmSessionGeneration) : inNYSession ? (extSessionType == 2 and extSessionGeneration == nySessionGeneration) : false
                    else if runnerStatsScope == "Current NY Session"
                        extBelongsToScope := extSessionType == 2 and extSessionGeneration == nySessionGeneration
                    else if runnerStatsScope == "Current PM Session"
                        extBelongsToScope := extSessionType == 1 and extSessionGeneration == pmSessionGeneration
                    else if runnerStatsScope == "Current Trading Day"
                        extBelongsToScope := extTradingDayKey == runnerTradingDayKey
                    else if runnerStatsScope == "Current Week"
                        extBelongsToScope := extWeekKey == reportWeekKey
                    else
                        extBelongsToScope := true

                    if extBelongsToScope
                        bool extActualHit = array.get(tradeExtensionHit, extTradeIndex)
                        bool extMomentumCriterion = not runnerUseMomentumPersistence or array.get(tradeRunnerMomentumQualified, extTradeIndex)
                        bool extBaselineCriterion = not runnerUseBaselineSeparation or array.get(tradeRunnerBaselineQualified, extTradeIndex)
                        bool extEMASlopeCriterion = not runnerUseEMASlope or array.get(tradeRunnerEMASlopeQualified, extTradeIndex)
                        bool extTP4Criterion = not runnerUseTP4Confirmation or extActualHit
                        int extBoxEnabledCriteria = (runnerUseMomentumPersistence ? 1 : 0) + (runnerUseBaselineSeparation ? 1 : 0) + (runnerUseEMASlope ? 1 : 0) + (runnerUseTP4Confirmation ? 1 : 0)
                        int extBoxPassedCriteria = (runnerUseMomentumPersistence and extMomentumCriterion ? 1 : 0) + (runnerUseBaselineSeparation and extBaselineCriterion ? 1 : 0) + (runnerUseEMASlope and extEMASlopeCriterion ? 1 : 0) + (runnerUseTP4Confirmation and extTP4Criterion ? 1 : 0)
                        bool extBoxCriteriaPass = extBoxEnabledCriteria == 0 ? true : runnerCriteriaAgreement == "All Enabled" ? extBoxPassedCriteria == extBoxEnabledCriteria : extBoxPassedCriteria > 0

                        if extActualHit and extBoxCriteriaPass
                            scopedExtBoxes += (str.length(scopedExtBoxes) > 0 ? ", " : "") + str.tostring(extScopeRank)
                        extScopeRank += 1

            if str.length(scopedExtBoxes) == 0
                scopedExtBoxes := "—"

            float scopedRunnerPF = scopedGrossLoss > 0 ? scopedGrossProfit / scopedGrossLoss : na
            float scopedAvgRunnerExtension = scopedResolved > 0 ? scopedExtensionSumATR / float(scopedResolved) : na
            string runnerStatus = array.size(runnerIds) > 0 ? "RUNNER ACTIVE" : runnerPreArmed ? "PRE-ARMED" : runnerArmed ? "ARMED" : runnerAssessmentStarted ? "ASSESSING" : "IDLE"
            string probabilityText = na(runnerContinuationProbability) ? "N/A" : str.tostring(runnerContinuationProbability, "#.0") + "%"

            table.cell(runnerStatsTable, 0, 0, "RUNNER STATS", text_color=color.white, bgcolor=color.navy, text_size=runnerStatsTS)
            table.cell(runnerStatsTable, 1, 0, "", bgcolor=color.navy, text_size=runnerStatsTS)
            table.merge_cells(runnerStatsTable, 0, 0, 1, 0)

            table.cell(runnerStatsTable, 0, 1, "Qualified", text_color=color.white, text_size=runnerStatsTS)
            table.cell(runnerStatsTable, 1, 1, str.tostring(scopedQualified), text_color=color.aqua, text_size=runnerStatsTS)

            table.cell(runnerStatsTable, 0, 2, "Ext Boxes", text_color=color.white, text_size=runnerStatsTS)
            table.cell(runnerStatsTable, 1, 2, scopedExtBoxes, text_color=scopedExtBoxes == "—" ? color.silver : color.aqua, text_size=runnerStatsTS)

            for runnerLevel = 4 to 8
                int row = runnerLevel - 1
                int hitIndex = runnerLevel - 4
                int hitCount = array.get(scopedTargetHits, hitIndex)
                bool targetEnabled = runnerLevel <= runnerMaxTP
                float hitRate = scopedQualified > 0 ? float(hitCount) / float(scopedQualified) * 100.0 : na
                string hitText = targetEnabled ? (na(hitRate) ? "N/A" : str.tostring(hitRate, "#.0") + "% (" + str.tostring(hitCount) + "/" + str.tostring(scopedQualified) + ")") : "OFF"
                table.cell(runnerStatsTable, 0, row, "TP" + str.tostring(runnerLevel) + " Hit %", text_color=color.white, text_size=runnerStatsTS)
                table.cell(runnerStatsTable, 1, row, hitText, text_color=targetEnabled ? f_hitRateColor(hitRate) : color.silver, text_size=runnerStatsTS)

            table.cell(runnerStatsTable, 0, 8, "Runner CP&L", text_color=color.white, text_size=runnerStatsTS)
            table.cell(runnerStatsTable, 1, 8, f_signedPoints(scopedCPL), text_color=f_pnlColor(scopedCPL), text_size=runnerStatsTS)

            table.cell(runnerStatsTable, 0, 9, "Runner Profit Factor", text_color=color.white, text_size=runnerStatsTS)
            table.cell(runnerStatsTable, 1, 9, na(scopedRunnerPF) ? (scopedGrossProfit > 0 ? "∞" : "N/A") : str.tostring(scopedRunnerPF, "#.##"), text_color=color.aqua, text_size=runnerStatsTS)

            table.cell(runnerStatsTable, 0, 10, "Avg / Max Extension", text_color=color.white, text_size=runnerStatsTS)
            table.cell(runnerStatsTable, 1, 10, (na(scopedAvgRunnerExtension) ? "N/A" : str.tostring(scopedAvgRunnerExtension, "#.##") + " ATR") + " / " + str.tostring(scopedMaxExtensionATR, "#.##") + " ATR", text_color=color.white, text_size=runnerStatsTS)

            table.cell(runnerStatsTable, 0, 11, "Criteria Match", text_color=color.white, text_size=runnerStatsTS)
            table.cell(runnerStatsTable, 1, 11, probabilityText, text_color=na(runnerContinuationProbability) ? color.silver : runnerContinuationProbability >= 100.0 ? color.lime : runnerContinuationProbability > 0.0 ? color.orange : color.red, text_size=runnerStatsTS)

            table.cell(runnerStatsTable, 0, 12, "Status", text_color=color.white, text_size=runnerStatsTS)
            table.cell(runnerStatsTable, 1, 12, runnerStatus, text_color=runnerStatus == "RUNNER ACTIVE" or runnerStatus == "PRE-ARMED" or runnerStatus == "ARMED" ? color.lime : runnerStatus == "ASSESSING" ? color.orange : color.silver, text_size=runnerStatsTS)

            table.cell(runnerStatsTable, 0, 13, "Scope", text_color=color.silver, bgcolor=color.new(color.gray, 82), text_size=runnerStatsTS)
            table.cell(runnerStatsTable, 1, 13, effectiveRunnerScope, text_color=color.silver, bgcolor=color.new(color.gray, 82), text_size=runnerStatsTS)


// ============================================================================
// PREMIUM DASHBOARD
// ============================================================================
float beiCurrentSessionHigh = inPMSession ? pmSessionHighPrice : inNYSession ? nySessionHighPrice : na
float beiCurrentSessionLow = inPMSession ? pmSessionLowPrice : inNYSession ? nySessionLowPrice : na
float beiCurrentSessionRange = not na(beiCurrentSessionHigh) and not na(beiCurrentSessionLow) ? math.max(0.0, beiCurrentSessionHigh - beiCurrentSessionLow) : na
float beiSessionRangeIndex = not na(beiCurrentSessionRange) and not na(currentATR) and currentATR > 0.0 ? beiCurrentSessionRange / currentATR : na
string beiSessionRangeText = na(beiCurrentSessionRange) ? "N/A" : str.tostring(beiCurrentSessionRange, format.mintick) + " pts"
string beiSessionRangeIndexText = na(beiSessionRangeIndex) ? "N/A" : str.tostring(beiSessionRangeIndex, "#.##")
string beiChopScoreText = beiChopReady ? str.tostring(beiChopScoreHTF, "#") + "/100" : "N/A"
color beiChopScoreColor = not beiChopReady ? color.silver : beiChopScoreHTF > float(beiChopMaximum) ? color.red : color.lime

int activeSessionTP1Wins = inPMSession ? pmSessionTP1Wins : inNYSession ? nySessionTP1Wins : 0
int activeSessionTP2Wins = inPMSession ? pmSessionTP2Wins : inNYSession ? nySessionTP2Wins : 0
int activeSessionTP3Wins = inPMSession ? pmSessionWins : inNYSession ? nySessionWins : 0
int activeSessionCompletedTrades = inPMSession ? pmSessionCompletedTrades : inNYSession ? nySessionCompletedTrades : 0
string activeSessionName = inPMSession ? "PM" : inNYSession ? "NY" : "OFF"

float activeSessionTP1WinRate = activeSessionCompletedTrades > 0 ? float(activeSessionTP1Wins) / float(activeSessionCompletedTrades) * 100.0 : na
float activeSessionTP2WinRate = activeSessionCompletedTrades > 0 ? float(activeSessionTP2Wins) / float(activeSessionCompletedTrades) * 100.0 : na
float activeSessionTP3WinRate = activeSessionCompletedTrades > 0 ? float(activeSessionTP3Wins) / float(activeSessionCompletedTrades) * 100.0 : na
float activeSessionTP1CPL = inPMSession ? pmSessionTP1CPL : inNYSession ? nySessionTP1CPL : na
float activeSessionTP2CPL = inPMSession ? pmSessionTP2CPL : inNYSession ? nySessionTP2CPL : na
float activeSessionTP3CPL = inPMSession ? pmSessionTP3CPL : inNYSession ? nySessionTP3CPL : na

f_sessionRateColor(float rate) =>
    f_hitRateColor(rate)

f_sessionRateText(float rate, int wins, int completed) =>
    not inPMSession and not inNYSession ? "OFF" : na(rate) ? "N/A (0/0)" : str.tostring(rate, "#.0") + "% (" + str.tostring(wins) + "/" + str.tostring(completed) + ")"

f_sessionCPLText(float value) =>
    na(value) ? "OFF" : (value > 0 ? "+" : "") + str.tostring(value, format.mintick) + " pts"

color activeSessionTP1WinRateColor = f_sessionRateColor(activeSessionTP1WinRate)
color activeSessionTP2WinRateColor = f_sessionRateColor(activeSessionTP2WinRate)
color activeSessionTP3WinRateColor = f_sessionRateColor(activeSessionTP3WinRate)
string activeSessionTP1WinRateText = f_sessionRateText(activeSessionTP1WinRate, activeSessionTP1Wins, activeSessionCompletedTrades)
string activeSessionTP2WinRateText = f_sessionRateText(activeSessionTP2WinRate, activeSessionTP2Wins, activeSessionCompletedTrades)
string activeSessionTP3WinRateText = f_sessionRateText(activeSessionTP3WinRate, activeSessionTP3Wins, activeSessionCompletedTrades)

string liveAgreementText = str.tostring(math.max(bullishAgreementCount, bearishAgreementCount)) + "/" + str.tostring(enabledEngineCount)
string liveAgreementDirection = bullishAgreementCount > bearishAgreementCount ? "LONG" : bearishAgreementCount > bullishAgreementCount ? "SHORT" : ""
string dashboardEntryFilterMode = entryTrendFilterMode == "All Enabled" ? "All" : "Any"
string entryFilterSummary = enabledEntryTrendFilterCount > 0 ? " | F:" + str.tostring(enabledEntryTrendFilterCount) + " " + dashboardEntryFilterMode : ""
string dashboardEngineText = flipMirrorModeActive ? (mirrorSourceTFValid ? "HTF MIRROR | " + htfMirrorTF : "HTF MIRROR | INVALID TF") : signalEngineName + " | " + (liveAgreementDirection == "" ? liveAgreementText : liveAgreementDirection + " " + liveAgreementText) + entryFilterSummary

// Potential Entry is actionable only before a trade is active and while price is
// near the live DPO zero-price. Once a zero-line crossing creates a trade box,
// the active-trade lock takes priority over proximity.
bool dashboardHasActiveTrade = false
if array.size(tradeActive) > 0
    for i = 0 to array.size(tradeActive) - 1
        if array.get(tradeActive, i)
            dashboardHasActiveTrade := true
float potentialEntryRangePoints = currentATR * potentialEntryATRPercent / 100.0
bool potentialEntryInRange = not na(signalBaselinePrice) and not na(currentATR) and math.abs(close - signalBaselinePrice) <= potentialEntryRangePoints
bool alwaysShowPotentialEntry = potentialEntryDisplayMode == "Always Show"
bool potentialEntryShouldDisplay = not na(signalBaselinePrice) and (alwaysShowPotentialEntry or potentialEntryInRange)
string potentialEntryText = dashboardHasActiveTrade ? "-" : potentialEntryShouldDisplay ? str.tostring(signalBaselinePrice, format.mintick) : "WAIT"
color potentialEntryColor = dashboardHasActiveTrade ? color.silver : potentialEntryShouldDisplay ? color.aqua : color.orange

tableTextSize = tableSizeInput == "Tiny" ? size.tiny : tableSizeInput == "Normal" ? size.normal : size.small
var table dashboard = table.new(f_dashboardPosition(dashboardPosition), 3, 19, bgcolor=color.new(color.black, 5), border_width=1)

f_renderDashboard() =>
    if barstate.islast
        table.clear(dashboard, 0, 0, 2, 18)
        if dashboardEnabled
            table.cell(dashboard, 0, 0, "Dashboard", text_color=color.white, bgcolor=color.navy, text_size=tableTextSize)
            table.cell(dashboard, 1, 0, premiumFeatures ? "PREMIUM" : "FREE", text_color=color.white, bgcolor=color.navy, text_size=tableTextSize)
            table.cell(dashboard, 2, 0, activeSessionName, text_color=color.white, bgcolor=color.navy, text_size=tableTextSize)

            int separatorRow = premiumFeatures ? 11 : 8
            if premiumFeatures
                table.cell(dashboard, 0, 1, "Engines", text_color=color.white, text_size=tableTextSize)
                table.cell(dashboard, 1, 1, dashboardEngineText, text_color=color.aqua, text_size=tableTextSize)
                table.cell(dashboard, 2, 1, "", text_size=tableTextSize)

                table.cell(dashboard, 0, 2, "Potential Entry", text_color=color.white, text_size=tableTextSize)
                table.cell(dashboard, 1, 2, flipMirrorModeActive ? "N/A" : potentialEntryText, text_color=flipMirrorModeActive ? color.silver : potentialEntryColor, text_size=tableTextSize)
                table.cell(dashboard, 2, 2, "", text_size=tableTextSize)

                table.cell(dashboard, 0, 3, "Avg Momentum", text_color=color.white, text_size=tableTextSize)
                table.cell(dashboard, 1, 3, flipMirrorModeActive ? "N/A" : na(avgDPO) ? "N/A" : str.tostring(avgDPO, "#.##"), text_color=flipMirrorModeActive ? color.silver : color.white, text_size=tableTextSize)
                table.cell(dashboard, 2, 3, "", text_size=tableTextSize)

                table.cell(dashboard, 0, 4, "ATR", text_color=color.white, text_size=tableTextSize)
                table.cell(dashboard, 1, 4, flipMirrorModeActive ? "N/A" : str.tostring(currentATR, format.mintick), text_color=flipMirrorModeActive ? color.silver : volatilityColor, text_size=tableTextSize)
                table.cell(dashboard, 2, 4, "", text_size=tableTextSize)

                table.cell(dashboard, 0, 5, "Volatility", text_color=color.white, text_size=tableTextSize)
                table.cell(dashboard, 1, 5, flipMirrorModeActive ? "N/A" : volatilityState + " | " + str.tostring(atrPercent, "#.0") + "%", text_color=flipMirrorModeActive ? color.silver : volatilityColor, text_size=tableTextSize)
                table.cell(dashboard, 2, 5, "", text_size=tableTextSize)

                table.cell(dashboard, 0, 6, "Energy", text_color=color.white, text_size=tableTextSize)
                table.cell(dashboard, 1, 6, flipMirrorModeActive ? "N/A" : str.tostring(leiScore, "#.0") + " | " + leiState, text_color=flipMirrorModeActive ? color.silver : leiColor, text_size=tableTextSize)
                table.cell(dashboard, 2, 6, "", text_size=tableTextSize)

                table.cell(dashboard, 0, 7, "Regime", text_color=color.white, text_size=tableTextSize)
                table.cell(dashboard, 1, 7, flipMirrorModeActive ? "N/A" : regimeState, text_color=flipMirrorModeActive ? color.silver : regimeColor, text_size=tableTextSize)
                table.cell(dashboard, 2, 7, "", text_size=tableTextSize)
            else
                table.cell(dashboard, 0, 1, "Engines", text_color=color.white, text_size=tableTextSize)
                table.cell(dashboard, 1, 1, dashboardEngineText, text_color=color.aqua, text_size=tableTextSize)
                table.cell(dashboard, 2, 1, "", text_size=tableTextSize)

                table.cell(dashboard, 0, 2, "ATR", text_color=color.white, text_size=tableTextSize)
                table.cell(dashboard, 1, 2, flipMirrorModeActive ? "N/A" : str.tostring(currentATR, format.mintick), text_color=flipMirrorModeActive ? color.silver : volatilityColor, text_size=tableTextSize)
                table.cell(dashboard, 2, 2, "", text_size=tableTextSize)

                table.cell(dashboard, 0, 3, "Volatility", text_color=color.white, text_size=tableTextSize)
                table.cell(dashboard, 1, 3, flipMirrorModeActive ? "N/A" : volatilityState + " | " + str.tostring(atrPercent, "#.0") + "%", text_color=flipMirrorModeActive ? color.silver : volatilityColor, text_size=tableTextSize)
                table.cell(dashboard, 2, 3, "", text_size=tableTextSize)

                table.cell(dashboard, 0, 4, "Regime", text_color=color.white, text_size=tableTextSize)
                table.cell(dashboard, 1, 4, flipMirrorModeActive ? "N/A" : regimeState, text_color=flipMirrorModeActive ? color.silver : regimeColor, text_size=tableTextSize)
                table.cell(dashboard, 2, 4, "", text_size=tableTextSize)

            // Session context is shown in Free and Premium modes and updates
            // continuously throughout the active PM or NY session.
            int beiContextRow = premiumFeatures ? 8 : 5
            table.cell(dashboard, 0, beiContextRow, "Session Range", text_color=color.white, text_size=tableTextSize)
            table.cell(dashboard, 1, beiContextRow, beiSessionRangeText, text_color=na(beiCurrentSessionRange) ? color.silver : color.aqua, text_size=tableTextSize)
            table.cell(dashboard, 2, beiContextRow, "", text_size=tableTextSize)
            table.cell(dashboard, 0, beiContextRow + 1, "Chop Score", text_color=color.white, text_size=tableTextSize)
            table.cell(dashboard, 1, beiContextRow + 1, beiChopScoreText, text_color=beiChopScoreColor, text_size=tableTextSize)
            table.cell(dashboard, 2, beiContextRow + 1, "", text_size=tableTextSize)
            table.cell(dashboard, 0, beiContextRow + 2, "Range Index", text_color=color.white, text_size=tableTextSize)
            table.cell(dashboard, 1, beiContextRow + 2, beiSessionRangeIndexText, text_color=na(beiSessionRangeIndex) ? color.silver : color.aqua, text_size=tableTextSize)
            table.cell(dashboard, 2, beiContextRow + 2, "", text_size=tableTextSize)

            // Empty separator row between market information and session analytics.
            table.cell(dashboard, 0, separatorRow, "", bgcolor=color.new(color.black, 100), text_size=tableTextSize)
            table.cell(dashboard, 1, separatorRow, "", bgcolor=color.new(color.black, 100), text_size=tableTextSize)
            table.cell(dashboard, 2, separatorRow, "", bgcolor=color.new(color.black, 100), text_size=tableTextSize)

            int analyticsHeaderRow = separatorRow + 1
            table.cell(dashboard, 0, analyticsHeaderRow, "Target", text_color=color.silver, bgcolor=color.new(color.gray, 75), text_size=tableTextSize)
            table.cell(dashboard, 1, analyticsHeaderRow, "Hit %", text_color=color.silver, bgcolor=color.new(color.gray, 75), text_size=tableTextSize)
            table.cell(dashboard, 2, analyticsHeaderRow, "CP&L", text_color=color.silver, bgcolor=color.new(color.gray, 75), text_size=tableTextSize)

            table.cell(dashboard, 0, analyticsHeaderRow + 1, "TP1", text_color=tp1Color, text_size=tableTextSize)
            table.cell(dashboard, 1, analyticsHeaderRow + 1, flipMirrorModeActive ? "N/A" : activeSessionTP1WinRateText, text_color=flipMirrorModeActive ? color.silver : activeSessionTP1WinRateColor, text_size=tableTextSize)
            table.cell(dashboard, 2, analyticsHeaderRow + 1, flipMirrorModeActive ? "N/A" : premiumFeatures ? f_sessionCPLText(activeSessionTP1CPL) : "PREMIUM", text_color=flipMirrorModeActive ? color.silver : premiumFeatures ? f_pnlColor(activeSessionTP1CPL) : color.silver, text_size=tableTextSize)
            table.cell(dashboard, 0, analyticsHeaderRow + 2, "TP2", text_color=tp2Color, text_size=tableTextSize)
            table.cell(dashboard, 1, analyticsHeaderRow + 2, flipMirrorModeActive ? "N/A" : activeSessionTP2WinRateText, text_color=flipMirrorModeActive ? color.silver : activeSessionTP2WinRateColor, text_size=tableTextSize)
            table.cell(dashboard, 2, analyticsHeaderRow + 2, flipMirrorModeActive ? "N/A" : premiumFeatures ? f_sessionCPLText(activeSessionTP2CPL) : "PREMIUM", text_color=flipMirrorModeActive ? color.silver : premiumFeatures ? f_pnlColor(activeSessionTP2CPL) : color.silver, text_size=tableTextSize)
            table.cell(dashboard, 0, analyticsHeaderRow + 3, "TP3", text_color=tp3Color, text_size=tableTextSize)
            table.cell(dashboard, 1, analyticsHeaderRow + 3, flipMirrorModeActive ? "N/A" : activeSessionTP3WinRateText, text_color=flipMirrorModeActive ? color.silver : activeSessionTP3WinRateColor, text_size=tableTextSize)
            table.cell(dashboard, 2, analyticsHeaderRow + 3, flipMirrorModeActive ? "N/A" : premiumFeatures ? f_sessionCPLText(activeSessionTP3CPL) : "PREMIUM", text_color=flipMirrorModeActive ? color.silver : premiumFeatures ? f_pnlColor(activeSessionTP3CPL) : color.silver, text_size=tableTextSize)


f_renderDashboard()
// ============================================================================
// ALERT CONDITIONS AND HIDDEN EXPORTS
// ============================================================================
