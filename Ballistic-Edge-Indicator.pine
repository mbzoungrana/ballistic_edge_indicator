GROUP_BOX = "FREE — 5. Risk and Targets"
atrLength = input.int(14, "ATR Length", minval=1, group=GROUP_BOX)
slMode = input.string("ATR", "Stop Reference",
     options=["ATR", "Baseline", "Baseline + Buffer", "Hybrid", "Trailing SL"], group=GROUP_BOX,
     tooltip="ATR: stop is Entry ± ATR × multiplier. Baseline: stop is placed at the frozen qualifying baseline. Baseline + Buffer: stop is placed beyond that frozen baseline by an ATR-based buffer. Hybrid: uses the tighter protective stop between ATR and Baseline + Buffer. Trailing SL: follows the live active baseline in the favorable direction only and never loosens once tightened.")
slATRMult = input.float(1.0, "SL ATR Multiple", minval=0.25, maxval=10.0, step=0.25, group=GROUP_BOX)
slBaselineBufferATR = input.float(0.25, "Baseline Buffer ATR", minval=0.0, maxval=5.0, step=0.05, group=GROUP_BOX,
