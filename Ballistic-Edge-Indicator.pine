// Commitment-panel state is separate from trade accounting. The panel remains
// associated with its stored box after TP3/SL until that box is removed or hidden.
var bool commitmentTradeActive = false
varip bool commitmentPanelQualified = false
varip bool commitmentTP3Hit = false
varip bool commitmentSLHit = false
