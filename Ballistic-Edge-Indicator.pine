// ============================================================================
GROUP_HTF_MIRROR = "FREE — 2A. HTF Mirror"
htfMirrorTF = input.timeframe("60", "HTF Mirror Timeframe", group=GROUP_HTF_MIRROR,
     tooltip="Higher timeframe used as the source when Flip — Mirror HTF Boxes is enabled. Example: 5m chart mirroring 1H Ballistic Edge signals.")
flipHTFMirrorEnabled = input.bool(false, "Flip — Mirror HTF Boxes", group=GROUP_HTF_MIRROR,
     tooltip="OFF: the current chart timeframe generates its own Ballistic Edge signals/boxes. ON: current-TF signal generation is bypassed and this chart mirrors each selected-HTF DPO signal intrabar. Mirrored trades do not feed this lower-TF Dashboard statistics, Daily/Weekly Reports, or BackTest; use the source HTF instance for those analytics.")

// ============================================================================
// 3. INFORMATIONAL CONFLUENCE
