     tooltip="Used only by Trailing SL. 0.00 makes the live active baseline the stop. A positive value leaves an ATR-based tolerance beyond the live baseline. The trade's frozen entry ATR is used for a stable buffer.")
tp1ATRMult = input.float(1.00, "TP1 ATR Multiple", minval=0.10, maxval=10.0, step=0.25, group=GROUP_BOX)
