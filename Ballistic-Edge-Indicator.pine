// Effective feature gates. Free mode keeps a practical 20-box history and the
// complete trade engine, while Premium unlocks user-selectable management tools.
int effectiveMaxStoredBoxes = premiumFeatures ? maxStoredBoxes : 20
string effectiveBoxDisplayMode = premiumFeatures ? boxDisplayMode : "Active Session Only"
int effectiveCustomVisibleBoxes = premiumFeatures ? customVisibleBoxes : 20
bool dashboardEnabled = showDashboard
bool dataPanelEnabled = premiumFeatures and showCommitmentPanel
bool premiumOverlapCountsEnabled = premiumFeatures
bool premiumTradeRankingsEnabled = premiumFeatures
bool backtestReplayEnabled = premiumFeatures and enableBacktestReplay
bool runnerModuleEnabled = false

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================
f_defaultDPOLength(string category) =>
    int result = 20
    if category == "1M"
        result := 8
    else if category == "5M"
        result := 12
    else if category == "15M"
        result := 20
    else if category == "30M"
        result := 25
    else if category == "1H"
        result := 40
    else if category == "4H"
        result := 50
    else
        result := 60
    result

f_currentTFCategory() =>
    float tfMinutes = timeframe.in_seconds(timeframe.period) / 60.0
    string category = "Daily+"
    if tfMinutes <= 1
        category := "1M"
    else if tfMinutes <= 5
        category := "5M"
    else if tfMinutes <= 15
        category := "15M"
    else if tfMinutes <= 30
        category := "30M"
    else if tfMinutes <= 60
        category := "1H"
    else if tfMinutes <= 240
        category := "4H"
    category

f_getDPOLength() =>
    string currentCategory = f_currentTFCategory()
    bool selectedMatches = selectedTimeframe == "Current Chart TF" or selectedTimeframe == currentCategory
    selectedMatches ? customDPOLength : f_defaultDPOLength(currentCategory)

eemAlertVersion = input.string("BE-20261003", "EEM Alert Version", group=GROUP_ALERTS)

f_sendTradeBoxAlert(int direction, float entryPrice, float tp1Price, float tp2Price, float tp3Price, float slPrice, float alertDpo, int alertDpoLength, float alertAtr) =>
    if enableTradeBoxAlerts
        bool isOneMinute = timeframe.isminutes and timeframe.multiplier == 1
        if isOneMinute
            string directionText = direction == 1 ? "LONG" : "SHORT"
            string signalId = syminfo.tickerid + "-" + str.tostring(time) + "-" + directionText
            string message = "{" +
                 "\"schema\":\"EEM.TV.BES.2\"," +
                 "\"source\":\"TRADINGVIEW\"," +
                 "\"strategy\":\"BALLISTIC_EDGE_DPO_CORE\"," +
                 "\"instrument\":\"" + syminfo.root + "\"," +
                 "\"timeframe\":\"1m\"," +
                 "\"signal\":\"" + directionText + "\"," +
                 "\"signalId\":\"" + signalId + "\"," +
                 "\"barTime\":" + str.tostring(time) + "," +
                 "\"signalTime\":" + str.tostring(timenow) + "," +
                 "\"observedPrice\":" + str.tostring(close) + "," +
                 "\"baseline\":" + str.tostring(entryPrice) + "," +
                 "\"entryPrice\":" + str.tostring(entryPrice) + "," +
                 "\"stop\":" + str.tostring(slPrice) + "," +
                 "\"tp1\":" + str.tostring(tp1Price) + "," +
                 "\"tp2\":" + str.tostring(tp2Price) + "," +
                 "\"tp3\":" + str.tostring(tp3Price) + "," +
                 "\"dpo\":" + str.tostring(alertDpo) + "," +
                 "\"dpoLength\":" + str.tostring(alertDpoLength) + "," +
                 "\"atr\":" + str.tostring(alertAtr) + "," +
                 "\"slMode\":\"" + slMode + "\"," +
                 "\"slAtrMultiple\":" + str.tostring(slATRMult) + "," +
                 "\"tp1AtrMultiple\":" + str.tostring(tp1ATRMult) + "," +
                 "\"tp2AtrMultiple\":" + str.tostring(tp2ATRMult) + "," +
                 "\"tp3AtrMultiple\":" + str.tostring(tp3ATRMult) + "," +
                 "\"version\":\"" + eemAlertVersion + "\"}"
            if tradeBoxAlertFrequency == "All"
                alert(message, alert.freq_all)
            else if tradeBoxAlertFrequency == "Once Per Bar"
                alert(message, alert.freq_once_per_bar)
            else
                alert(message, alert.freq_once_per_bar_close)


f_commitmentPanelPosition(string p) =>
    p == "Top Left" ? position.top_left : p == "Top Center" ? position.top_center : p == "Top Right" ? position.top_right : p == "Middle Left" ? position.middle_left : p == "Middle Center" ? position.middle_center : p == "Middle Right" ? position.middle_right : p == "Bottom Left" ? position.bottom_left : p == "Bottom Center" ? position.bottom_center : position.bottom_right

f_commitmentTextSize(string s) =>
    s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Huge" ? size.huge : size.large

f_dashboardPosition(string p) =>
    p == "Top Left" ? position.top_left : p == "Top Center" ? position.top_center : p == "Top Right" ? position.top_right : p == "Middle Left" ? position.middle_left : p == "Middle Center" ? position.middle_center : p == "Middle Right" ? position.middle_right : p == "Bottom Left" ? position.bottom_left : p == "Bottom Center" ? position.bottom_center : position.bottom_right

f_reportTextSize(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

f_signedPoints(float value) =>
    (value > 0 ? "+" : "") + str.tostring(value, format.mintick) + " pts"

f_signedPointsOrNA(float value, int observations) =>
    observations > 0 ? f_signedPoints(value) : "N/A"

f_drawdownTextOrNA(float value, int observations) =>
    observations > 0 ? "-" + str.tostring(value, format.mintick) + " pts" : "N/A"

f_pnlColor(float value) =>
    value > 0 ? color.lime : value < 0 ? color.red : color.silver

// Hit-rate color bands:
//   0.00% - 33.33% = red
//   >33.33% - <67.00% = orange
//   67.00% - 100.00% = green
//   No data = silver
f_hitRateColor(float rate) =>
    na(rate) ? color.silver : rate <= 33.33 ? color.red : rate < 67.0 ? color.orange : color.lime

f_profitFactorText(float grossProfit, float grossLossAbs, int completedTrades) =>
    completedTrades == 0 ? "N/A" : grossLossAbs == 0.0 ? (grossProfit > 0.0 ? "∞" : "N/A") : str.tostring(grossProfit / grossLossAbs, "#.##")

f_avgWinLossText(float grossProfit, float grossLossAbs, int wins, int losses) =>
    string avgWinText = wins > 0 ? "+" + str.tostring(grossProfit / float(wins), format.mintick) : "N/A"
    string avgLossText = losses > 0 ? "-" + str.tostring(grossLossAbs / float(losses), format.mintick) : "N/A"
    avgWinText + " / " + avgLossText + " pts"

f_expectancyText(float expectancy, int completedTrades) =>
    completedTrades > 0 ? f_signedPoints(expectancy) + " / trade" : "N/A"

f_clamp01(float value) =>
    math.max(0.0, math.min(1.0, value))

f_weekdayIndex(int dow) =>
    dow == dayofweek.monday ? 0 : dow == dayofweek.tuesday ? 1 : dow == dayofweek.wednesday ? 2 : dow == dayofweek.thursday ? 3 : dow == dayofweek.friday ? 4 : -1

f_weekdayName(int index) =>
    index == 0 ? "Monday" : index == 1 ? "Tuesday" : index == 2 ? "Wednesday" : index == 3 ? "Thursday" : index == 4 ? "Friday" : "N/A"

f_commitmentQuote(int seed) =>
    int quoteIndex = seed % 16
    string quote = "Execute the plan. Let the outcome take care of itself."
    if quoteIndex == 0
        quote := "The consistency you seek is in your mind, not in the markets. — Mark Douglas"
    else if quoteIndex == 1
        quote := "Trade what you see, not what you think. — Linda Raschke"
    else if quoteIndex == 2
        quote := "Losers average losers. — Paul Tudor Jones"
    else if quoteIndex == 3
        quote := "Patience is part of the position. Do not manufacture an exit."
    else if quoteIndex == 4
        quote := "Your stop defines the risk. Your discipline protects the edge."
    else if quoteIndex == 5
        quote := "One trade proves nothing. Consistent execution proves everything."
    else if quoteIndex == 6
        quote := "Do not turn temporary discomfort into a permanent rule violation."
    else if quoteIndex == 7
        quote := "A planned exit is a decision. An emotional exit is a reaction."
    else if quoteIndex == 8
        quote := "Protect the process first; the results follow over a series of trades."
    else if quoteIndex == 9
        quote := "The market owes you nothing. Your plan tells you what to do next."
    else if quoteIndex == 10
        quote := "Confidence comes from repeated execution, not from predicting every outcome."
    else if quoteIndex == 11
        quote := "Let price reach your decision level before you make another decision."
    else if quoteIndex == 12
        quote := "A small planned win can be better than an unplanned large win."
    else if quoteIndex == 13
        quote := "Your edge lives in repetition. Give the setup room to complete."
    else if quoteIndex == 14
        quote := "Measure yourself by the quality of the execution, not one outcome."
    else
        quote := "Stay with the trade until your predefined success or risk condition is reached."
    quote

// ============================================================================
// HTF MIRROR SOURCE ENGINE
// Reconstructs the selected HTF's DPO/EMA signal event in HTF context. The
// current LTF only receives a source signal pulse plus HTF trade geometry.
// ============================================================================
f_htfMirrorLiveBaselines() =>
    string mirrorLiveCategory = f_currentTFCategory()
    int mirrorLiveDPOLength = useAdaptiveDPO ? f_defaultDPOLength(mirrorLiveCategory) : manualDPOLength
    int mirrorLiveDisplacement = math.floor(mirrorLiveDPOLength / 2) + 1
    float mirrorLiveDPOSMA = ta.sma(close, mirrorLiveDPOLength)
    float mirrorLiveDPOZero = mirrorLiveDPOSMA[mirrorLiveDisplacement - 1]
    float mirrorLiveEMA = ta.ema(close, emaBaselineLength)
    float mirrorLiveATR = ta.atr(atrLength)
    [mirrorLiveDPOZero, mirrorLiveEMA, mirrorLiveATR, open, time]

f_htfMirrorCoreMetrics() =>
    string mirrorCategory = f_currentTFCategory()
    int mirrorDPOLength = useAdaptiveDPO ? f_defaultDPOLength(mirrorCategory) : manualDPOLength
    int mirrorDisplacement = math.floor(mirrorDPOLength / 2) + 1
    float mirrorDPOSMA = ta.sma(close, mirrorDPOLength)
    float mirrorDPOZeroPrice = mirrorDPOSMA[mirrorDisplacement - 1]
    float mirrorDPO = close - mirrorDPOZeroPrice
    float mirrorEMA = ta.ema(close, emaBaselineLength)
    float mirrorATR = ta.atr(atrLength)

    // Mirror uses the exact user-selected Ballistic Edge parameters.
    int mirrorConcurrenceBars = engineConcurrenceBars
    int mirrorSpacingBars = int(str.tonumber(spacingSelection))
    int mirrorVolumeLookback = volumeQualityLookback
    int mirrorEfficiencyLookback = volumeQualityEfficiencyLookback
    int mirrorFVGLookback = fvgCustomLookback

    bool mirrorDPOBullCross = ta.crossover(mirrorDPO, 0.0)
    bool mirrorDPOBearCross = ta.crossunder(mirrorDPO, 0.0)
    bool mirrorEMABullCross = ta.crossover(close, mirrorEMA)
    bool mirrorEMABearCross = ta.crossunder(close, mirrorEMA)

    varip int mirrorLastDPOBullBar = na
    varip int mirrorLastDPOBearBar = na
    varip int mirrorLastEMABullBar = na
    varip int mirrorLastEMABearBar = na
    if mirrorDPOBullCross
        mirrorLastDPOBullBar := bar_index
    if mirrorDPOBearCross
        mirrorLastDPOBearBar := bar_index
    if mirrorEMABullCross
        mirrorLastEMABullBar := bar_index
    if mirrorEMABearCross
        mirrorLastEMABearBar := bar_index

    bool mirrorDPOBullRecent = enableDPOEngine and not na(mirrorLastDPOBullBar) and bar_index - mirrorLastDPOBullBar <= mirrorConcurrenceBars
    bool mirrorDPOBearRecent = enableDPOEngine and not na(mirrorLastDPOBearBar) and bar_index - mirrorLastDPOBearBar <= mirrorConcurrenceBars
    bool mirrorEMABullRecent = enableEMAEngine and not na(mirrorLastEMABullBar) and bar_index - mirrorLastEMABullBar <= mirrorConcurrenceBars
    bool mirrorEMABearRecent = enableEMAEngine and not na(mirrorLastEMABearBar) and bar_index - mirrorLastEMABearBar <= mirrorConcurrenceBars

    int mirrorEnabledEngines = (enableDPOEngine ? 1 : 0) + (enableEMAEngine ? 1 : 0)
    int mirrorBullAgreement = (mirrorDPOBullRecent ? 1 : 0) + (mirrorEMABullRecent ? 1 : 0)
    int mirrorBearAgreement = (mirrorDPOBearRecent ? 1 : 0) + (mirrorEMABearRecent ? 1 : 0)
    int mirrorRequiredAgreement = engineAgreementMode == "All Enabled" ? mirrorEnabledEngines : engineAgreementMode == "At Least 2" ? 2 : 1
    bool mirrorBullCrossNow = (enableDPOEngine and mirrorDPOBullCross) or (enableEMAEngine and mirrorEMABullCross)
    bool mirrorBearCrossNow = (enableDPOEngine and mirrorDPOBearCross) or (enableEMAEngine and mirrorEMABearCross)
    bool mirrorBullReady = mirrorEnabledEngines > 0 and mirrorRequiredAgreement <= mirrorEnabledEngines and mirrorBullAgreement >= mirrorRequiredAgreement
    bool mirrorBearReady = mirrorEnabledEngines > 0 and mirrorRequiredAgreement <= mirrorEnabledEngines and mirrorBearAgreement >= mirrorRequiredAgreement

    float mirrorBullBaselineSum = (mirrorDPOBullRecent ? mirrorDPOZeroPrice : 0.0) + (mirrorEMABullRecent ? mirrorEMA : 0.0)
    float mirrorBearBaselineSum = (mirrorDPOBearRecent ? mirrorDPOZeroPrice : 0.0) + (mirrorEMABearRecent ? mirrorEMA : 0.0)
    float mirrorSignalBaseline = mirrorEnabledEngines > 0 ? ((enableDPOEngine ? mirrorDPOZeroPrice : 0.0) + (enableEMAEngine ? mirrorEMA : 0.0)) / float(mirrorEnabledEngines) : mirrorDPOZeroPrice
    float mirrorBullBaseline = mirrorBullAgreement > 0 ? mirrorBullBaselineSum / float(mirrorBullAgreement) : mirrorSignalBaseline
    float mirrorBearBaseline = mirrorBearAgreement > 0 ? mirrorBearBaselineSum / float(mirrorBearAgreement) : mirrorSignalBaseline

    // Exact source-entry baseline for the current HTF crossing event.
    // If one engine is the fresh cross that completes concurrence, use that
    // engine's baseline. If DPO and EMA cross on the same realtime update,
    // use their average because both baselines complete the event together.
    int mirrorBullCrossingEngineCount = (enableDPOEngine and mirrorDPOBullCross ? 1 : 0) + (enableEMAEngine and mirrorEMABullCross ? 1 : 0)
    int mirrorBearCrossingEngineCount = (enableDPOEngine and mirrorDPOBearCross ? 1 : 0) + (enableEMAEngine and mirrorEMABearCross ? 1 : 0)
    float mirrorBullCrossBaselineSum = (enableDPOEngine and mirrorDPOBullCross ? mirrorDPOZeroPrice : 0.0) + (enableEMAEngine and mirrorEMABullCross ? mirrorEMA : 0.0)
    float mirrorBearCrossBaselineSum = (enableDPOEngine and mirrorDPOBearCross ? mirrorDPOZeroPrice : 0.0) + (enableEMAEngine and mirrorEMABearCross ? mirrorEMA : 0.0)
    float mirrorBullEntryBaseline = mirrorBullCrossingEngineCount > 0 ? mirrorBullCrossBaselineSum / float(mirrorBullCrossingEngineCount) : mirrorBullBaseline
    float mirrorBearEntryBaseline = mirrorBearCrossingEngineCount > 0 ? mirrorBearCrossBaselineSum / float(mirrorBearCrossingEngineCount) : mirrorBearBaseline

    // Source-HTF FVG state.
    bool mirrorBullFVGNow = bar_index >= 2 and low > high[2]
    bool mirrorBearFVGNow = bar_index >= 2 and high < low[2]
    var int mirrorLastBullFVGBar = na
    var int mirrorLastBearFVGBar = na
    var float mirrorLastBullFVGLower = na
    var float mirrorLastBearFVGUpper = na
    if mirrorBullFVGNow
        mirrorLastBullFVGBar := bar_index
        mirrorLastBullFVGLower := high[2]
    if mirrorBearFVGNow
        mirrorLastBearFVGBar := bar_index
        mirrorLastBearFVGUpper := low[2]
    bool mirrorFVGLong = not na(mirrorLastBullFVGBar) and bar_index - mirrorLastBullFVGBar <= mirrorFVGLookback and close >= mirrorLastBullFVGLower
    bool mirrorFVGShort = not na(mirrorLastBearFVGBar) and bar_index - mirrorLastBearFVGBar <= mirrorFVGLookback and close <= mirrorLastBearFVGUpper

    // Source-HTF Volume Participation Quality.
    float mirrorVolAverage = ta.sma(volume, mirrorVolumeLookback)
    float mirrorRVOL = mirrorVolAverage > 0.0 ? volume / mirrorVolAverage : 0.0
    float mirrorEfficiencyNetMove = close - close[mirrorEfficiencyLookback]
    float mirrorEfficiencyPath = ta.sma(math.abs(close - close[1]), mirrorEfficiencyLookback) * float(mirrorEfficiencyLookback)
    float mirrorDirectionalEfficiency = mirrorEfficiencyPath > 0.0 ? math.abs(mirrorEfficiencyNetMove) / mirrorEfficiencyPath : 0.0
    float mirrorRangeATR = mirrorATR > 0.0 ? (high - low) / mirrorATR : 0.0
    float mirrorVolumeTrendAverage = ta.sma(volume, volumeQualityTrendLength)
    bool mirrorVolumeTrendRising = mirrorVolumeTrendAverage > mirrorVolumeTrendAverage[1]
    bool mirrorHighVolChop = volumeQualityRejectHighVolChop and mirrorRVOL >= volumeQualityChopRVOL and mirrorDirectionalEfficiency <= volumeQualityChopEfficiency
    bool mirrorVolumeBasePass = mirrorRVOL >= volumeQualityMinRVOL and mirrorDirectionalEfficiency >= volumeQualityMinEfficiency and mirrorRangeATR >= volumeQualityMinRangeATR and (not volumeQualityUseVolumeTrend or mirrorVolumeTrendRising) and not mirrorHighVolChop
    bool mirrorVolumeLong = mirrorVolumeBasePass and mirrorEfficiencyNetMove > 0.0
    bool mirrorVolumeShort = mirrorVolumeBasePass and mirrorEfficiencyNetMove < 0.0

    // Trend Alignment is combined outside this function because it may reference
    // another timeframe. Here we return the other optional filter states.
    int mirrorNonTrendEnabledFilters = (useFVGFilter ? 1 : 0) + (useVolumeQualityFilter ? 1 : 0)
    int mirrorNonTrendLongPasses = (useFVGFilter and mirrorFVGLong ? 1 : 0) + (useVolumeQualityFilter and mirrorVolumeLong ? 1 : 0)
    int mirrorNonTrendShortPasses = (useFVGFilter and mirrorFVGShort ? 1 : 0) + (useVolumeQualityFilter and mirrorVolumeShort ? 1 : 0)

    varip int mirrorLastSignalBar = na
    bool mirrorSpacingAllowed = na(mirrorLastSignalBar) or bar_index - mirrorLastSignalBar >= mirrorSpacingBars
    bool mirrorCoreBullEvent = mirrorSpacingAllowed and mirrorBullCrossNow and mirrorBullReady and not mirrorBearReady
    bool mirrorCoreBearEvent = mirrorSpacingAllowed and mirrorBearCrossNow and mirrorBearReady and not mirrorBullReady
    if mirrorCoreBullEvent or mirrorCoreBearEvent
        mirrorLastSignalBar := bar_index

    [mirrorCoreBullEvent, mirrorCoreBearEvent, mirrorBullEntryBaseline, mirrorBearEntryBaseline, mirrorBullBaseline, mirrorBearBaseline, mirrorATR, open, mirrorNonTrendEnabledFilters, mirrorNonTrendLongPasses, mirrorNonTrendShortPasses, time]

// ============================================================================
// EEM COMPOSITE CHOP SCORE — COMPLETED HTF BARS ONLY
// EEM MarketContextEngine: close-direction alternation, overlapping consecutive
// candle ranges, and simple-average true-range compression (N vs 3N).
// The 40/35/25 weights and reference thresholds mirror EEM defaults.
// ============================================================================
f_eemChopSnapshot() =>
    int transitions = 0
    int alternations = 0
    int previousSign = 0
    for k = 1 to beiChopLookback
        int oldestOffset = beiChopLookback + 1 - k
        float delta = close[oldestOffset] - close[oldestOffset + 1]
        int sign = delta > 0.0 ? 1 : delta < 0.0 ? -1 : 0
        if sign != 0
            if previousSign != 0
                transitions += 1
                if sign != previousSign
                    alternations += 1
            previousSign := sign
    float alternationPct = transitions > 0 ? float(alternations) / float(transitions) * 100.0 : 0.0

    float overlapSum = 0.0
    for k = 1 to beiChopLookback - 1
        float overlapPoints = math.max(0.0, math.min(high[k], high[k + 1]) - math.max(low[k], low[k + 1]))
        float smallerRange = math.min(math.max(0.0, high[k] - low[k]), math.max(0.0, high[k + 1] - low[k + 1]))
        overlapSum += smallerRange > 0.0 ? math.min(1.0, overlapPoints / smallerRange) * 100.0 : 0.0
    float overlapPct = overlapSum / float(beiChopLookback - 1)

    // ta.tr(true) is HTF true range, matching EEM's completed-bar TR formula.
    float shortAtr = ta.sma(ta.tr(true), beiChopLookback)[1]
    float longAtr = ta.sma(ta.tr(true), beiChopLookback * 3)[1]
    float compressionRatio = longAtr > 0.0 ? shortAtr / longAtr : na
    bool ready = not na(close[beiChopLookback * 3 + 1]) and not na(compressionRatio)

    float alternationPart = math.max(0.0, math.min(100.0, alternationPct / math.max(1.0, beiChopMaxAlternationPct) * 100.0))
    float overlapPart = math.max(0.0, math.min(100.0, overlapPct / math.max(1.0, beiChopMaxOverlapPct) * 100.0))
    float compressionPart = compressionRatio < 1.0 ? math.max(0.0, math.min(100.0, (beiChopMinCompressionRatio - compressionRatio) / math.max(0.01, beiChopMinCompressionRatio) * 100.0)) : 0.0
    float aw = beiChopUseAlternation ? float(beiChopAlternationWeight) : 0.0
    float rw = beiChopUseOverlap ? float(beiChopOverlapWeight) : 0.0
    float cw = beiChopUseCompression ? float(beiChopCompressionWeight) : 0.0
    float totalWeight = aw + rw + cw
    float score = totalWeight > 0.0 ? math.floor((alternationPart * aw + overlapPart * rw + compressionPart * cw) / totalWeight + 0.5) : 0.0
    [ready ? score : na, ready, alternationPct, overlapPct, compressionRatio]

// The HTF expression always reads [1] or earlier, so historical and realtime
// bars use the same last *completed* HTF candle; no future HTF lookahead.
[beiChopScoreHTF, beiChopReadyHTF, beiChopAlternationHTF, beiChopOverlapHTF, beiChopCompressionHTF] = request.security(
     syminfo.tickerid, beiChopTF, f_eemChopSnapshot(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
bool beiChopTFValid = timeframe.in_seconds(beiChopTF) >= timeframe.in_seconds(timeframe.period)
bool beiChopReady = beiChopTFValid and beiChopReadyHTF and not na(beiChopScoreHTF)
bool beiChopAllowsBox = not beiChopFilterEnabled or (beiChopReady and beiChopScoreHTF <= float(beiChopMaximum))

// ============================================================================
// DIRECT USER-SELECTED PARAMETERS
// Timeframe Optimization was removed. These aliases preserve the existing core
// calculations while using the user's inputs directly.
// ============================================================================
int effectiveEngineConcurrenceBars = engineConcurrenceBars
int effectiveMinBarsBetweenSignals = int(str.tonumber(spacingSelection))
int effectiveTrendAlignmentEMALength = entryHTFEMALength
int effectiveVolumeQualityLookback = volumeQualityLookback
int effectiveVolumeEfficiencyLookback = volumeQualityEfficiencyLookback
int effectiveFVGLookback = fvgCustomLookback

float currentChartTFSeconds = timeframe.in_seconds(timeframe.period)
float selectedMirrorTFSeconds = timeframe.in_seconds(htfMirrorTF)
bool htfMirrorTFIsHigher = not na(selectedMirrorTFSeconds) and selectedMirrorTFSeconds > currentChartTFSeconds

// HTF Mirror source. The same selected HTF is used for Flip mode.
// On realtime bars request.security() exposes the developing HTF state. The
// source function detects the baseline cross on that developing HTF candle, so
// Flip can mirror the signal immediately instead of waiting for HTF bar close.
[mirrorHTFCoreBull, mirrorHTFCoreBear, mirrorHTFBullEntryBaseline, mirrorHTFBearEntryBaseline, mirrorHTFBullBaseline, mirrorHTFBearBaseline, mirrorHTFATR, mirrorHTFOpen, mirrorHTFNonTrendEnabled, mirrorHTFNonTrendLongPasses, mirrorHTFNonTrendShortPasses, mirrorHTFBarTime] = request.security(
     syminfo.tickerid, htfMirrorTF, f_htfMirrorCoreMetrics(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Live HTF baseline stream. Crosses are detected on the LTF against these
// developing HTF levels, so the mirror does not wait for the HTF candle close.
[mirrorLiveDPOZero, mirrorLiveEMA, mirrorLiveATR, mirrorLiveHTFOpen, mirrorLiveHTFTime] = request.security(
     syminfo.tickerid, htfMirrorTF, f_htfMirrorLiveBaselines(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Source-HTF bar sequence expressed on the LTF. Concurrence remains measured in
// HTF bars even though the actual crossing event is detected intrabar on the LTF.
var int mirrorLiveSourceBarSeq = 0
bool mirrorLiveNewHTFBar = not na(mirrorLiveHTFTime[1]) and mirrorLiveHTFTime != mirrorLiveHTFTime[1]
if mirrorLiveNewHTFBar
    mirrorLiveSourceBarSeq += 1

bool mirrorLiveDPOBullCross = enableDPOEngine and ta.crossover(close, mirrorLiveDPOZero)
bool mirrorLiveDPOBearCross = enableDPOEngine and ta.crossunder(close, mirrorLiveDPOZero)
bool mirrorLiveEMABullCross = enableEMAEngine and ta.crossover(close, mirrorLiveEMA)
bool mirrorLiveEMABearCross = enableEMAEngine and ta.crossunder(close, mirrorLiveEMA)

varip int mirrorLiveLastDPOBullSeq = na
varip int mirrorLiveLastDPOBearSeq = na
varip int mirrorLiveLastEMABullSeq = na
varip int mirrorLiveLastEMABearSeq = na

if mirrorLiveDPOBullCross
    mirrorLiveLastDPOBullSeq := mirrorLiveSourceBarSeq
if mirrorLiveDPOBearCross
    mirrorLiveLastDPOBearSeq := mirrorLiveSourceBarSeq
if mirrorLiveEMABullCross
    mirrorLiveLastEMABullSeq := mirrorLiveSourceBarSeq
if mirrorLiveEMABearCross
    mirrorLiveLastEMABearSeq := mirrorLiveSourceBarSeq

bool mirrorLiveDPOBullRecent = enableDPOEngine and not na(mirrorLiveLastDPOBullSeq) and mirrorLiveSourceBarSeq - mirrorLiveLastDPOBullSeq <= effectiveEngineConcurrenceBars
bool mirrorLiveDPOBearRecent = enableDPOEngine and not na(mirrorLiveLastDPOBearSeq) and mirrorLiveSourceBarSeq - mirrorLiveLastDPOBearSeq <= effectiveEngineConcurrenceBars
bool mirrorLiveEMABullRecent = enableEMAEngine and not na(mirrorLiveLastEMABullSeq) and mirrorLiveSourceBarSeq - mirrorLiveLastEMABullSeq <= effectiveEngineConcurrenceBars
bool mirrorLiveEMABearRecent = enableEMAEngine and not na(mirrorLiveLastEMABearSeq) and mirrorLiveSourceBarSeq - mirrorLiveLastEMABearSeq <= effectiveEngineConcurrenceBars

int mirrorLiveEnabledEngineCount = (enableDPOEngine ? 1 : 0) + (enableEMAEngine ? 1 : 0)
int mirrorLiveBullAgreementCount = (mirrorLiveDPOBullRecent ? 1 : 0) + (mirrorLiveEMABullRecent ? 1 : 0)
int mirrorLiveBearAgreementCount = (mirrorLiveDPOBearRecent ? 1 : 0) + (mirrorLiveEMABearRecent ? 1 : 0)
int mirrorLiveRequiredAgreementCount = engineAgreementMode == "All Enabled" ? mirrorLiveEnabledEngineCount : engineAgreementMode == "At Least 2" ? 2 : 1

bool mirrorLiveBullCrossNow = mirrorLiveDPOBullCross or mirrorLiveEMABullCross
bool mirrorLiveBearCrossNow = mirrorLiveDPOBearCross or mirrorLiveEMABearCross
bool mirrorLiveBullReady = mirrorLiveEnabledEngineCount > 0 and mirrorLiveRequiredAgreementCount <= mirrorLiveEnabledEngineCount and mirrorLiveBullAgreementCount >= mirrorLiveRequiredAgreementCount
bool mirrorLiveBearReady = mirrorLiveEnabledEngineCount > 0 and mirrorLiveRequiredAgreementCount <= mirrorLiveEnabledEngineCount and mirrorLiveBearAgreementCount >= mirrorLiveRequiredAgreementCount

// This is the same entry geometry used by the source HTF Ballistic Edge box:
// average the agreeing HTF baselines at the instant the source signal qualifies.
float mirrorLiveBullAgreementSum = (mirrorLiveDPOBullRecent ? mirrorLiveDPOZero : 0.0) + (mirrorLiveEMABullRecent ? mirrorLiveEMA : 0.0)
float mirrorLiveBearAgreementSum = (mirrorLiveDPOBearRecent ? mirrorLiveDPOZero : 0.0) + (mirrorLiveEMABearRecent ? mirrorLiveEMA : 0.0)
float mirrorLiveBullBoxEntry = mirrorLiveBullAgreementCount > 0 ? mirrorLiveBullAgreementSum / float(mirrorLiveBullAgreementCount) : mirrorLiveDPOZero
float mirrorLiveBearBoxEntry = mirrorLiveBearAgreementCount > 0 ? mirrorLiveBearAgreementSum / float(mirrorLiveBearAgreementCount) : mirrorLiveDPOZero

bool mirrorLiveCoreBullEvent = mirrorLiveBullCrossNow and mirrorLiveBullReady and not mirrorLiveBearReady
bool mirrorLiveCoreBearEvent = mirrorLiveBearCrossNow and mirrorLiveBearReady and not mirrorLiveBullReady

// Source-HTF Trend Alignment. "Chart" means the mirror source timeframe itself.
string mirrorTrendResolvedTF = entryTrendReferenceTF == "Chart" ? htfMirrorTF : entryTrendReferenceTF == "5m" ? "5" : entryTrendReferenceTF == "15m" ? "15" : entryTrendReferenceTF == "30m" ? "30" : "60"
[mirrorTrendClose, mirrorTrendEMA, mirrorTrendEMAPrior] = request.security(
     syminfo.tickerid, mirrorTrendResolvedTF,
     [close, ta.ema(close, effectiveTrendAlignmentEMALength), ta.ema(close, effectiveTrendAlignmentEMALength)[1]],
     lookahead=barmerge.lookahead_off)
bool mirrorTrendLongPass = mirrorTrendClose > mirrorTrendEMA and mirrorTrendEMA > mirrorTrendEMAPrior
bool mirrorTrendShortPass = mirrorTrendClose < mirrorTrendEMA and mirrorTrendEMA < mirrorTrendEMAPrior

int mirrorHTFEnabledFilterCount = mirrorHTFNonTrendEnabled + (useHTFTrendFilter ? 1 : 0)
int mirrorHTFLongFilterPassCount = mirrorHTFNonTrendLongPasses + (useHTFTrendFilter and mirrorTrendLongPass ? 1 : 0)
int mirrorHTFShortFilterPassCount = mirrorHTFNonTrendShortPasses + (useHTFTrendFilter and mirrorTrendShortPass ? 1 : 0)
bool mirrorHTFLongFiltersPass = mirrorHTFEnabledFilterCount == 0 ? true : entryTrendFilterMode == "All Enabled" ? mirrorHTFLongFilterPassCount == mirrorHTFEnabledFilterCount : mirrorHTFLongFilterPassCount > 0
bool mirrorHTFShortFiltersPass = mirrorHTFEnabledFilterCount == 0 ? true : entryTrendFilterMode == "All Enabled" ? mirrorHTFShortFilterPassCount == mirrorHTFEnabledFilterCount : mirrorHTFShortFilterPassCount > 0

bool mirrorSourceTFValid = htfMirrorTFIsHigher
bool flipMirrorModeActive = flipHTFMirrorEnabled
bool mirrorHTFBullSignal = mirrorSourceTFValid and mirrorLiveCoreBullEvent and mirrorHTFLongFiltersPass
bool mirrorHTFBearSignal = mirrorSourceTFValid and mirrorLiveCoreBearEvent and mirrorHTFShortFiltersPass

// De-duplicate a source HTF signal so it is copied once, not on every LTF bar
// carrying the same request.security value.
varip int lastMirroredLTFSignalBar = na
varip int lastMirroredHTFSignalDirection = 0
bool mirrorNewBullSignal = flipMirrorModeActive and mirrorHTFBullSignal and (na(lastMirroredLTFSignalBar) or bar_index != lastMirroredLTFSignalBar or lastMirroredHTFSignalDirection != 1)
bool mirrorNewBearSignal = flipMirrorModeActive and mirrorHTFBearSignal and (na(lastMirroredLTFSignalBar) or bar_index != lastMirroredLTFSignalBar or lastMirroredHTFSignalDirection != -1)

// ============================================================================
// CORE CALCULATIONS
// ============================================================================
int dpoLength = useAdaptiveDPO ? f_getDPOLength() : manualDPOLength
int displacement = math.floor(dpoLength / 2) + 1
float dpoSMA = ta.sma(close, dpoLength)
float dpoZeroPrice = dpoSMA[displacement - 1]
float dpo = close - dpoZeroPrice
float emaBaselinePrice = ta.ema(close, emaBaselineLength)

int enabledEngineCount = (enableDPOEngine ? 1 : 0) + (enableEMAEngine ? 1 : 0)
float enabledBaselineSum = (enableDPOEngine ? dpoZeroPrice : 0.0) + (enableEMAEngine ? emaBaselinePrice : 0.0)
float signalBaselinePrice = enabledEngineCount > 0 ? enabledBaselineSum / float(enabledEngineCount) : dpoZeroPrice
float edgeValue = close - signalBaselinePrice

string enabledEngineNames = enableDPOEngine ? "DPO" : ""

string dashboardEngineAgreementMode = engineAgreementMode == "At Least 2" ? "2" : engineAgreementMode == "All Enabled" ? "All" : "Any"
string signalEngineName = enabledEngineCount == 0 ? "DPO (Fallback)" : enabledEngineNames + " | " + dashboardEngineAgreementMode

// Track completed DPO excursions from the zero line.
// Bull excursion: highest positive DPO value before the next bearish zero cross.
// Bear excursion: absolute value of the lowest negative DPO value before the next bullish zero cross.
// The first partial cycle visible on the chart is intentionally ignored; tracking starts after a confirmed zero cross.
var bool trackingBullExcursion = false
var bool trackingBearExcursion = false
var float currentBullPeak = na
var float currentBearTrough = na
var float bullPeakSum = 0.0
var float bearPeakSum = 0.0
var int bullPeakCount = 0
var int bearPeakCount = 0

float currentATR = ta.atr(atrLength)
float averageATR = ta.sma(currentATR, atrAverageLength)
float atrPercent = averageATR > 0 ? currentATR / averageATR * 100.0 : na
string volatilityState = na(atrPercent) ? "N/A" : atrPercent > 120 ? "HIGH" : atrPercent < 80 ? "LOW" : "NORMAL"
color volatilityColor = volatilityState == "HIGH" ? color.red : volatilityState == "LOW" ? color.green : color.blue

// LEI: extension from VWAP + velocity + volume, normalized to 0-100.
float leiVWAP = ta.vwap(hlc3)
float leiATR = ta.atr(14)
float leiExtension = leiATR > 0 ? math.abs(close - leiVWAP) / leiATR : 0.0
float leiVelocity = leiATR > 0 ? math.abs(close - close[5]) / leiATR : 0.0
float leiVolumeSMA = ta.sma(volume, 20)
float leiVolumeStdev = ta.stdev(volume, 20)
float leiVolumeZ = leiVolumeSMA > 0 ? (volume - leiVolumeSMA) / math.max(leiVolumeStdev, 1.0) : 0.0
float leiVolumeModifier = math.max(1.0, 1.0 + leiVolumeZ * 0.1)
float leiRaw = (leiExtension * 0.5 + leiVelocity * 0.5) * leiVolumeModifier
float leiScore = math.min(100.0, math.max(0.0, ta.percentrank(leiRaw, 100)))
string leiState = leiScore >= leiExhaustionLevel ? "EXHAUSTED" : leiScore <= leiEnergyLevel ? "ENERGIZED" : "NEUTRAL"
color leiColor = leiState == "ENERGIZED" ? color.green : leiState == "EXHAUSTED" ? color.red : color.orange


// ============================================================================
// INFORMATIONAL CONFLUENCE CALCULATIONS
// ============================================================================
// Regime classifier from DES-Conf: squeeze detection plus ADX/EMA-slope state.
[regimeBBMid, regimeBBUp, regimeBBDn] = ta.bb(close, regimeBBLen, 2.0)
float regimeBBW = (regimeBBUp - regimeBBDn) / math.max(regimeBBMid, syminfo.mintick) * 100.0
float regimeBBWRank = ta.percentrank(regimeBBW, 100)
float regimeATRPct = currentATR / math.max(close, syminfo.mintick) * 100.0
float regimeATRRank = ta.percentrank(regimeATRPct, 100)
[regimePlusDI, regimeMinusDI, regimeADX] = ta.dmi(regimeADXLen, regimeADXLen)
float regimeEMA = ta.ema(close, regimeEMALen)
float regimeEMASlope = regimeEMA[5] != 0.0 ? (regimeEMA - regimeEMA[5]) / regimeEMA[5] * 100.0 : 0.0
bool regimeSqueeze = regimeBBWRank < 10 and regimeATRRank < 15
string regimeState = not enableRegimeClassifier ? "OFF" : regimeSqueeze ? "SQUEEZE" : regimeADX > 25 and regimeEMASlope > 0.5 ? "STRONG_BULL" : regimeADX > 18 and regimeEMASlope > 0.1 ? "WEAK_BULL" : regimeADX > 25 and regimeEMASlope < -0.5 ? "STRONG_BEAR" : regimeADX > 18 and regimeEMASlope < -0.1 ? "WEAK_BEAR" : "RANGE"
color regimeColor = regimeState == "STRONG_BULL" ? color.lime : regimeState == "WEAK_BULL" ? color.green : regimeState == "STRONG_BEAR" ? color.red : regimeState == "WEAK_BEAR" ? color.orange : regimeState == "SQUEEZE" ? color.fuchsia : color.silver

// Fixed 14/50 EMA + MACD + RSI ribbon score from DES-Conf. EMAs stay hidden;
// only the fill ribbon is optionally rendered.
float ribbonFastEMA = ta.ema(close, 14)
float ribbonSlowEMA = ta.ema(close, 50)
[ribbonMACD, ribbonMACDSignal, ribbonHist] = ta.macd(close, 12, 26, 9)
float ribbonRSI = ta.rsi(close, 14)
float ribbonRSIEMA = ta.ema(ribbonRSI, 14)
bool ribbonEMAAlignBull = ribbonFastEMA > ribbonSlowEMA
bool ribbonEMAAlignBear = ribbonFastEMA < ribbonSlowEMA
bool ribbonMACDAlignBull = ribbonMACD > ribbonMACDSignal
bool ribbonMACDAlignBear = ribbonMACD < ribbonMACDSignal
bool ribbonRSIAlignBull = ribbonRSI > ribbonRSIEMA
bool ribbonRSIAlignBear = ribbonRSI < ribbonRSIEMA
int ribbonBullScore = (ribbonEMAAlignBull ? 1 : 0) + (ribbonMACDAlignBull ? 1 : 0) + (ribbonRSIAlignBull ? 1 : 0) + (ribbonRSI > 50 ? 1 : 0) + (ribbonRSIEMA > 50 ? 1 : 0) + (ribbonHist > 0 ? 1 : 0)
int ribbonBearScore = (ribbonEMAAlignBear ? 1 : 0) + (ribbonMACDAlignBear ? 1 : 0) + (ribbonRSIAlignBear ? 1 : 0) + (ribbonRSI < 50 ? 1 : 0) + (ribbonRSIEMA < 50 ? 1 : 0) + (ribbonHist < 0 ? 1 : 0)

// Swing-based dynamic S/R engine. Levels are retained only for the selected
// lookback and nearest support/resistance are used for display and grading.
float srPivotHigh = ta.pivothigh(high, srSwingLeft, srSwingRight)
float srPivotLow = ta.pivotlow(low, srSwingLeft, srSwingRight)
var float[] srResistanceLevels = array.new_float()
var int[] srResistanceBars = array.new_int()
var float[] srSupportLevels = array.new_float()
var int[] srSupportBars = array.new_int()
if not na(srPivotHigh)
    array.push(srResistanceLevels, srPivotHigh)
    array.push(srResistanceBars, bar_index)
if not na(srPivotLow)
    array.push(srSupportLevels, srPivotLow)
    array.push(srSupportBars, bar_index)
while array.size(srResistanceBars) > 0 and bar_index - array.get(srResistanceBars, 0) > srZoneLookback
    array.shift(srResistanceLevels)
    array.shift(srResistanceBars)
while array.size(srSupportBars) > 0 and bar_index - array.get(srSupportBars, 0) > srZoneLookback
    array.shift(srSupportLevels)
    array.shift(srSupportBars)
float nearestSupport = na
float nearestResistance = na
if array.size(srSupportLevels) > 0
    for srI = 0 to array.size(srSupportLevels) - 1
        float srLevel = array.get(srSupportLevels, srI)
        if srLevel < close and (na(nearestSupport) or srLevel > nearestSupport)
            nearestSupport := srLevel
if array.size(srResistanceLevels) > 0
    for srI = 0 to array.size(srResistanceLevels) - 1
        float srLevel = array.get(srResistanceLevels, srI)
        if srLevel > close and (na(nearestResistance) or srLevel < nearestResistance)
            nearestResistance := srLevel
float srZoneWidth = currentATR * srZoneWidthATR

f_srZoneScore(float level, bool isSupport) =>
    float result = na
    if not na(level)
        int touchCount = 0
        int lookN = math.min(srZoneLookback, bar_index)
        if lookN > 0
            for srK = 0 to lookN - 1
                float px = isSupport ? low[srK] : high[srK]
                if math.abs(px - level) <= srZoneWidth
                    touchCount += 1
        float touchNorm = math.min(touchCount, 5) / 5.0
        float regimeFit = not enableRegimeClassifier ? 0.5 : isSupport ? (regimeState == "STRONG_BULL" ? 1.0 : regimeState == "WEAK_BULL" ? 0.8 : regimeState == "RANGE" ? 0.5 : 0.3) : (regimeState == "STRONG_BEAR" ? 1.0 : regimeState == "WEAK_BEAR" ? 0.8 : regimeState == "RANGE" ? 0.5 : 0.3)
        result := touchNorm * 50.0 + regimeFit * 50.0
    result



// ============================================================================
// MODULAR ENTRY TREND-FILTER CALCULATIONS
// These calculations never create a signal by themselves. They only confirm or
// reject a qualifying active-baseline cross when their corresponding input is ON.
// ============================================================================

// 4) Trend Alignment: same-TF when Chart is selected, otherwise MTF.
string entryTrendResolvedTF = entryTrendReferenceTF == "Chart" ? timeframe.period : entryTrendReferenceTF == "5m" ? "5" : entryTrendReferenceTF == "15m" ? "15" : entryTrendReferenceTF == "30m" ? "30" : "60"
[entryHTFClose, entryHTFEMA, entryHTFEMAPrior] = request.security(syminfo.tickerid, entryTrendResolvedTF,
     [close, ta.ema(close, effectiveTrendAlignmentEMALength), ta.ema(close, effectiveTrendAlignmentEMALength)[1]], lookahead=barmerge.lookahead_off)
bool htfTrendLong = entryHTFClose > entryHTFEMA and entryHTFEMA > entryHTFEMAPrior
bool htfTrendShort = entryHTFClose < entryHTFEMA and entryHTFEMA < entryHTFEMAPrior

// 5) FVG Direction: standard three-candle fair-value-gap imbalance.
bool bullishFVGNow = bar_index >= 2 and low > high[2]
bool bearishFVGNow = bar_index >= 2 and high < low[2]
var int lastBullFVGBar = na
var int lastBearFVGBar = na
var float lastBullFVGLower = na
var float lastBearFVGUpper = na
if bullishFVGNow
    lastBullFVGBar := bar_index
    lastBullFVGLower := high[2]
if bearishFVGNow
    lastBearFVGBar := bar_index
    lastBearFVGUpper := low[2]
bool bullishFVGActive = not na(lastBullFVGBar) and bar_index - lastBullFVGBar <= effectiveFVGLookback and close >= lastBullFVGLower
bool bearishFVGActive = not na(lastBearFVGBar) and bar_index - lastBearFVGBar <= effectiveFVGLookback and close <= lastBearFVGUpper
bool fvgLong = bullishFVGActive
bool fvgShort = bearishFVGActive

// 7) Volume Participation Quality:
// Relative volume must be accompanied by directional price efficiency and enough
// range expansion. High-volume + low-efficiency is explicitly treated as chop.
float volumeAverage = ta.sma(volume, effectiveVolumeQualityLookback)
float relativeVolume = volumeAverage > 0.0 ? volume / volumeAverage : 0.0

float volumeEfficiencyNetMove = close - close[effectiveVolumeEfficiencyLookback]
float volumeEfficiencyPath = ta.sma(math.abs(close - close[1]), effectiveVolumeEfficiencyLookback) * float(effectiveVolumeEfficiencyLookback)
float volumeDirectionalEfficiency = volumeEfficiencyPath > 0.0 ? math.abs(volumeEfficiencyNetMove) / volumeEfficiencyPath : 0.0

float candleRangeATR = currentATR > 0.0 ? (high - low) / currentATR : 0.0
float volumeTrendAverage = ta.sma(volume, volumeQualityTrendLength)
bool volumeTrendRising = volumeTrendAverage > volumeTrendAverage[1]

bool highVolumeLowEfficiencyChop = volumeQualityRejectHighVolChop and relativeVolume >= volumeQualityChopRVOL and volumeDirectionalEfficiency <= volumeQualityChopEfficiency

bool volumeQualityBasePass = relativeVolume >= volumeQualityMinRVOL and volumeDirectionalEfficiency >= volumeQualityMinEfficiency and candleRangeATR >= volumeQualityMinRangeATR and (not volumeQualityUseVolumeTrend or volumeTrendRising) and not highVolumeLowEfficiencyChop
bool volumeQualityLong = volumeQualityBasePass and volumeEfficiencyNetMove > 0.0
bool volumeQualityShort = volumeQualityBasePass and volumeEfficiencyNetMove < 0.0

// Aggregate enabled filters. With none enabled, both directions pass so the
// original DPO-only baseline-cross entry remains the default behavior.
int enabledEntryTrendFilterCount = (useHTFTrendFilter ? 1 : 0) + (useFVGFilter ? 1 : 0) + (useVolumeQualityFilter ? 1 : 0)
int longEntryTrendConfirmCount = (useHTFTrendFilter and htfTrendLong ? 1 : 0) + (useFVGFilter and fvgLong ? 1 : 0) + (useVolumeQualityFilter and volumeQualityLong ? 1 : 0)
int shortEntryTrendConfirmCount = (useHTFTrendFilter and htfTrendShort ? 1 : 0) + (useFVGFilter and fvgShort ? 1 : 0) + (useVolumeQualityFilter and volumeQualityShort ? 1 : 0)

bool entryTrendLongPass = enabledEntryTrendFilterCount == 0 ? true : entryTrendFilterMode == "All Enabled" ? longEntryTrendConfirmCount == enabledEntryTrendFilterCount : longEntryTrendConfirmCount > 0
bool entryTrendShortPass = enabledEntryTrendFilterCount == 0 ? true : entryTrendFilterMode == "All Enabled" ? shortEntryTrendConfirmCount == enabledEntryTrendFilterCount : shortEntryTrendConfirmCount > 0

// ============================================================================
// CORE MULTI-ENGINE SIGNAL ENGINE
// Requirements:
//   1) Enabled engines meet the selected directional agreement rule.
//   2) Their crosses occur within the concurrence window.
//   3) Global minimum signal spacing has elapsed.
// ============================================================================
int minBarsBetweenSignals = effectiveMinBarsBetweenSignals

bool dpoBullishCross = ta.crossover(dpo, 0.0)
bool dpoBearishCross = ta.crossunder(dpo, 0.0)
bool emaBullishCross = ta.crossover(close, emaBaselinePrice)
bool emaBearishCross = ta.crossunder(close, emaBaselinePrice)

var int lastDPOBullCrossBar = na
var int lastDPOBearCrossBar = na
var int lastEMABullCrossBar = na
var int lastEMABearCrossBar = na

if dpoBullishCross
    lastDPOBullCrossBar := bar_index
if dpoBearishCross
    lastDPOBearCrossBar := bar_index
if emaBullishCross
    lastEMABullCrossBar := bar_index
if emaBearishCross
    lastEMABearCrossBar := bar_index

bool dpoBullRecent = enableDPOEngine and not na(lastDPOBullCrossBar) and bar_index - lastDPOBullCrossBar <= effectiveEngineConcurrenceBars
bool dpoBearRecent = enableDPOEngine and not na(lastDPOBearCrossBar) and bar_index - lastDPOBearCrossBar <= effectiveEngineConcurrenceBars
bool emaBullRecent = enableEMAEngine and not na(lastEMABullCrossBar) and bar_index - lastEMABullCrossBar <= effectiveEngineConcurrenceBars
bool emaBearRecent = enableEMAEngine and not na(lastEMABearCrossBar) and bar_index - lastEMABearCrossBar <= effectiveEngineConcurrenceBars

int bullishAgreementCount = (dpoBullRecent ? 1 : 0) + (emaBullRecent ? 1 : 0)
int bearishAgreementCount = (dpoBearRecent ? 1 : 0) + (emaBearRecent ? 1 : 0)
int requiredAgreementCount = engineAgreementMode == "All Enabled" ? enabledEngineCount : engineAgreementMode == "At Least 2" ? 2 : 1

bool enabledBullCrossNow = (enableDPOEngine and dpoBullishCross) or (enableEMAEngine and emaBullishCross)
bool enabledBearCrossNow = (enableDPOEngine and dpoBearishCross) or (enableEMAEngine and emaBearishCross)

bool bullishAgreementReady = enabledEngineCount > 0 and requiredAgreementCount <= enabledEngineCount and bullishAgreementCount >= requiredAgreementCount
bool bearishAgreementReady = enabledEngineCount > 0 and requiredAgreementCount <= enabledEngineCount and bearishAgreementCount >= requiredAgreementCount

bool rawBullishCross = enabledBullCrossNow and bullishAgreementReady and not bearishAgreementReady and entryTrendLongPass
bool rawBearishCross = enabledBearCrossNow and bearishAgreementReady and not bullishAgreementReady and entryTrendShortPass

float bullishAgreementBaselineSum = (dpoBullRecent ? dpoZeroPrice : 0.0) + (emaBullRecent ? emaBaselinePrice : 0.0)
float bearishAgreementBaselineSum = (dpoBearRecent ? dpoZeroPrice : 0.0) + (emaBearRecent ? emaBaselinePrice : 0.0)
float bullishAgreementBaseline = bullishAgreementCount > 0 ? bullishAgreementBaselineSum / float(bullishAgreementCount) : signalBaselinePrice
float bearishAgreementBaseline = bearishAgreementCount > 0 ? bearishAgreementBaselineSum / float(bearishAgreementCount) : signalBaselinePrice

// Freeze the informational confluence grade from conditions present at box creation.
f_confluenceGrade(int direction) =>
    float points = 0.0
    float maxPoints = 0.0
    // Existing Ballistic Edge engine agreement contributes 40% of the grade.
    maxPoints += 4.0
    int agreeCount = direction == 1 ? bullishAgreementCount : bearishAgreementCount
    points += enabledEngineCount > 0 ? 4.0 * float(agreeCount) / float(enabledEngineCount) : 0.0
    if enableRegimeClassifier
        maxPoints += 2.0
        bool strongRegime = direction == 1 ? (regimeState == "STRONG_BULL" or regimeState == "WEAK_BULL") : (regimeState == "STRONG_BEAR" or regimeState == "WEAK_BEAR")
        if strongRegime
            points += 2.0
        else if regimeState == "RANGE" or regimeState == "SQUEEZE"
            points += 1.0
    if enableSRZoneEngine
        maxPoints += 2.0
        float zLevel = direction == 1 ? nearestSupport : nearestResistance
        float zScore = f_srZoneScore(zLevel, direction == 1)
        if not na(zScore)
            if zScore >= 65
                points += 2.0
            else if zScore >= 50
                points += 1.0
    if enableRibbonScore
        maxPoints += 2.0
        int score = direction == 1 ? ribbonBullScore : ribbonBearScore
        points += 2.0 * float(score) / 6.0
    float ratio = maxPoints > 0 ? points / maxPoints : 0.0
    string grade = ratio >= 0.80 ? "A" : ratio >= 0.60 ? "B" : ratio >= 0.40 ? "C" : "D"
    [grade, ratio]


// Complete the prior excursion on a zero cross, then begin tracking the new side.
if dpoBullishCross
    if trackingBearExcursion and not na(currentBearTrough)
        bearPeakSum += math.abs(currentBearTrough)
        bearPeakCount += 1
    trackingBearExcursion := false
    currentBearTrough := na
    trackingBullExcursion := true
    currentBullPeak := math.max(dpo, 0.0)
else if dpoBearishCross
    if trackingBullExcursion and not na(currentBullPeak)
        bullPeakSum += currentBullPeak
        bullPeakCount += 1
    trackingBullExcursion := false
    currentBullPeak := na
    trackingBearExcursion := true
    currentBearTrough := math.min(dpo, 0.0)
else
    if trackingBullExcursion and dpo >= 0
        currentBullPeak := na(currentBullPeak) ? dpo : math.max(currentBullPeak, dpo)
    if trackingBearExcursion and dpo <= 0
        currentBearTrough := na(currentBearTrough) ? dpo : math.min(currentBearTrough, dpo)

float avgBullDPO = bullPeakCount > 0 ? bullPeakSum / bullPeakCount : na
float avgBearDPO = bearPeakCount > 0 ? bearPeakSum / bearPeakCount : na
int totalDPOExcursions = bullPeakCount + bearPeakCount
float avgDPO = totalDPOExcursions > 0 ? (bullPeakSum + bearPeakSum) / totalDPOExcursions : na

// Latch the first valid intrabar multi-engine signal for the life of the current candle.
// The latch survives realtime rollback, so a box that appears on the first cross
// cannot move, disappear, or reverse while the crossing candle is still open.
var int lastSignalBar = na
varip int latchedSignalBar = na
varip int latchedSignalDirection = 0
varip float latchedBaselineEntryPrice = na
varip float latchedStopBaselinePrice = na
varip float latchedCrossATR = na
varip float latchedCrossOpen = na

if barstate.isnew
    latchedSignalBar := bar_index
    latchedSignalDirection := 0
    latchedBaselineEntryPrice := na
    latchedStopBaselinePrice := na
    latchedCrossATR := na
    latchedCrossOpen := na

bool spacingAllowed = na(lastSignalBar) or bar_index - lastSignalBar >= minBarsBetweenSignals
if latchedSignalDirection == 0
    if flipMirrorModeActive
        // FLIP: local/current-TF signal generation is completely bypassed.
        if mirrorNewBullSignal
            latchedSignalDirection := 1
            // Copy the actual source HTF box entry geometry on the same LTF
            // candle where price crosses the live HTF baseline/concurrence level.
            latchedBaselineEntryPrice := mirrorLiveBullBoxEntry
            latchedStopBaselinePrice := mirrorLiveBullBoxEntry
            latchedCrossATR := mirrorLiveATR
            latchedCrossOpen := mirrorLiveHTFOpen
            lastMirroredLTFSignalBar := bar_index
            lastMirroredHTFSignalDirection := 1
        else if mirrorNewBearSignal
            latchedSignalDirection := -1
            latchedBaselineEntryPrice := mirrorLiveBearBoxEntry
            latchedStopBaselinePrice := mirrorLiveBearBoxEntry
            latchedCrossATR := mirrorLiveATR
            latchedCrossOpen := mirrorLiveHTFOpen
            lastMirroredLTFSignalBar := bar_index
            lastMirroredHTFSignalDirection := -1
    else if spacingAllowed
        if rawBullishCross
            latchedSignalDirection := 1
            latchedBaselineEntryPrice := bullishAgreementBaseline
            latchedStopBaselinePrice := bullishAgreementBaseline
            latchedCrossATR := currentATR
            latchedCrossOpen := open
        else if rawBearishCross
            latchedSignalDirection := -1
            latchedBaselineEntryPrice := bearishAgreementBaseline
            latchedStopBaselinePrice := bearishAgreementBaseline
            latchedCrossATR := currentATR
            latchedCrossOpen := open

// No new PM-session signal/box is allowed from 09:00 through 09:29 ET.
// Clear the latched signal throughout this cutoff so a stale pre-open signal
// cannot create a box when the NY session begins at 09:30.
bool pmPreOpenSignalCutoff = hour(time, "America/New_York") == 9 and minute(time, "America/New_York") < 30
if pmPreOpenSignalCutoff
    latchedSignalDirection := 0

bool buySignal = latchedSignalDirection == 1 and not pmPreOpenSignalCutoff
bool sellSignal = latchedSignalDirection == -1 and not pmPreOpenSignalCutoff

if buySignal or sellSignal
    lastSignalBar := bar_index

// ============================================================================
// TRADE BOX STORAGE
// ============================================================================
var box[] targetBoxes = array.new_box()
var box[] riskBoxes = array.new_box()
var line[] entryLines = array.new_line()
var line[] tp1Lines = array.new_line()
var line[] tp2Lines = array.new_line()
var line[] tp3Lines = array.new_line()
var int[] tradeDirections = array.new_int()
var int[] tradeStartBars = array.new_int()
var float[] tradeEntryPrices = array.new_float()
var float[] tradeTP1Prices = array.new_float()
var float[] tradeTP2Prices = array.new_float()
var float[] tradeTP3Prices = array.new_float()
var float[] tradeSLPrices = array.new_float()
var bool[] tradeTP1Hit = array.new_bool()
var bool[] tradeTP2Hit = array.new_bool()

// Independent post-TP3 extension observer.
// A core trade becomes watchable only after a clean TP3 win. Ext Boxes is set
// the first time price subsequently reaches the 4-ATR level, regardless of
// whether the Runner Probability qualified that trade.
var bool[] tradeExtensionWatching = array.new_bool()
var bool[] tradeExtensionHit = array.new_bool()
var bool[] tradeRunnerMomentumQualified = array.new_bool()
var bool[] tradeRunnerBaselineQualified = array.new_bool()
var bool[] tradeRunnerEMASlopeQualified = array.new_bool()
var bool[] tradeRunnerLaunched = array.new_bool()

var int[] tradeSessionTypes = array.new_int()  // 1 = PM, 2 = NY, 0 = outside either session
var int[] tradeSessionGenerations = array.new_int()  // Identifies the latest PM/NY session instance for visual filtering.
var int[] tradeTradingDayKeys = array.new_int()
var int[] tradeWeekKeys = array.new_int()
var bool[] tradeActive = array.new_bool()
var bool[] tradeIsMirror = array.new_bool()
var int pmSessionGeneration = 0
var int nySessionGeneration = 0

// Session CP&L is stored separately so every completed trade remains counted even
// when its visible box is later removed by overlap consolidation or pruning.
var float pmSessionRealizedCPL = 0.0
var float nySessionRealizedCPL = 0.0
// Target-specific hypothetical CP&L: each completed trade is treated as closed
// at TP1/TP2/TP3 when that target was reached before SL; otherwise the SL loss applies.
var float pmSessionTP1CPL = 0.0
var float pmSessionTP2CPL = 0.0
var float pmSessionTP3CPL = 0.0
var float nySessionTP1CPL = 0.0
var float nySessionTP2CPL = 0.0
var float nySessionTP3CPL = 0.0
// Session cumulative-P&L extremes based on realized final outcomes (TP3 or SL).
// The curve starts at zero, so both the highest and lowest include the session baseline.
var float pmSessionHighestCPL = 0.0
var float pmSessionLowestCPL = 0.0
var float nySessionHighestCPL = 0.0
