alertcondition(sellSignal, title="Ballistic Edge Sell Signal", message="Price crossed below the selected baseline")
plot(dpo, "DPO Export", display=display.none)
plot(signalBaselinePrice, "Signal Baseline Export", display=display.none)
plot(edgeValue, "Edge Value Export", display=display.none)
plot(bullishAgreementCount, "Bullish Engine Agreement Export", display=display.none)
plot(bearishAgreementCount, "Bearish Engine Agreement Export", display=display.none)
plot(avgBullDPO, "Avg Bull DPO Export", display=display.none)
plot(avgBearDPO, "Avg Bear DPO Export", display=display.none)
plot(avgDPO, "Avg DPO Export", display=display.none)
plot(currentATR, "ATR Export", display=display.none)
plot(beiCurrentSessionRange, "Session Range Export", display=display.none)
plot(beiChopReady ? beiChopScoreHTF : na, "EEM Chop Score Export", display=display.none)
plot(beiSessionRangeIndex, "Session Range Index Export", display=display.none)
plot(leiScore, "LEI Export", display=display.none)
plot(ribbonBullScore, "Ribbon Bull Score Export", display=display.none)
plot(ribbonBearScore, "Ribbon Bear Score Export", display=display.none)
plot(nearestSupport, "Nearest Support Export", display=display.none)
plot(nearestResistance, "Nearest Resistance Export", display=display.none)