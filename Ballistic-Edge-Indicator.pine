//@version=6
indicator("DPO Zero-Crossover Probability Edge", shorttitle="Ballistic Edge", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================================================================
// ACCESS LEVEL
// Free features always remain active. Enabling Premium adds advanced trade
// management, analytics, display controls, Dashboard, and Data Panel features.
// ============================================================================
GROUP_ACCESS = "0. Access Level"
premiumFeatures = input.bool(false, "Enable Premium Features", group=GROUP_ACCESS,
     tooltip="OFF: Free signal engine, arrows, ATR trade boxes, TP/SL levels, colors, and alerts remain active. ON: Adds the Dashboard, Data Panel, session statistics, advanced box storage/display controls, overlap counts, and chronological trade rankings.")

// ============================================================================
// 1. DPO-ONLY TRADE-BOX ENTRY BASELINE
// The EMA entry engine and multi-engine concurrence controls have been removed.
// EMA calculations used by separate informational filters/ribbon remain independent.
// ============================================================================
GROUP_DPO = "FREE — 1. DPO Entry Baseline"
enableDPOEngine = input.bool(true, "Enable DPO Engine", group=GROUP_DPO)
// Internal compatibility values for the retained HTF mirror helpers; not entry engines.
int engineConcurrenceBars = 3
int emaBaselineLength = 20
bool enableEMAEngine = false
string engineAgreementMode = "Any Enabled"
useAdaptiveDPO = input.bool(true, "Use Adaptive DPO Length", group=GROUP_DPO)
manualDPOLength = input.int(20, "Manual DPO Length", minval=1, group=GROUP_DPO)
selectedTimeframe = input.string("Current Chart TF", "Configure Adaptive Length For",
     options=["Current Chart TF", "1M", "5M", "15M", "30M", "1H", "4H", "Daily+"], group=GROUP_DPO)
customDPOLength = input.int(20, "Selected Timeframe DPO Length", minval=1, group=GROUP_DPO)

// ============================================================================
// 2. MODULAR TRADE-BOX ENTRY — OPTIONAL TREND FILTERS
// All filters are OFF by default, so the original baseline-cross behavior is
// preserved. Enable any combination and choose whether ANY or ALL must confirm.
// ============================================================================
GROUP_ENTRY_FILTERS = "FREE — 2. Entry Trend Filters"
entryTrendFilterMode = input.string("All Enabled", "Trend Filter Agreement",
     options=["Any Enabled", "All Enabled"], group=GROUP_ENTRY_FILTERS,
     tooltip="Any Enabled: at least one enabled trend filter must confirm the baseline-cross direction. All Enabled: every enabled trend filter must confirm. With no filters enabled, baseline agreement alone controls trade-box entry.")

useHTFTrendFilter = input.bool(false, "Use Trend Alignment", group=GROUP_ENTRY_FILTERS)
entryTrendReferenceTF = input.string("15m", "Trend Alignment Reference TF",
     options=["Chart", "5m", "15m", "30m", "1H"], group=GROUP_ENTRY_FILTERS,
     tooltip="Chart evaluates trend on the current chart timeframe. The other choices provide multi-timeframe trend confirmation up to 1 hour.")
entryHTFEMALength = input.int(20, "Trend Alignment EMA Length", minval=1, maxval=500, group=GROUP_ENTRY_FILTERS,
     tooltip="LONG requires reference-TF close above a rising EMA; SHORT requires close below a falling EMA.")

useFVGFilter = input.bool(false, "Use FVG Direction", group=GROUP_ENTRY_FILTERS,
     tooltip="LONG requires a recent uninvalidated bullish Fair Value Gap. SHORT requires a recent uninvalidated bearish Fair Value Gap.")
fvgCustomLookback = input.int(10, "FVG Lookback", minval=1, maxval=100, group=GROUP_ENTRY_FILTERS,
     tooltip="Bullish FVG = low > high[2]; bearish FVG = high < low[2].")

useVolumeQualityFilter = input.bool(false, "Use Volume Participation Quality", group=GROUP_ENTRY_FILTERS)
volumeQualityLookback = input.int(20, "Volume Quality Lookback", minval=2, maxval=200, group=GROUP_ENTRY_FILTERS)
volumeQualityMinRVOL = input.float(1.00, "Minimum Relative Volume", minval=0.10, maxval=10.0, step=0.05, group=GROUP_ENTRY_FILTERS,
     tooltip="Lookback used for average volume in Volume Participation Quality.")
volumeQualityEfficiencyLookback = input.int(10, "Volume Efficiency Lookback", minval=2, maxval=100, group=GROUP_ENTRY_FILTERS)
volumeQualityMinEfficiency = input.float(0.35, "Minimum Directional Efficiency", minval=0.0, maxval=1.0, step=0.05, group=GROUP_ENTRY_FILTERS,
     tooltip="Lookback used for directional-efficiency measurement.")
volumeQualityMinRangeATR = input.float(0.35, "Minimum Candle Range / ATR", minval=0.0, maxval=3.0, step=0.05, group=GROUP_ENTRY_FILTERS,
     tooltip="Rejects volume spikes occurring in candles whose price range is too small relative to ATR.")
volumeQualityUseVolumeTrend = input.bool(false, "Require Rising Volume Trend", group=GROUP_ENTRY_FILTERS)
volumeQualityTrendLength = input.int(5, "Volume Trend Length", minval=2, maxval=50, group=GROUP_ENTRY_FILTERS)
volumeQualityRejectHighVolChop = input.bool(true, "Reject High-Volume Low-Efficiency Chop", group=GROUP_ENTRY_FILTERS)
volumeQualityChopRVOL = input.float(1.20, "High-Volume Chop RVOL", minval=0.10, maxval=10.0, step=0.05, group=GROUP_ENTRY_FILTERS)
volumeQualityChopEfficiency = input.float(0.25, "High-Volume Chop Max Efficiency", minval=0.0, maxval=1.0, step=0.05, group=GROUP_ENTRY_FILTERS,
     tooltip="When enabled, high relative volume combined with very low directional efficiency is treated as two-way/choppy participation and blocks the trade.")

// ============================================================================
// 2B. EEM-STYLE MARKET CONTEXT / COMPOSITE CHOP
// The preparation delay is measured from the current PM/NY session opening,
// because TradingView Pine cannot observe the user connecting to a data feed.
// Default OFF/0 preserves all existing trade-box timing.
// The chop score is informational even when its entry filter is OFF.
// ============================================================================
GROUP_EEM_CONTEXT = "FREE — 2B. EEM Context and Chop"
beiPrepMinutes = input.int(0, "Session Preparation Delay (minutes)", minval=0, maxval=120, group=GROUP_EEM_CONTEXT,
     tooltip="0: preserve immediate trade-box creation. X>0: do not print a trade box during the first X minutes of each NY or PM session. Signals during preparation are skipped, not queued. This is session-open-based, not feed-connect-based.")
beiChopFilterEnabled = input.bool(false, "Enable EEM Composite Chop Filter", group=GROUP_EEM_CONTEXT,
     tooltip="When ON, block new trade boxes if the completed higher-timeframe composite chop score is above its maximum or context is not ready. The score is displayed even when this filter is OFF.")
beiChopTF = input.timeframe("15", "Chop Context Timeframe", group=GROUP_EEM_CONTEXT)
beiChopLookback = input.int(14, "Chop Lookback (completed HTF bars)", minval=2, maxval=100, group=GROUP_EEM_CONTEXT)
beiChopMaximum = input.int(65, "Maximum Allowed Chop Score", minval=0, maxval=100, group=GROUP_EEM_CONTEXT)
beiChopUseAlternation = input.bool(true, "Include Close Alternation", group=GROUP_EEM_CONTEXT)
beiChopUseOverlap = input.bool(true, "Include Range Overlap", group=GROUP_EEM_CONTEXT)
beiChopUseCompression = input.bool(true, "Include ATR Compression", group=GROUP_EEM_CONTEXT)
beiChopAlternationWeight = input.int(40, "Alternation Weight", minval=0, maxval=100, group=GROUP_EEM_CONTEXT)
beiChopOverlapWeight = input.int(35, "Overlap Weight", minval=0, maxval=100, group=GROUP_EEM_CONTEXT)
beiChopCompressionWeight = input.int(25, "Compression Weight", minval=0, maxval=100, group=GROUP_EEM_CONTEXT)
beiChopMaxAlternationPct = input.float(65.0, "Alternation Reference (%)", minval=1.0, maxval=100.0, group=GROUP_EEM_CONTEXT)
beiChopMaxOverlapPct = input.float(70.0, "Range Overlap Reference (%)", minval=1.0, maxval=100.0, group=GROUP_EEM_CONTEXT)
beiChopMinCompressionRatio = input.float(0.65, "Minimum ATR Compression Ratio", minval=0.05, maxval=1.0, group=GROUP_EEM_CONTEXT)

// ============================================================================
// 2A. HTF MIRROR / FLIP
// Optional display mode: when enabled, the current chart timeframe stops
